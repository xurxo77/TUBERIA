(--gas)}\n.check-status{font-weight:700;color:var(--gas)}\n/* quiz: barra de resultado e imagen */\n.meter{height:.7rem;border-radius:99px;background:var(--steel-soft);overflow:hidden;margin:.4rem 0}\n.meter span{display:block;height:100%;background:var(--gas)}\n.qfig{margin:0 0 .8rem;padding:.4rem;background:#fff;border:1px solid var(--line);border-radius:8px;text-align:center}\n.qfig img,.qfig svg{max-width:100%;max-height:15rem;height:auto}\n/* tabla de colores */\n.sw{display:inline-block;width:1.1rem;height:1.1rem;border-radius:3px;vertical-align:-.2rem;margin-right:.35rem;border:1px solid rgba(0,0,0,.3)}\n.big-num{font:700 2.4rem/1 \"Barlow Condensed\",sans-serif;color:var(--arc)}\n\n/* ===== Añadidos serie MONTAJE ===== */\n/* portada con dibujo en vez de foto */\n.hero svg.bg{display:block;width:100%;height:min(62vh,420px)}\n/* calculadoras y deslizadores */\n.calc{margin:1.2rem 0;background:var(--card);border:1px solid var(--line);border-radius:10px;padding:.9rem 1rem 1rem}\n.calc h3{margin:.1rem 0 .5rem}\n.calc .row{display:flex;flex-wrap:wrap;gap:.6rem 1rem;align-items:end;margin:.4rem 0}\n.calc label{display:flex;flex-direction:column;gap:.25rem;font-size:.92rem;font-weight:700;color:var(--ink2)}\n.calc input[type=number]{font:inherit;font-size:1.1rem;width:7.5rem;padding:.45rem .6rem;border-radius:8px;border:1.5px solid var(--line);background:var(--paper);color:var(--ink)}\n.calc input[type=range]{width:100%;accent-color:var(--arc);min-height:2rem}\n.calc .out{margin:.7rem 0 0;padding:.7rem .9rem;border-radius:8px;background:var(--steel-soft)}\n.calc .out.ok{background:var(--gas-soft)}.calc .out.bad{background:var(--molten-soft)}\n.calc .out b.big{font:700 1.7rem \"Barlow Condensed\",sans-serif}\n.calc svg{display:block;width:100%;max-width:26rem;margin:.4rem auto 0;height:auto}\n/* buscador de palabras */\n.gloss input{font:inherit;width:100%;padding:.6rem .8rem;border-radius:8px;border:1.5px solid var(--line);background:var(--paper);color:var(--ink)}\n.gloss table{margin-top:.6rem}\n.gloss td:first-child{width:45%}\n/* paso a paso con dibujo */\n.stepper{margin:1.3rem 0;background:var(--card);border:1px solid var(--line);border-radius:10px;overflow:hidden}\n.stepper svg{display:block;width:100%;height:auto;background:var(--steel-soft)}\n.stepper .ctrl{display:flex;justify-content:space-between;align-items:center;gap:.5rem;padding:.6rem .9rem;border-top:1px solid var(--line)}\n.stepper .ctrl span{font-weight:700;color:var(--ink2)}\n.stepper .txt{padding:.1rem 1.1rem 1rem}\n.stepper .txt h3{margin:.7rem 0 .3rem;color:var(--arc)}\n.btn.ghost{background:var(--paper);color:var(--ink);border:1.5px solid var(--line)}\n.btn:disabled{opacity:.4;cursor:default}\n.st{transition:opacity .35s}.st.hide{opacity:0}.st.new .hl{filter:drop-shadow(0 0 4px #FF9A2E)}\n\n\u003c/style>\n\u003cstyle>\n.ident .imgwrap{background:#fff;padding:.4rem;border-top:1px solid var(--line)}\n.ident .imgwrap img{display:block;width:100%;height:auto}\n.nums{display:flex;flex-wrap:wrap;gap:.4rem;padding:.7rem .9rem;border-top:1px solid var(--line)}\n.nums button{font:700 1.05rem \"Barlow Condensed\",sans-serif;min-width:2.7rem;min-height:2.5rem;border-radius:8px;border:1.5px solid var(--line);background:var(--paper);color:var(--ink);cursor:pointer}\n.nums button[aria-pressed=\"true\"]{border-color:var(--gas);background:var(--gas-soft)}\n\u003c/style>\n\u003c/head>\n\u003cbody>\n\u003cheader class=\"topnav\" id=\"topnav\">\n  \u003cdiv class=\"bar\" id=\"bar\">\u003c/div>\n  \u003cnav class=\"blocknav\" aria-label=\"Bloques de tubería\">\n    \u003ca href=\"TUB_0_Portada.html\">Portada\u003c/a>\n    \u003ca href=\"TUB_1_Tuberia.html\">1 La tubería\u003c/a>\n    \u003ca href=\"TUB_2_Accesorios.html\" class=\"cur\" aria-current=\"page\">2 Accesorios\u003c/a>\n    \u003ca href=\"TUB_3_Bridas_Valvulas.html\">3 Bridas y válvulas\u003c/a>\n    \u003ca href=\"TUB_4_Isometricos.html\">4 Isométricos\u003c/a>\n    \u003ca href=\"TUB_5_Taller.html\">5 Al taller\u003c/a>\n  \u003c/nav>\n  \u003cnav class=\"chips\" id=\"chips\" aria-label=\"Secciones\">\n    \u003ca href=\"#inicio\">Inicio\u003c/a>\n    \u003ca href=\"#uniones\">Tres uniones\u003c/a>\n    \u003ca href=\"#codos\">Codos\u003c/a>\n    \u003ca href=\"#tes\">Tes\u003c/a>\n    \u003ca href=\"#reducciones\">Reducciones\u003c/a>\n    \u003ca href=\"#cierres\">Tapas y manguitos\u003c/a>\n    \u003ca href=\"#olets\">Picajes (olets)\u003c/a>\n    \u003ca href=\"#identifica\">Identifica\u003c/a>\n    \u003ca href=\"#ideas\">Ideas clave\u003c/a>\n  \u003c/nav>\n\u003c/header>\n\n\u003cdiv class=\"hero\" id=\"inicio\">\n  \u003csvg class=\"bg\" viewBox=\"0 0 800 420\" preserveAspectRatio=\"xMidYMid slice\" role=\"img\" aria-label=\"Dibujo: tubería con un codo, una te y una reducción; las soldaduras marcadas en naranja.\">\n    \u003crect width=\"800\" height=\"420\" fill=\"#16314F\"/>\n    \u003cg fill=\"none\" stroke=\"#9FB3C8\" stroke-width=\"40\">\n      \u003cpath d=\"M-20 300 H230 a80 80 0 0 0 80 -80 V60\"/>\n      \u003cpath d=\"M380 300 H560\"/>\u003cpath d=\"M470 300 V120\"/>\n    \u003c/g>\n    \u003cpath d=\"M560 280 L640 290 V310 L560 320 Z\" fill=\"#9FB3C8\"/>\u003cpath d=\"M640 292 H820 V308 H640 Z\" fill=\"#9FB3C8\"/>\n    \u003cg stroke=\"#FFB27A\" stroke-width=\"6\">\u003cline x1=\"230\" y1=\"278\" x2=\"230\" y2=\"322\"/>\u003cline x1=\"288\" y1=\"220\" x2=\"332\" y2=\"220\"/>\u003cline x1=\"400\" y1=\"278\" x2=\"400\" y2=\"322\"/>\u003cline x1=\"540\" y1=\"278\" x2=\"540\" y2=\"322\"/>\u003cline x1=\"448\" y1=\"200\" x2=\"492\" y2=\"200\"/>\u003cline x1=\"560\" y1=\"278\" x2=\"560\" y2=\"322\"/>\u003cline x1=\"640\" y1=\"288\" x2=\"640\" y2=\"312\"/>\u003c/g>\n  \u003c/svg>\n  \u003cdiv class=\"txt wrap\">\n    \u003ch1>Bloque 2. Accesorios y uniones\u003c/h1>\n    \u003cp class=\"sub\">Las piezas que giran, dividen y estrechan la tubería. Y dónde va cada soldadura.\u003c/p>\n    \u003cp class=\"ctx\">CFGM Soldadura y Calderería · Montaje de tubería\u003c/p>\n    \u003cp class=\"ctx\" style=\"margin-top:.3rem\">\u003cb>Autor: Xurxo\u003c/b>\u003c/p>\n  \u003c/div>\n\u003c/div>\n\n\u003cmain class=\"wrap\">\n\n\u003csection id=\"intro\">\n  \u003cp class=\"lead\">Un tubo recto solo va en línea recta. Para \u003cb>girar\u003c/b>, \u003cb>sacar un ramal\u003c/b>, \u003cb>cambiar de diámetro\u003c/b> o \u003cb>cerrar\u003c/b> un extremo se usan \u003cb>accesorios\u003c/b> (en inglés, \u003ci>fittings\u003c/i>). Vienen de fábrica, con medidas de norma. Tú los cortas, los presentas y los sueldas.\u003c/p>\n  \u003col class=\"chain\" aria-label=\"Lo que hacen los accesorios\">\n    \u003cli>\u003ca href=\"#uniones\">\u003cb>1\u003c/b>Unir\u003c/a>\u003c/li>\n    \u003cli>\u003ca href=\"#codos\">\u003cb>2\u003c/b>Girar\u003c/a>\u003c/li>\n    \u003cli>\u003ca href=\"#tes\">\u003cb>3\u003c/b>Dividir\u003c/a>\u003c/li>\n    \u003cli>\u003ca href=\"#reducciones\">\u003cb>4\u003c/b>Reducir\u003c/a>\u003c/li>\n    \u003cli>\u003ca href=\"#cierres\">\u003cb>5\u003c/b>Cerrar\u003c/a>\u003c/li>\n    \u003cli>\u003ca href=\"#olets\">\u003cb>6\u003c/b>Picar\u003c/a>\u003c/li>\n    \u003cli>\u003ca href=\"#identifica\">\u003cb>7\u003c/b>Recono&shy;cer\u003c/a>\u003c/li>\n  \u003c/ol>\n  \u003ch3>Al terminar sabrás\u003c/h3>\n  \u003cul class=\"list\">\n    \u003cli>distinguir las tres formas de unir: \u003cb>roscada (TH)\u003c/b>, \u003cb>de enchufe (SW)\u003c/b> y \u003cb>a tope (BW)\u003c/b>;\u003c/li>\n    \u003cli>reconocer codos de radio largo y corto, tes, reducciones, tapas y manguitos;\u003c/li>\n    \u003cli>elegir entre una reducción concéntrica o excéntrica;\u003c/li>\n    \u003cli>saber qué es un \u003cb>weldolet\u003c/b>, un \u003cb>sockolet\u003c/b> y un \u003cb>thredolet\u003c/b>;\u003c/li>\n    \u003cli>señalar dónde va cada cordón de soldadura en cada pieza.\u003c/li>\n  \u003c/ul>\n\u003c/section>\n\n\u003c!-- ============ UNIONES ============ -->\n\u003csection id=\"uniones\">\n  \u003ch2>Las tres formas de unir\u003c/h2>\n  \u003cdiv class=\"en10\">Un tubo se une a un accesorio de tres formas: \u003cb>roscándolo\u003c/b> (TH), \u003cb>enchufándolo y soldando por fuera\u003c/b> (SW) o \u003cb>soldando a tope\u003c/b> (BW). Casi todo accesorio existe en las tres versiones.\u003c/div>\n\n  \u003cdiv class=\"diagram\" id=\"uni\">\n    \u003csvg viewBox=\"0 0 400 200\" role=\"img\" aria-labelledby=\"uniT\" id=\"uniSvg\">\n      \u003ctitle id=\"uniT\">Corte de la unión elegida entre un tubo y un accesorio.\u003c/title>\n    \u003c/svg>\n    \u003cdiv class=\"tabs\" id=\"uniTabs\">\u003c/div>\n    \u003cdiv class=\"panel\" id=\"uniPanel\">\u003c/div>\n  \u003c/div>\n\n  \u003cfigure>\n    \u003cdiv class=\"imgbox zoomable\">\u003cimg id=\"f-tsb\" src=\"data:image/jpeg;base64,\" alt=\"Codos de 90 grados: uno para soldar a tope (butt welded), uno roscado (threaded, TH) y uno de enchufe (socket-weld, SW).\">\u003c/div>\n    \u003cfigcaption>\u003cb>Fuente: presentación «6.0 Piping (Básico)», diap. 16.\u003c/b> El mismo codo de 90° en tres versiones: a tope (BW), roscado (TH) y de enchufe (SW).\u003c/figcaption>\n  \u003c/figure>\n\n  \u003cdiv class=\"scroll\">\u003ctable>\n    \u003cthead>\u003ctr>\u003cth>Unión\u003c/th>\u003cth>Tamaños\u003c/th>\u003cth>Clases (presión)\u003c/th>\u003cth>Extremo del tubo\u003c/th>\u003c/tr>\u003c/thead>\n    \u003ctbody>\n      \u003ctr>\u003ctd>TH · roscada\u003c/td>\u003ctd>Pequeños: hasta 2\" (como mucho 4\")\u003c/td>\u003ctd>2000, 3000 y 6000 lb\u003c/td>\u003ctd>T&amp;C (roscado)\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>SW · enchufe y soldadura\u003c/td>\u003ctd>Pequeños: hasta 2\" (como mucho 4\")\u003c/td>\u003ctd>3000, 6000 y 9000 lb\u003c/td>\u003ctd>PE (liso)\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>BW · soldadura a tope\u003c/td>\u003ctd>Desde ½\" hasta lo que haga falta. Lo normal desde 2\".\u003c/td>\u003ctd>El mismo schedule que el tubo\u003c/td>\u003ctd>BE (biselado)\u003c/td>\u003c/tr>\n    \u003c/tbody>\n  \u003c/table>\u003c/div>\n  \u003cdiv class=\"callout hot\">\u003ch4>En el enchufe, deja holgura\u003c/h4>\u003cp>En una unión SW el tubo \u003cb>no se mete hasta el fondo\u003c/b>. Se mete hasta el fondo y se \u003cb>saca un poco\u003c/b> (unos 3 mm según los apuntes). Si no, al soldar el tubo se dilata, empuja contra el fondo y el cordón se \u003cb>agrieta\u003c/b>.\u003c/p>\u003c/div>\n  \u003cfigure>\n    \u003cdiv class=\"imgbox zoomable\">\u003cimg id=\"f-sw3\" src=\"data:image/jpeg;base64,\" alt=\"Corte de una brida socket-weld y de un sockolet: el tubo entra en el enchufe pero se deja una holgura de 3 milímetros en el fondo para la dilatación.\">\u003c/div>\n    \u003cfigcaption>\u003cb>Fuente: «Manual práctico del tubero», CIFO Tarragona, pág. 30.\u003c/b> El tubo no toca el fondo del enchufe: se dejan \u003cb>3 mm\u003c/b> para la dilatación.\u003c/figcaption>\n  \u003c/figure>\n  \u003cdiv class=\"ext\">\n    \u003cspan class=\"tag\">Ampliación con fuentes externas\u003c/span>\n    \u003ch3>¿3 mm o 1,6 mm?\u003c/h3>\n    \u003cp>La norma de tubería de proceso, \u003cb>ASME B31.3\u003c/b>, pide una holgura de \u003cb>aproximadamente 1/16\" (1,6 mm)\u003c/b> antes de soldar un enchufe. Muchas empresas dejan entre 1,5 y 3 mm. Un truco de taller: mete el tubo hasta el fondo, márcalo y sácalo con una \u003cb>arandela-galga\u003c/b> o con una pieza de 1,6 mm. Haz lo que diga el procedimiento de tu empresa.\u003c/p>\n  \u003c/div>\n  \u003cdiv class=\"recuerda\">\u003ch4>Lo que tienes que recordar\u003c/h4>\u003cul>\n    \u003cli>TH = rosca. SW = enchufe + cordón de ángulo. BW = a tope, con penetración completa.\u003c/li>\n    \u003cli>TH y SW: tubos pequeños. BW: el resto.\u003c/li>\n    \u003cli>En SW, el tubo no toca el fondo.\u003c/li>\n  \u003c/ul>\u003c/div>\n\u003c/section>\n\n\u003c!-- ============ CODOS ============ -->\n\u003csection id=\"codos\" style=\"--c:var(--gas)\">\n  \u003ch2>Codos: para girar\u003c/h2>\n  \u003cdiv class=\"en10\">El codo (\u003ci>elbow\u003c/i>, ELL) cambia la dirección de la tubería. Los normales son de \u003cb>90°\u003c/b> y \u003cb>45°\u003c/b>. Pueden ser de \u003cb>radio largo\u003c/b> (LR, el normal) o de \u003cb>radio corto\u003c/b> (SR).\u003c/div>\n\n  \u003cdiv class=\"calc\" id=\"codoCalc\">\n    \u003ch3>Radio largo o radio corto\u003c/h3>\n    \u003cdiv class=\"row\">\n      \u003clabel for=\"cN\">NPS del codo\u003cinput id=\"cN\" type=\"number\" min=\"0.5\" max=\"48\" step=\"0.5\" value=\"4\">\u003c/label>\n    \u003c/div>\n    \u003csvg viewBox=\"0 0 320 190\" role=\"img\" aria-label=\"Dos codos de 90 grados dibujados a la misma escala: radio largo y radio corto.\" id=\"codoSvg\">\u003c/svg>\n    \u003cdiv class=\"out\" id=\"codoOut\">\u003c/div>\n  \u003c/div>\n  \u003cul class=\"list\">\n    \u003cli>\u003cb>Radio largo (LR)\u003c/b>: radio = \u003cb>1,5 × NPS\u003c/b>. Es el que se usa siempre que el plano no diga otra cosa. El fluido gira más suave y pierde menos presión.\u003c/li>\n    \u003cli>\u003cb>Radio corto (SR)\u003c/b>: radio = \u003cb>1 × NPS\u003c/b>. Solo cuando no hay sitio.\u003c/li>\n    \u003cli>\u003cb>Codo de 180°\u003c/b> (retorno, \u003ci>return\u003c/i>): se usa poco, por ejemplo en serpentines.\u003c/li>\n    \u003cli>El radio se mide en el \u003cb>eje\u003c/b> del codo, no por fuera.\u003c/li>\n  \u003c/ul>\n  \u003cfigure>\n    \u003cdiv class=\"imgbox zoomable\">\u003cimg id=\"f-cbw\" src=\"data:image/jpeg;base64,\" alt=\"Codos para soldar a tope: 45 grados de radio largo, 45 grados 3R, 90 grados de radio largo y corto, y retornos de 180 grados.\">\u003c/div>\n    \u003cfigcaption>\u003cb>Fuente: presentación «6.0 Piping (Básico)», diap. 15.\u003c/b> Codos BW: 45°, 90° de radio largo (\u003ci>long radius\u003c/i>) y corto (\u003ci>short radius\u003c/i>) y retornos de 180°.\u003c/figcaption>\n  \u003c/figure>\n  \u003cfigure>\n    \u003cdiv class=\"imgbox zoomable\">\u003cimg id=\"f-c67\" src=\"data:image/jpeg;base64,\" alt=\"Dibujos de un codo de radio corto (r igual a NPS), un codo de radio largo (r igual a 1,5 NPS), una te y una tapa con los cordones de soldadura pintados en rojo.\">\u003c/div>\n    \u003cfigcaption>\u003cb>Fuente: presentación «6.0 Piping (Básico)», diap. 67.\u003c/b> 14: codo SR (r = NPS). 15: codo LR (r = 1,5 NPS). 16: te recta. 17: tapa (\u003ci>cap\u003c/i>). En rojo, los cordones de soldadura.\u003c/figcaption>\n  \u003c/figure>\n  \u003cdiv class=\"callout shop\">\u003ch4>Un codo BW se puede cortar; uno SW o TH, no\u003c/h4>\u003cp>Si necesitas un codo de 60°, cortas un codo BW de 90° y lo vuelves a biselar. Con un codo de enchufe o roscado no puedes: \u003cb>perderías el enchufe o la rosca\u003c/b>. Lo verás con números en el Bloque 5.\u003c/p>\u003c/div>\n  \u003cdiv class=\"recuerda\" style=\"--c:var(--gas)\">\u003ch4>Lo que tienes que recordar\u003c/h4>\u003cul>\n    \u003cli>LR = 1,5 × NPS (el normal). SR = 1 × NPS.\u003c/li>\n    \u003cli>Si el plano no dice nada, el codo es LR.\u003c/li>\n    \u003cli>Solo los codos BW se cortan a otro ángulo.\u003c/li>\n  \u003c/ul>\u003c/div>\n\u003c/section>\n\n\u003c!-- ============ TES ============ -->\n\u003csection id=\"tes\">\n  \u003ch2>Tes y cruces: para dividir\u003c/h2>\n  \u003cdiv class=\"en10\">La \u003cb>te\u003c/b> (\u003ci>tee\u003c/i>) saca un \u003cb>ramal\u003c/b> a 90° de la tubería principal. Si el ramal es del mismo diámetro, es una \u003cb>te recta\u003c/b>; si es más pequeño, una \u003cb>te reductora\u003c/b>.\u003c/div>\n  \u003cdiv class=\"figsvg\">\u003cdiv class=\"diagram\">\n    \u003csvg viewBox=\"0 0 400 170\" role=\"img\" aria-labelledby=\"teT\">\n      \u003ctitle id=\"teT\">Te recta y te reductora, con sus tres soldaduras a tope.\u003c/title>\n      \u003cg fill=\"var(--gas-soft)\" stroke=\"var(--gas)\" stroke-width=\"2\">\n        \u003cpath d=\"M20 90 H180 V130 H20 Z\"/>\u003cpath d=\"M80 30 H120 V90 H80 Z\"/>\n        \u003cpath d=\"M220 90 H380 V130 H220 Z\"/>\u003cpath d=\"M288 40 H312 V90 H288 Z\"/>\n      \u003c/g>\n      \u003cg stroke=\"var(--molten)\" stroke-width=\"5\">\u003cline x1=\"40\" y1=\"88\" x2=\"40\" y2=\"132\"/>\u003cline x1=\"160\" y1=\"88\" x2=\"160\" y2=\"132\"/>\u003cline x1=\"78\" y1=\"50\" x2=\"122\" y2=\"50\"/>\u003cline x1=\"240\" y1=\"88\" x2=\"240\" y2=\"132\"/>\u003cline x1=\"360\" y1=\"88\" x2=\"360\" y2=\"132\"/>\u003cline x1=\"286\" y1=\"56\" x2=\"314\" y2=\"56\"/>\u003c/g>\n      \u003cg font-size=\"13\" font-weight=\"700\" text-anchor=\"middle\">\u003ctext x=\"100\" y=\"155\">Te recta 4\"\u003c/text>\u003ctext x=\"300\" y=\"155\">Te reductora 4\" × 2\"\u003c/text>\u003c/g>\n    \u003c/svg>\n  \u003c/div>\u003c/div>\n  \u003cul class=\"list\">\n    \u003cli>La te reductora se nombra primero por la principal y luego por el ramal: \u003cb>4\" × 2\"\u003c/b>.\u003c/li>\n    \u003cli>La \u003cb>cruz\u003c/b> saca dos ramales, uno a cada lado. Se usa poco.\u003c/li>\n    \u003cli>Una te BW lleva \u003cb>3 soldaduras a tope\u003c/b>. Una te SW, \u003cb>3 cordones de ángulo\u003c/b>.\u003c/li>\n  \u003c/ul>\n  \u003cdiv class=\"recuerda\">\u003ch4>Lo que tienes que recordar\u003c/h4>\u003cul>\n    \u003cli>Te = ramal a 90°. Recta (igual) o reductora (menor).\u003c/li>\n    \u003cli>Se nombra principal × ramal: 4\" × 2\".\u003c/li>\n  \u003c/ul>\u003c/div>\n\u003c/section>\n\n\u003c!-- ============ REDUCCIONES ============ -->\n\u003csection id=\"reducciones\" style=\"--c:var(--molten)\">\n  \u003ch2>Reducciones: para cambiar de diámetro\u003c/h2>\n  \u003cdiv class=\"en10\">La \u003cb>reducción\u003c/b> une un tubo grande con uno pequeño. La \u003cb>concéntrica\u003c/b> tiene los dos ejes en línea. La \u003cb>excéntrica\u003c/b> tiene un lado recto: mantiene la parte de abajo (o la de arriba) al mismo nivel.\u003c/div>\n\n  \u003cdiv class=\"diagram\" id=\"red\">\n    \u003csvg viewBox=\"0 0 400 190\" role=\"img\" aria-labelledby=\"redT\" id=\"redSvg\">\u003ctitle id=\"redT\">Reducción entre un tubo de 6 pulgadas y uno de 4 pulgadas, apoyados en soportes.\u003c/title>\u003c/svg>\n    \u003cdiv class=\"tabs\" id=\"redTabs\">\u003c/div>\n    \u003cdiv class=\"panel\" id=\"redPanel\">\u003c/div>\n  \u003c/div>\n  \u003cfigure>\n    \u003cdiv class=\"imgbox zoomable\">\u003cimg id=\"f-c68\" src=\"data:image/jpeg;base64,\" alt=\"Reducción concéntrica (18) y reducción excéntrica (19) con sus cordones de soldadura en rojo y su foto.\">\u003c/div>\n    \u003cfigcaption>\u003cb>Fuente: presentación «6.0 Piping (Básico)», diap. 68.\u003c/b> 18: reducción concéntrica. 19: reducción excéntrica (la «e» es el desplazamiento entre ejes). Cordones en rojo.\u003c/figcaption>\n  \u003c/figure>\n  \u003cfigure>\n    \u003cdiv class=\"imgbox zoomable\">\u003cimg id=\"f-swg\" src=\"data:image/jpeg;base64,\" alt=\"Arriba, varios swages de acero inoxidable; abajo, una reducción concéntrica y una excéntrica negras con sus dibujos.\">\u003c/div>\n    \u003cfigcaption>\u003cb>Fuente: presentación «6.0 Piping (Básico)», diap. 80.\u003c/b> Arriba: \u003cb>swages\u003c/b> (reducciones largas para tubo pequeño). Abajo: reducciones concéntrica y excéntrica (\u003ci>reducer\u003c/i>).\u003c/figcaption>\n  \u003c/figure>\n  \u003cdiv class=\"terms\">\n    \u003ch4>Palabras del taller\u003c/h4>\n    \u003cdl>\n      \u003cdt>BOP (bottom of pipe)\u003c/dt>\u003cdd>La generatriz inferior: la línea de abajo del tubo. Es donde apoya en el soporte.\u003c/dd>\n      \u003cdt>TOP (top of pipe)\u003c/dt>\u003cdd>La generatriz superior: la línea de arriba del tubo.\u003c/dd>\n      \u003cdt>Swage (swage nipple)\u003c/dt>\u003cdd>Reducción alargada, para unir tubos pequeños. Puede tener un extremo roscado o de enchufe.\u003c/dd>\n    \u003c/dl>\n  \u003c/div>\n  \u003cdiv class=\"recuerda\" style=\"--c:var(--molten)\">\u003ch4>Lo que tienes que recordar\u003c/h4>\u003cul>\n    \u003cli>Concéntrica: ejes en línea. Va bien en vertical.\u003c/li>\n    \u003cli>Excéntrica: un lado recto. En horizontal, mantiene el BOP y los soportes son iguales.\u003c/li>\n    \u003cli>Las reducciones de la tubería grande son BW.\u003c/li>\n  \u003c/ul>\u003c/div>\n\u003c/section>\n\n\u003c!-- ============ CIERRES ============ -->\n\u003csection id=\"cierres\">\n  \u003ch2>Tapas, tapones y manguitos\u003c/h2>\n  \u003cdiv class=\"en10\">Para \u003cb>cerrar\u003c/b> un extremo: la \u003cb>tapa\u003c/b> (\u003ci>cap\u003c/i>) soldada o el \u003cb>tapón\u003c/b> roscado. Para \u003cb>empalmar\u003c/b> dos tubos pequeños: el \u003cb>manguito\u003c/b> (\u003ci>coupling\u003c/i>).\u003c/div>\n  \u003cfigure>\n    \u003cdiv class=\"imgbox zoomable\">\u003cimg id=\"f-c64\" src=\"data:image/jpeg;base64,\" alt=\"Te de enchufe (2), manguito roscado (3), codo roscado de 90 grados (4) y medio manguito de enchufe (5); los cordones de soldadura en rojo.\">\u003c/div>\n    \u003cfigcaption>\u003cb>Fuente: presentación «6.0 Piping (Básico)», diap. 64.\u003c/b> 2: te SW. 3: manguito roscado. 4: codo de 90° roscado. 5: medio manguito SW. En rojo, los cordones de ángulo de las piezas de enchufe.\u003c/figcaption>\n  \u003c/figure>\n  \u003cdiv class=\"scroll\">\u003ctable>\n    \u003cthead>\u003ctr>\u003cth>Pieza\u003c/th>\u003cth>Para qué\u003c/th>\u003cth>Unión\u003c/th>\u003c/tr>\u003c/thead>\n    \u003ctbody>\n      \u003ctr>\u003ctd>Tapa (cap)\u003c/td>\u003ctd>Cerrar para siempre el final de una línea\u003c/td>\u003ctd>BW (y SW en pequeño)\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>Tapón (plug)\u003c/td>\u003ctd>Cerrar un extremo que se puede abrir (purgas, venteos)\u003c/td>\u003ctd>TH (macho)\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>Manguito (coupling)\u003c/td>\u003ctd>Unir dos tubos pequeños en línea\u003c/td>\u003ctd>TH o SW\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>Medio manguito (half coupling)\u003c/td>\u003ctd>Sacar una conexión pequeña de un tubo grande\u003c/td>\u003ctd>Se suelda al tubo; el otro lado es TH o SW\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>Unión (union)\u003c/td>\u003ctd>Empalme que se puede desmontar sin girar los tubos\u003c/td>\u003ctd>TH o SW\u003c/td>\u003c/tr>\n    \u003c/tbody>\n  \u003c/table>\u003c/div>\n  \u003cdiv class=\"recuerda\">\u003ch4>Lo que tienes que recordar\u003c/h4>\u003cul>\n    \u003cli>Tapa = para siempre (soldada). Tapón = se puede abrir (roscado).\u003c/li>\n    \u003cli>Manguito = empalme de tubos pequeños.\u003c/li>\n  \u003c/ul>\u003c/div>\n\u003c/section>\n\n\u003c!-- ============ OLETS ============ -->\n\u003csection id=\"olets\" style=\"--c:var(--warn)\">\n  \u003ch2>Picajes: weldolet, sockolet y compañía\u003c/h2>\n  \u003cdiv class=\"en10\">Para sacar un \u003cb>ramal pequeño\u003c/b> de una tubería grande no se usa una te: se hace un agujero y se suelda encima un \u003cb>«olet»\u003c/b>. El tubo pequeño se une al olet a tope (\u003cb>weldolet\u003c/b>), enchufado (\u003cb>sockolet\u003c/b>) o roscado (\u003cb>thredolet\u003c/b>).\u003c/div>\n  \u003cfigure>\n    \u003cdiv class=\"imgbox zoomable\">\u003cimg id=\"f-ol\" src=\"data:image/jpeg;base64,\" alt=\"Arriba, un weldolet presentado sobre un tubo; abajo, un thredolet soldado a un tubo.\">\u003c/div>\n    \u003cfigcaption>\u003cb>Fuente: presentación «6.0 Piping (Básico)», diap. 17.\u003c/b> Weldolet presentado sobre el tubo principal y thredolet ya soldado.\u003c/figcaption>\n  \u003c/figure>\n  \u003cdiv class=\"two\">\n    \u003cfigure style=\"margin:0\">\u003cdiv class=\"imgbox zoomable\">\u003cimg id=\"f-c69\" src=\"data:image/jpeg;base64,\" alt=\"Corte de un thredolet: el ramal se rosca dentro; el olet va soldado a la tubería principal.\">\u003c/div>\u003cfigcaption>\u003cb>Diap. 69.\u003c/b> Thredolet: el ramal se \u003cb>rosca\u003c/b>.\u003c/figcaption>\u003c/figure>\n    \u003cfigure style=\"margin:0\">\u003cdiv class=\"imgbox zoomable\">\u003cimg id=\"f-c70\" src=\"data:image/jpeg;base64,\" alt=\"Corte de un sockolet: el ramal se enchufa y se suelda con un cordón de ángulo.\">\u003c/div>\u003cfigcaption>\u003cb>Diap. 70.\u003c/b> Sockolet: el ramal se \u003cb>enchufa\u003c/b>.\u003c/figcaption>\u003c/figure>\n  \u003c/div>\n  \u003cfigure>\n    \u003cdiv class=\"imgbox zoomable\">\u003cimg id=\"f-c71\" src=\"data:image/jpeg;base64,\" alt=\"Corte de un weldolet: el ramal se suelda a tope sobre el olet, que va soldado a la tubería principal.\">\u003c/div>\n    \u003cfigcaption>\u003cb>Fuente: presentación «6.0 Piping (Básico)», diap. 69 a 71.\u003c/b> Weldolet: el ramal se \u003cb>suelda a tope\u003c/b>. En todos, el olet va soldado a la tubería principal con un cordón todo alrededor (en rojo).\u003c/figcaption>\n  \u003c/figure>\n  \u003cdiv class=\"scroll\">\u003ctable>\n    \u003cthead>\u003ctr>\u003cth>Olet\u003c/th>\u003cth>Qué hace\u003c/th>\u003c/tr>\u003c/thead>\n    \u003ctbody>\n      \u003ctr>\u003ctd>Weldolet\u003c/td>\u003ctd>Ramal soldado a tope (BW). Desde él, la tubería que sale es BW.\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>Sockolet\u003c/td>\u003ctd>Ramal enchufado y soldado (SW). Lo que sale suele ser SW.\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>Thredolet\u003c/td>\u003ctd>Ramal roscado (TH).\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>Nipolet\u003c/td>\u003ctd>Weldolet con un trozo de tubo incorporado. Para purgas, venteos y manómetros.\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>Elbolet\u003c/td>\u003ctd>Se suelda sobre un \u003cb>codo\u003c/b>. Para termómetros e instrumentos.\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>Sweepolet\u003c/td>\u003ctd>Picaje con forma suave, para líneas de alta presión. Se suelda a tope.\u003c/td>\u003c/tr>\n    \u003c/tbody>\n  \u003c/table>\u003c/div>\n  \u003cdiv class=\"callout key\">\u003ch4>¿Te o olet?\u003c/h4>\u003cp>Regla general: si el ramal es \u003cb>del mismo diámetro\u003c/b> o poco más pequeño, se pone una \u003cb>te\u003c/b> (recta o reductora). Si el ramal es \u003cb>mucho más pequeño\u003c/b> (por ejemplo 1\" desde una de 4\"), se pone un \u003cb>olet\u003c/b>. Cada proyecto trae una \u003cb>tabla de picajes\u003c/b> que lo dice exacto: síguela.\u003c/p>\u003c/div>\n  \u003cdiv class=\"callout hot\">\u003ch4>El agujero lo haces tú\u003c/h4>\u003cp>Antes de soldar el olet hay que \u003cb>abrir el agujero\u003c/b> en la tubería principal, del \u003cb>mismo diámetro que el interior del olet\u003c/b>. Y quitar el trozo que cae dentro: un disco de acero suelto dentro de una tubería rompe una bomba o una válvula.\u003c/p>\u003c/div>\n  \u003cdiv class=\"recuerda\" style=\"--c:var(--warn)\">\u003ch4>Lo que tienes que recordar\u003c/h4>\u003cul>\n    \u003cli>Olet = picaje para un ramal pequeño.\u003c/li>\n    \u003cli>Weldolet (a tope), sockolet (enchufe), thredolet (rosca).\u003c/li>\n    \u003cli>Ramal igual → te. Ramal mucho menor → olet.\u003c/li>\n  \u003c/ul>\u003c/div>\n\u003c/section>\n\n\u003c!-- ============ IDENTIFICA ============ -->\n\u003csection id=\"identifica\" style=\"--c:var(--gas)\">\n  \u003ch2>Identifica la pieza\u003c/h2>\n  \u003cdiv class=\"en10\">Es el ejercicio 18 de la presentación. Elige una lámina, mira el dibujo y piensa el nombre. Luego \u003cb>toca el número\u003c/b> para ver la solución.\u003c/div>\n  \u003cdiv class=\"diagram ident\" id=\"idn\">\n    \u003cdiv class=\"tabs\" id=\"idTabs\" style=\"border-top:0\">\u003c/div>\n    \u003cdiv class=\"imgwrap\">\u003cimg id=\"idImg\" alt=\"Lámina de accesorios numerados.\">\u003c/div>\n    \u003cdiv hidden>\u003cimg id=\"L-acc_065\" src=\"data:image/jpeg;base64,\" alt=\"\">\u003cimg id=\"L-acc_066\" src=\"data:image/jpeg;base64,\" alt=\"\">\u003cimg id=\"L-acc_072\" src=\"data:image/jpeg;base64,\" alt=\"\">\u003c/div>\n    \u003cdiv class=\"nums\" id=\"idNums\">\u003c/div>\n    \u003cdiv class=\"panel\" id=\"idPanel\" aria-live=\"polite\">\u003cp class=\"muted\">Toca un número.\u003c/p>\u003c/div>\n  \u003c/div>\n  \u003cp class=\"muted small\">Láminas de la presentación «6.0 Piping (Básico)», diapositivas 64 a 72. Soluciones de la diapositiva 74. En rojo, los cordones de soldadura.\u003c/p>\n\u003c/section>\n\n\u003c!-- ============ IDEAS CLAVE ============ -->\n\u003csection id=\"ideas\">\n  \u003ch2>Ideas clave\u003c/h2>\n  \u003cp class=\"lead\">Si recuerdas esto, sabes qué pieza va en cada sitio y cómo se suelda.\u003c/p>\n  \u003col class=\"keys\">\n    \u003cli>Tres uniones: \u003cb>TH\u003c/b> (rosca), \u003cb>SW\u003c/b> (enchufe + cordón de ángulo) y \u003cb>BW\u003c/b> (a tope).\u003c/li>\n    \u003cli>TH y SW para tubos pequeños; BW para el resto.\u003c/li>\n    \u003cli>En SW el tubo \u003cb>no toca el fondo\u003c/b>: se deja holgura para la dilatación.\u003c/li>\n    \u003cli>Codo \u003cb>LR\u003c/b> (radio 1,5 × NPS) es el normal. \u003cb>SR\u003c/b> (1 × NPS) solo si no hay sitio.\u003c/li>\n    \u003cli>Te recta o reductora: se nombra \u003cb>principal × ramal\u003c/b>.\u003c/li>\n    \u003cli>Reducción \u003cb>concéntrica\u003c/b> en vertical; \u003cb>excéntrica\u003c/b> en horizontal para mantener el BOP.\u003c/li>\n    \u003cli>Tapa = cierre soldado. Tapón = cierre roscado. Manguito = empalme.\u003c/li>\n    \u003cli>Ramal mucho más pequeño → \u003cb>olet\u003c/b> (weldolet, sockolet, thredolet).\u003c/li>\n  \u003c/ol>\n  \u003ch3>Comprueba lo que has aprendido\u003c/h3>\n  \u003cdiv class=\"quiz\" id=\"quiz\">\u003c/div>\n  \u003cdiv class=\"nextblock\">\n    \u003ca href=\"TUB_1_Tuberia.html\">\u003csmall>Anterior\u003c/small>\u003cb>← Bloque 1 · La tubería\u003c/b>\u003c/a>\n    \u003ca class=\"next\" href=\"TUB_3_Bridas_Valvulas.html\">\u003csmall>Siguiente\u003c/small>\u003cb>Bloque 3 · Bridas y válvulas →\u003c/b>\u003c/a>\n  \u003c/div>\n\u003c/section>\n\n\u003cfooter>\n  \u003cp style=\"margin:0 0 1rem\">\u003cb>Recurso elaborado por Xurxo.\u003c/b> Serie Tubería · Bloque 2 de 5.\u003c/p>\n  \u003cdetails>\n    \u003csummary>Fuentes y diferencias entre ellas\u003c/summary>\n    \u003cdiv class=\"in\">\n      \u003cp>\u003cb>Documentos del módulo\u003c/b>\u003c/p>\n      \u003cul>\n        \u003cli>\u003cb>Presentación «6.0 Piping (Básico)»\u003c/b>, apartado 3 «Accesorios»: métodos de unión TH, SW y BW, series, accesorios numerados 1 a 25 y su solución, swage y reducciones, olets. Figuras de las diapositivas 15, 16, 17, 64 a 72 y 80.\u003c/li>\n        \u003cli>\u003cb>«Manual práctico del tubero»\u003c/b>, CIFO Tarragona (2012), págs. 30 y 31: accesorios BW, piezas de transición (weldolet, sockolet, thredolet, nipolet, elbolet, codo y manguito SW), holgura de 3 mm en enchufes; codos y sus radios.\u003c/li>\n        \u003cli>\u003cb>Catálogo Tubasol\u003c/b>, págs. 80 a 85: codos de radio largo y corto, tes y reducciones según ASME B16.9.\u003c/li>\n      \u003c/ul>\n      \u003cp>\u003cb>Fuentes externas\u003c/b>\u003c/p>\n      \u003cul class=\"src\">\n        \u003cli>ASME B31.3, apartado 328.5.2 y fig. 328.5.2C (holgura de 1/16\" antes de soldar los enchufes, interpretación 16-06): \u003ca href=\"https://amarineblog.com/2020/12/07/why-is-the-gap-needed-on-socket-welds/\">amarineblog.com, «Why is the gap needed on socket welds»\u003c/a>\u003c/li>\n        \u003cli>Clases de los accesorios forjados roscados y de enchufe (ASME B16.11): \u003ca href=\"https://blog.projectmaterials.com/pipe-fittings/forged-fittings-socket-weld-threaded\">blog.projectmaterials.com/pipe-fittings/forged-fittings-socket-weld-threaded\u003c/a>\u003c/li>\n      \u003c/ul>\n      \u003cp>\u003cb>Diferencias detectadas\u003c/b>\u003c/p>\n      \u003cul>\n        \u003cli>\u003cb>Holgura del enchufe.\u003c/b> El manual del tubero y los isométricos del módulo dejan \u003cb>3 mm\u003c/b> («dilatación»). La norma ASME B31.3 pide unos \u003cb>1,6 mm\u003c/b>. Se explica la idea (no tocar fondo) y se avisa de que manda el procedimiento de la empresa.\u003c/li>\n        \u003cli>\u003cb>Tamaños de TH y SW.\u003c/b> La presentación dice que hay accesorios SW y TH «hasta 4\"». En la práctica se usan casi siempre hasta 2\" (1½\" en muchas especificaciones). Se dan las dos cosas: «hasta 2\", como mucho 4\"».\u003c/li>\n        \u003cli>\u003cb>Te u olet.\u003c/b> La presentación remite a una tabla de picajes de los apuntes (figura 72) que no está en la carpeta. Se da la regla general y se insiste en seguir la tabla del proyecto.\u003c/li>\n      \u003c/ul>\n      \u003cp class=\"small\">Los dibujos sin pie de fuente son esquemas propios. Toca una imagen para ampliarla.\u003c/p>\n    \u003c/div>\n  \u003c/details>\n\u003c/footer>\n\n\u003c/main>\n\n\u003cdiv class=\"lb\" id=\"lb\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Figura ampliada\">\n  \u003cdiv class=\"top\">\u003cspan>Desliza para moverte por la figura\u003c/span>\u003cbutton type=\"button\" id=\"lbClose\">Cerrar\u003c/button>\u003c/div>\n  \u003cdiv class=\"pan\">\u003cimg id=\"lbImg\" alt=\"\">\u003c/div>\n\u003c/div>\n\n\u003cscript>\nwindow.QUIZ=[\n  {q:\"¿Qué unión necesita un cordón de ángulo alrededor del tubo?\",o:[\"TH (roscada)\",\"SW (de enchufe)\",\"BW (a tope)\"],a:1,\n   e:\"En SW el tubo se enchufa en el accesorio y se suelda por fuera con un cordón de ángulo.\"},\n  {q:\"Vas a soldar un codo SW. ¿Hasta dónde metes el tubo?\",o:[\"Hasta el fondo, bien apretado\",\"Hasta el fondo y lo saco un poco (holgura)\",\"Solo la mitad del enchufe\"],a:1,\n   e:\"Se deja una holgura en el fondo para que el tubo se dilate al soldar sin agrietar el cordón.\"},\n  {q:\"¿Cuál es el radio de un codo de radio largo (LR) de 4\\\"?\",o:[\"4\\\" (101,6 mm)\",\"6\\\" (152,4 mm)\",\"8\\\" (203,2 mm)\"],a:1,\n   e:\"LR: radio = 1,5 × NPS = 1,5 × 4\\\" = 6\\\" = 152,4 mm.\"},\n  {q:\"El plano dice «codo 90°» y nada más. ¿Qué codo pones?\",o:[\"Radio largo (LR)\",\"Radio corto (SR)\",\"Me da igual\"],a:0,\n   e:\"Si no dice nada, el codo es de radio largo.\"},\n  {q:\"Necesitas un codo de 60° de 3\\\". ¿Qué haces?\",o:[\"Corto un codo SW de 90°\",\"Corto un codo BW de 90° y lo biselo\",\"Corto un codo roscado de 90°\"],a:1,\n   e:\"Solo los codos BW se pueden cortar. En SW o TH perderías el enchufe o la rosca.\"},\n  {q:\"Tubería horizontal de 6\\\" que pasa a 4\\\" sobre soportes de la misma altura. ¿Qué reducción?\",o:[\"Concéntrica\",\"Excéntrica, con el lado recto abajo\",\"Una te reductora\"],a:1,\n   e:\"La excéntrica con el lado recto abajo mantiene el BOP: los dos tubos apoyan a la misma altura.\"},\n  {q:\"¿Qué pieza sacas para un ramal de 1\\\" desde una tubería de 6\\\" soldando a tope?\",o:[\"Weldolet\",\"Sockolet\",\"Te recta\"],a:0,\n   e:\"Ramal mucho más pequeño → olet. Si se suelda a tope, weldolet.\"},\n  {q:\"¿Cómo se nombra una te de tubería principal de 4\\\" con un ramal de 2\\\"?\",o:[\"Te 2\\\" × 4\\\"\",\"Te reductora 4\\\" × 2\\\"\",\"Te recta de 4\\\"\"],a:1,\n   e:\"Primero la principal, luego el ramal: te reductora 4\\\" × 2\\\".\"}\n];\n\u003c/script>\n\u003cscript>\n(function(){\n  \"use strict\";\n  var $=function(s,r){return (r||document).querySelector(s)};\n  var $$=function(s,r){return Array.prototype.slice.call((r||document).querySelectorAll(s))};\n  window.$=$; window.$$=$$;\n\n  /* ---------- Barra de progreso y sección activa ---------- */\n  var bar=$(\"#bar\"), links=$$(\"#chips a\"), secs=links.map(function(a){return $(a.getAttribute(\"href\"))});\n  function onScroll(){\n    var h=document.documentElement, max=h.scrollHeight-h.clientHeight;\n    if(bar)bar.style.width=(max>0?Math.min(100,h.scrollTop/max*100):0)+\"%\";\n    var y=window.scrollY+140, cur=0;\n    secs.forEach(function(s,i){if(s&&s.getBoundingClientRect().top+window.scrollY\u003c=y)cur=i});\n    links.forEach(function(a,i){\n      var on=i===cur; a.classList.toggle(\"on\",on);\n      if(on)a.setAttribute(\"aria-current\",\"true\"); else a.removeAttribute(\"aria-current\");\n    });\n    var on=links[cur]; if(on&&on!==onScroll.last){\n      onScroll.last=on; var c=$(\"#chips\"); c.scrollTo({left:on.offsetLeft-c.clientWidth/2+on.clientWidth/2,behavior:\"smooth\"});\n    }\n  }\n  if(links.length){window.addEventListener(\"scroll\",onScroll,{passive:true});window.addEventListener(\"resize\",onScroll);onScroll();}\n\n  /* ---------- Ampliar figuras ---------- */\n  var lb=$(\"#lb\"), lbImg=$(\"#lbImg\");\n  function closeLb(){lb.classList.remove(\"open\");lbImg.removeAttribute(\"src\")}\n  document.addEventListener(\"click\",function(e){\n    var box=e.target.closest&&e.target.closest(\".zoomable\");\n    if(box&&lb){var im=$(\"img\",box);lbImg.src=im.src;lbImg.alt=im.alt;lb.classList.add(\"open\");$(\"#lbClose\").focus()}\n  });\n  if(lb){$(\"#lbClose\").addEventListener(\"click\",closeLb);\n  document.addEventListener(\"keydown\",function(e){if(e.key===\"Escape\")closeLb()});}\n\n  /* ---------- Pestañas genéricas ----------\n     tabs(contenedorBotones, panel, items, pintar)  items: [{t:\"Título\", c:\"var(--arc)\"}...] */\n  window.tabs=function(bar,panel,items,paint){\n    bar.setAttribute(\"role\",\"tablist\");\n    items.forEach(function(it,i){\n      var b=document.createElement(\"button\");b.type=\"button\";b.setAttribute(\"role\",\"tab\");b.textContent=it.t;\n      if(it.c)b.style.setProperty(\"--c\",it.c);\n      b.onclick=function(){sel(i)};bar.appendChild(b);\n    });\n    function sel(i){\n      $$(\"button\",bar).forEach(function(b,j){b.setAttribute(\"aria-selected\",j===i?\"true\":\"false\")});\n      if(items[i].c)panel.style.setProperty(\"--c\",items[i].c);\n      paint(items[i],i);\n    }\n    sel(0);return sel;\n  };\n\n  /* ---------- Comprueba lo que has aprendido ----------\n     window.QUIZ=[{q, o:[...], a:índice, e:\"explicación\", fig:\"id de una \u003cimg> de la página (opcional)\"}] */\n  var quiz=$(\"#quiz\");\n  if(quiz&&window.QUIZ){\n    var Q=window.QUIZ, qi=0, score=0, done=false;\n    var render=function(){\n      if(qi>=Q.length){\n        var msg=score===Q.length?\"¡Perfecto! Lo tienes dominado.\":score>=Q.length*0.75?\"Muy bien. Repasa lo que has fallado y lo tendrás.\":score>=Q.length/2?\"Vas bien, pero repasa las secciones de las preguntas falladas.\":\"Vuelve a leer el bloque con calma y repite el test.\";\n        quiz.innerHTML='\u003cp class=\"q\">Has acertado '+score+' de '+Q.length+'.\u003c/p>\u003cdiv class=\"meter\" aria-hidden=\"true\">\u003cspan style=\"width:'+Math.round(score/Q.length*100)+'%\">\u003c/span>\u003c/div>\u003cp>'+msg+'\u003c/p>\u003cbutton class=\"btn\" type=\"button\" id=\"qr\">Repetir\u003c/button>';\n        $(\"#qr\").onclick=function(){qi=0;score=0;render()};return;\n      }\n      var q=Q[qi];done=false;\n      var fig=\"\";\n      if(q.fig){var src=$(\"#\"+q.fig);if(src)fig='\u003cdiv class=\"qfig\">'+(src.tagName===\"IMG\"?'\u003cimg alt=\"\" src=\"'+src.getAttribute(\"src\")+'\">':src.outerHTML.replace(/\\sid=\"[^\"]*\"/g,\"\"))+'\u003c/div>';}\n      if(q.svg)fig='\u003cdiv class=\"qfig\">'+q.svg+'\u003c/div>';\n      quiz.innerHTML='\u003cdiv class=\"q\">'+(qi+1)+'. '+q.q+'\u003c/div>'+fig+'\u003cdiv class=\"opts\">\u003c/div>\u003cdiv class=\"fb\" hidden>\u003c/div>\u003cdiv class=\"nav\">\u003cspan>'+(qi+1)+' de '+Q.length+'\u003c/span>\u003cbutton class=\"btn\" type=\"button\" id=\"qn\" hidden>'+(qi===Q.length-1?\"Ver resultado\":\"Siguiente\")+'\u003c/button>\u003c/div>';\n      var box=$(\".opts\",quiz);\n      q.o.forEach(function(t,i){\n        var b=document.createElement(\"button\");b.type=\"button\";b.textContent=t;\n        b.onclick=function(){\n          if(done)return;done=true;\n          var ok=i===q.a;if(ok)score++;\n          $$(\"button\",box).forEach(function(x,j){x.disabled=true;if(j===q.a)x.classList.add(\"ok\");else if(j===i)x.classList.add(\"no\")});\n          var fb=$(\".fb\",quiz);fb.hidden=false;fb.innerHTML='\u003cb>'+(ok?\"¡Correcto!\":\"No es esa.\")+'\u003c/b> '+q.e;\n          $(\"#qn\").hidden=false;$(\"#qn\").onclick=function(){qi++;render();quiz.scrollIntoView({block:\"nearest\"})};\n        };\n        box.appendChild(b);\n      });\n    };\n    render();\n  }\n})();\n\n\u003c/script>\n\u003cscript>\n(function(){\n  /* ---- tres uniones ---- */\n  var U=[\n    {t:\"TH · roscada\",c:\"var(--arc)\",h:\"Unión roscada (TH, threaded)\",p:\"El tubo lleva rosca macho y el accesorio rosca hembra. \u003cb>No se suelda\u003c/b>: se pone cinta o pasta y se aprieta. Rápida, pero puede fugar. Solo para tubos pequeños y presiones bajas.\",f:\"En planos y listas: \u003cb>TH\u003c/b>, \u003cb>THD\u003c/b> o \u003cb>NPT\u003c/b> (el tipo de rosca).\"},\n    {t:\"SW · enchufe\",c:\"var(--gas)\",h:\"Enchufe y soldadura (SW, socket-weld)\",p:\"El tubo, con el extremo liso, entra en un hueco del accesorio (el enchufe). Se suelda con \u003cb>un cordón de ángulo\u003c/b> por fuera. No hace falta biselar ni alinear tanto: el enchufe centra el tubo.\",f:\"Deja la \u003cb>holgura\u003c/b> en el fondo. El interior queda con un escalón: no sirve para fluidos que no pueden acumularse.\"},\n    {t:\"BW · a tope\",c:\"var(--molten)\",h:\"Soldadura a tope (BW, butt-weld)\",p:\"Tubo y accesorio, los dos \u003cb>biselados\u003c/b>, se ponen enfrente con una \u003cb>separación de raíz\u003c/b> y se sueldan con \u003cb>penetración completa\u003c/b>. Es la unión más resistente. El interior queda liso.\",f:\"Lo más importante: alinear bien los dos bordes y respetar la separación que diga el procedimiento.\"}\n  ];\n  var S=$(\"#uniSvg\");\n  var draw=[\n    '\u003cg fill=\"var(--arc-soft)\" stroke=\"var(--arc)\" stroke-width=\"2\">\u003cpath d=\"M150 56 H380 V82 H230 V70 H150 Z\"/>\u003cpath d=\"M150 144 H380 V118 H230 V130 H150 Z\"/>\u003c/g>\u003cg fill=\"var(--steel-soft)\" stroke=\"var(--steel)\" stroke-width=\"2\">\u003cpath d=\"M20 70 H230 V82 H20 Z M20 118 H230 V130 H20 Z\"/>\u003c/g>\u003cg stroke=\"var(--ink)\" stroke-width=\"1.5\" fill=\"none\">\u003cpath d=\"M150 70 l5 -5 l5 5 l5 -5 l5 5 l5 -5 l5 5 l5 -5 l5 5 l5 -5 l5 5 l5 -5 l5 5 l5 -5 l5 5 l5 -5 l5 5 M150 130 l5 5 l5 -5 l5 5 l5 -5 l5 5 l5 -5 l5 5 l5 -5 l5 5 l5 -5 l5 5 l5 -5 l5 5 l5 -5 l5 5 l5 -5\"/>\u003c/g>\u003ctext x=\"60\" y=\"105\" font-size=\"13\">tubo\u003c/text>\u003ctext x=\"280\" y=\"105\" font-size=\"13\">accesorio\u003c/text>\u003ctext x=\"170\" y=\"44\" font-size=\"12\" f