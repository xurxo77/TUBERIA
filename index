lumns:repeat(auto-fit,minmax(9.5rem,1fr));margin:1rem 0 .6rem}\n.pick button{font:inherit;font-weight:700;text-align:left;padding:.7rem .85rem;border-radius:10px;border:1.5px solid var(--line);background:var(--card);color:var(--ink);cursor:pointer;min-height:3rem}\n.pick button[aria-pressed=\"true\"]{border-color:var(--arc);background:var(--arc-soft);box-shadow:inset 0 0 0 1px var(--arc)}\n.pick button small{display:block;font-weight:400;color:var(--ink2);font-size:.85rem}\n.result{margin:.4rem 0 1rem;padding:.9rem 1rem;border-radius:10px;background:var(--card);border:1px solid var(--line);border-left:6px solid var(--arc)}\n.result h3{margin:.1rem 0 .4rem;color:var(--arc)}\n.result dl{display:grid;grid-template-columns:auto 1fr;gap:.25rem .8rem;margin:.3rem 0}\n.result dt{font-weight:700}.result dd{margin:0;color:var(--ink)}\n.result .warn{margin:.6rem 0 0;font-size:.95rem;color:var(--warn)}\n/* despiece interactivo */\n.explode{margin:1.2rem 0;background:var(--card);border:1px solid var(--line);border-radius:10px;overflow:hidden}\n.explode svg{display:block;width:100%;height:auto}\n.explode .part{cursor:pointer;transition:opacity .2s}\n.explode .part:focus{outline:none}\n.explode.sel .part{opacity:.3}.explode.sel .part.on{opacity:1}\n.explode .part.on .hl{stroke:var(--molten);stroke-width:3}\n.explode .info{padding:.8rem 1rem 1rem;border-top:1px solid var(--line);min-height:6.5rem}\n.explode .info h3{margin:.1rem 0 .3rem;color:var(--molten)}\n.explode .info p{margin:.3rem 0}\n/* fichas de defecto */\n.defect{margin:1.4rem 0;border:1px solid var(--line);border-radius:12px;background:var(--card);overflow:hidden}\n.defect>header{display:flex;gap:.7rem;align-items:center;padding:.8rem 1rem;background:var(--steel-soft)}\n.defect>header .n{flex:none;width:2.3rem;height:2.3rem;display:grid;place-items:center;border-radius:50%;background:#C0262D;color:#fff;font:700 1.2rem \"Barlow Condensed\",sans-serif}\n.defect>header h3{margin:0;font-size:1.5rem}\n.defect>header .tag{margin-left:auto;font-size:.75rem;font-weight:700;padding:.15rem .5rem;border-radius:99px;background:var(--card);color:var(--ink2);white-space:nowrap}\n.defect .pic{background:var(--paper);padding:.6rem;display:grid;place-items:center;border-bottom:1px solid var(--line)}\n.defect .pic svg{width:100%;max-width:24rem;height:auto}\n.defect .pic img{max-width:100%;height:auto;border-radius:6px}\n.defect .grid4{display:grid;gap:0}\n@media(min-width:620px){.defect .grid4{grid-template-columns:1fr 1fr}}\n.defect .grid4>div{padding:.7rem 1rem .8rem;border-top:1px solid var(--line)}\n.defect .grid4 h4{margin:0 0 .25rem;font:700 1.08rem \"Barlow Condensed\",sans-serif;letter-spacing:.02em;text-transform:uppercase}\n.defect .grid4 ul{margin:.1rem 0 0;padding-left:1.1rem}.defect .grid4 li{margin:.2rem 0}\n.defect .see h4{color:var(--arc)}.defect .why h4{color:var(--molten)}.defect .fix h4{color:var(--gas)}.defect .avoid h4{color:var(--warn)}\n/* diagnóstico */\n.diag{margin:1.2rem 0;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:.8rem 1rem 1rem}\n.diag ol{margin:.5rem 0 0;padding-left:1.3rem}.diag li{margin:.45rem 0}\n.diag .go{font-weight:700}\n/* lista de comprobación */\n.check{list-style:none;padding:0;margin:1rem 0;display:grid;gap:.45rem}\n.check label{display:flex;gap:.7rem;align-items:flex-start;padding:.65rem .85rem;border:1px solid var(--line);border-radius:8px;background:var(--card);cursor:pointer}\n.check input{flex:none;width:1.35rem;height:1.35rem;margin:.1rem 0 0;accent-color:var(--gas)}\n.check label:has(input:checked){background:var(--gas-soft);border-color:var(--gas)}\n.check-status{font-weight:700;color:var(--gas)}\n/* quiz: barra de resultado e imagen */\n.meter{height:.7rem;border-radius:99px;background:var(--steel-soft);overflow:hidden;margin:.4rem 0}\n.meter span{display:block;height:100%;background:var(--gas)}\n.qfig{margin:0 0 .8rem;padding:.4rem;background:#fff;border:1px solid var(--line);border-radius:8px;text-align:center}\n.qfig img,.qfig svg{max-width:100%;max-height:15rem;height:auto}\n/* tabla de colores */\n.sw{display:inline-block;width:1.1rem;height:1.1rem;border-radius:3px;vertical-align:-.2rem;margin-right:.35rem;border:1px solid rgba(0,0,0,.3)}\n.big-num{font:700 2.4rem/1 \"Barlow Condensed\",sans-serif;color:var(--arc)}\n\n/* ===== Añadidos serie MONTAJE ===== */\n/* portada con dibujo en vez de foto */\n.hero svg.bg{display:block;width:100%;height:min(62vh,420px)}\n/* calculadoras y deslizadores */\n.calc{margin:1.2rem 0;background:var(--card);border:1px solid var(--line);border-radius:10px;padding:.9rem 1rem 1rem}\n.calc h3{margin:.1rem 0 .5rem}\n.calc .row{display:flex;flex-wrap:wrap;gap:.6rem 1rem;align-items:end;margin:.4rem 0}\n.calc label{display:flex;flex-direction:column;gap:.25rem;font-size:.92rem;font-weight:700;color:var(--ink2)}\n.calc input[type=number]{font:inherit;font-size:1.1rem;width:7.5rem;padding:.45rem .6rem;border-radius:8px;border:1.5px solid var(--line);background:var(--paper);color:var(--ink)}\n.calc input[type=range]{width:100%;accent-color:var(--arc);min-height:2rem}\n.calc .out{margin:.7rem 0 0;padding:.7rem .9rem;border-radius:8px;background:var(--steel-soft)}\n.calc .out.ok{background:var(--gas-soft)}.calc .out.bad{background:var(--molten-soft)}\n.calc .out b.big{font:700 1.7rem \"Barlow Condensed\",sans-serif}\n.calc svg{display:block;width:100%;max-width:26rem;margin:.4rem auto 0;height:auto}\n/* buscador de palabras */\n.gloss input{font:inherit;width:100%;padding:.6rem .8rem;border-radius:8px;border:1.5px solid var(--line);background:var(--paper);color:var(--ink)}\n.gloss table{margin-top:.6rem}\n.gloss td:first-child{width:45%}\n/* paso a paso con dibujo */\n.stepper{margin:1.3rem 0;background:var(--card);border:1px solid var(--line);border-radius:10px;overflow:hidden}\n.stepper svg{display:block;width:100%;height:auto;background:var(--steel-soft)}\n.stepper .ctrl{display:flex;justify-content:space-between;align-items:center;gap:.5rem;padding:.6rem .9rem;border-top:1px solid var(--line)}\n.stepper .ctrl span{font-weight:700;color:var(--ink2)}\n.stepper .txt{padding:.1rem 1.1rem 1rem}\n.stepper .txt h3{margin:.7rem 0 .3rem;color:var(--arc)}\n.btn.ghost{background:var(--paper);color:var(--ink);border:1.5px solid var(--line)}\n.btn:disabled{opacity:.4;cursor:default}\n.st{transition:opacity .35s}.st.hide{opacity:0}.st.new .hl{filter:drop-shadow(0 0 4px #FF9A2E)}\n\n\u003c/style>\n\u003cstyle>\n.blocks{list-style:none;padding:0;margin:1.4rem 0;display:grid;gap:.9rem}\n@media(min-width:680px){.blocks{grid-template-columns:1fr 1fr}}\n.blocks a{display:flex;flex-direction:column;height:100%;text-decoration:none;color:var(--ink);background:var(--card);border:1px solid var(--line);border-top:6px solid var(--c);border-radius:10px;padding:1rem 1.1rem 1.1rem}\n.blocks a:hover{border-color:var(--c)}\n.blocks .num{font:700 1rem \"Barlow Condensed\",sans-serif;letter-spacing:.06em;text-transform:uppercase;color:var(--c)}\n.blocks h2{font-size:2rem;margin:.1rem 0 .4rem}\n.blocks p{margin:.2rem 0 .6rem;color:var(--ink2)}\n.blocks ul{margin:0 0 .8rem;padding-left:1.1rem}\n.blocks li{margin:.2rem 0}\n.blocks .go{margin-top:auto;font-weight:700;color:var(--c)}\n.blocks .pic{margin:-.2rem 0 .7rem;border-radius:6px;overflow:hidden;background:var(--steel-soft);border:1px solid var(--line)}\n.blocks .pic svg{display:block;width:100%;height:8.5rem}\n\u003c/style>\n\u003c/head>\n\u003cbody>\n\u003cheader class=\"topnav\" id=\"topnav\">\n  \u003cnav class=\"blocknav\" aria-label=\"Bloques de tubería\" style=\"padding-bottom:.5rem\">\n    \u003ca href=\"TUB_0_Portada.html\" class=\"cur\" aria-current=\"page\">Portada\u003c/a>\n    \u003ca href=\"TUB_1_Tuberia.html\">1 La tubería\u003c/a>\n    \u003ca href=\"TUB_2_Accesorios.html\">2 Accesorios\u003c/a>\n    \u003ca href=\"TUB_3_Bridas_Valvulas.html\">3 Bridas y válvulas\u003c/a>\n    \u003ca href=\"TUB_4_Isometricos.html\">4 Isométricos\u003c/a>\n    \u003ca href=\"TUB_5_Taller.html\">5 Al taller\u003c/a>\n  \u003c/nav>\n\u003c/header>\n\n\u003cdiv class=\"hero\" id=\"inicio\">\n  \u003csvg class=\"bg\" viewBox=\"0 0 800 420\" preserveAspectRatio=\"xMidYMid slice\" role=\"img\" aria-label=\"Dibujo: rack de tuberías con codos, bridas y una válvula.\">\n    \u003crect width=\"800\" height=\"420\" fill=\"#16314F\"/>\n    \u003cg stroke=\"#2A4E75\" stroke-width=\"1\">\u003cpath d=\"M0 60 H800 M0 120 H800 M0 180 H800 M0 240 H800 M0 300 H800 M0 360 H800\"/>\u003c/g>\n    \u003cg fill=\"none\" stroke-linecap=\"round\">\n      \u003cpath d=\"M-20 300 H330 a50 50 0 0 0 50 -50 V140 a50 50 0 0 1 50 -50 H820\" stroke=\"#9FB3C8\" stroke-width=\"34\"/>\n      \u003cpath d=\"M-20 300 H330 a50 50 0 0 0 50 -50 V140 a50 50 0 0 1 50 -50 H820\" stroke=\"#C9D6E3\" stroke-width=\"6\" stroke-dasharray=\"0\" opacity=\".35\" transform=\"translate(0,-10)\"/>\n      \u003cpath d=\"M-20 360 H820\" stroke=\"#7F95AC\" stroke-width=\"22\"/>\n    \u003c/g>\n    \u003cg fill=\"#E8EEF5\">\u003crect x=\"180\" y=\"272\" width=\"10\" height=\"56\"/>\u003crect x=\"194\" y=\"272\" width=\"10\" height=\"56\"/>\u003crect x=\"560\" y=\"62\" width=\"10\" height=\"56\"/>\u003crect x=\"574\" y=\"62\" width=\"10\" height=\"56\"/>\u003c/g>\n    \u003cg stroke=\"#FFB27A\" stroke-width=\"4\">\u003cline x1=\"330\" y1=\"283\" x2=\"330\" y2=\"317\"/>\u003cline x1=\"363\" y1=\"250\" x2=\"397\" y2=\"250\"/>\u003cline x1=\"363\" y1=\"140\" x2=\"397\" y2=\"140\"/>\u003cline x1=\"430\" y1=\"73\" x2=\"430\" y2=\"107\"/>\u003c/g>\n    \u003cg transform=\"translate(680 90)\">\u003cpath d=\"M-26 -20 L26 20 V-20 L-26 20 Z\" fill=\"#E8EEF5\"/>\u003cline x1=\"0\" y1=\"0\" x2=\"0\" y2=\"-44\" stroke=\"#E8EEF5\" stroke-width=\"4\"/>\u003cline x1=\"-20\" y1=\"-44\" x2=\"20\" y2=\"-44\" stroke=\"#E8EEF5\" stroke-width=\"5\"/>\u003c/g>\n  \u003c/svg>\n  \u003cdiv class=\"txt wrap\">\n    \u003ch1>Tubería industrial\u003c/h1>\n    \u003cp class=\"sub\">Del tubo al isométrico: medir, unir, leer planos y montar sin fugas.\u003c/p>\n    \u003cp class=\"ctx\">CFGM Soldadura y Calderería · Montaje de tubería\u003c/p>\n    \u003cp class=\"ctx\" style=\"margin-top:.3rem\">\u003cb>Autor: Xurxo\u003c/b>\u003c/p>\n  \u003c/div>\n\u003c/div>\n\n\u003cmain class=\"wrap\">\n\u003csection>\n  \u003cp class=\"lead\">En una fábrica, una refinería o una central hay \u003cb>kilómetros de tubería\u003c/b>. Alguien la corta, la ajusta, la suelda y la monta. Ese alguien puedes ser tú. Sigue los bloques \u003cb>en orden\u003c/b>: primero el tubo, luego las piezas que se le sueldan, después cómo se dibuja y, al final, cómo se pasa del plano al taller.\u003c/p>\n\n  \u003col class=\"blocks\">\n    \u003cli>\u003ca href=\"TUB_1_Tuberia.html\" style=\"--c:var(--arc)\">\n      \u003cspan class=\"num\">Bloque 1\u003c/span>\u003ch2>La tubería\u003c/h2>\n      \u003cdiv class=\"pic\">\u003csvg viewBox=\"0 0 300 120\" aria-hidden=\"true\">\u003cg fill=\"none\" stroke-width=\"10\">\u003ccircle cx=\"70\" cy=\"60\" r=\"36\" stroke=\"var(--arc)\"/>\u003ccircle cx=\"160\" cy=\"60\" r=\"32\" stroke=\"var(--arc)\" stroke-width=\"18\"/>\u003ccircle cx=\"245\" cy=\"60\" r=\"27\" stroke=\"var(--arc)\" stroke-width=\"28\"/>\u003c/g>\u003cg font-size=\"11\" text-anchor=\"middle\">\u003ctext x=\"70\" y=\"114\">SCH 40\u003c/text>\u003ctext x=\"160\" y=\"114\">SCH 80\u003c/text>\u003ctext x=\"245\" y=\"114\">SCH 160\u003c/text>\u003c/g>\u003c/svg>\u003c/div>\n      \u003cp>Qué es, de qué está hecha y cómo se mide.\u003c/p>\n      \u003cul>\u003cli>Pulgadas que no miden una pulgada.\u003c/li>\u003cli>El schedule: el espesor.\u003c/li>\u003cli>Materiales y fabricación.\u003c/li>\u003cli>Extremos lisos, biselados y roscados.\u003c/li>\u003c/ul>\n      \u003cspan class=\"go\">Empezar →\u003c/span>\u003c/a>\u003c/li>\n    \u003cli>\u003ca href=\"TUB_2_Accesorios.html\" style=\"--c:var(--gas)\">\n      \u003cspan class=\"num\">Bloque 2\u003c/span>\u003ch2>Accesorios y uniones\u003c/h2>\n      \u003cdiv class=\"pic\">\u003csvg viewBox=\"0 0 300 120\" aria-hidden=\"true\">\u003cpath d=\"M40 95 H120 a40 40 0 0 0 40 -40 V20\" fill=\"none\" stroke=\"var(--gas)\" stroke-width=\"16\"/>\u003cpath d=\"M200 95 H280 M240 95 V40\" fill=\"none\" stroke=\"var(--gas)\" stroke-width=\"16\"/>\u003cg fill=\"var(--molten)\">\u003ccircle cx=\"120\" cy=\"95\" r=\"6\"/>\u003ccircle cx=\"160\" cy=\"55\" r=\"6\"/>\u003ccircle cx=\"222\" cy=\"95\" r=\"6\"/>\u003ccircle cx=\"258\" cy=\"95\" r=\"6\"/>\u003ccircle cx=\"240\" cy=\"72\" r=\"6\"/>\u003c/g>\u003c/svg>\u003c/div>\n      \u003cp>Las piezas que cambian de dirección, de tamaño o sacan un ramal.\u003c/p>\n      \u003cul>\u003cli>Roscado, enchufe o a tope.\u003c/li>\u003cli>Codos, tes y reducciones.\u003c/li>\u003cli>Weldolet, sockolet y compañía.\u003c/li>\u003cli>Dónde va cada soldadura.\u003c/li>\u003c/ul>\n      \u003cspan class=\"go\">Ver las piezas →\u003c/span>\u003c/a>\u003c/li>\n    \u003cli>\u003ca href=\"TUB_3_Bridas_Valvulas.html\" style=\"--c:var(--molten)\">\n      \u003cspan class=\"num\">Bloque 3\u003c/span>\u003ch2>Bridas y válvulas\u003c/h2>\n      \u003cdiv class=\"pic\">\u003csvg viewBox=\"0 0 300 120\" aria-hidden=\"true\">\u003ccircle cx=\"80\" cy=\"60\" r=\"44\" fill=\"var(--card)\" stroke=\"var(--molten)\" stroke-width=\"4\"/>\u003ccircle cx=\"80\" cy=\"60\" r=\"20\" fill=\"var(--steel-soft)\" stroke=\"var(--molten)\" stroke-width=\"3\"/>\u003cg fill=\"var(--molten)\">\u003ccircle cx=\"80\" cy=\"26\" r=\"5\"/>\u003ccircle cx=\"114\" cy=\"60\" r=\"5\"/>\u003ccircle cx=\"80\" cy=\"94\" r=\"5\"/>\u003ccircle cx=\"46\" cy=\"60\" r=\"5\"/>\u003ccircle cx=\"104\" cy=\"36\" r=\"5\"/>\u003ccircle cx=\"104\" cy=\"84\" r=\"5\"/>\u003ccircle cx=\"56\" cy=\"84\" r=\"5\"/>\u003ccircle cx=\"56\" cy=\"36\" r=\"5\"/>\u003c/g>\u003cpath d=\"M170 40 L260 80 V40 L170 80 Z\" fill=\"var(--molten)\"/>\u003cline x1=\"215\" y1=\"60\" x2=\"215\" y2=\"20\" stroke=\"var(--ink2)\" stroke-width=\"4\"/>\u003cline x1=\"195\" y1=\"20\" x2=\"235\" y2=\"20\" stroke=\"var(--ink2)\" stroke-width=\"5\"/>\u003c/svg>\u003c/div>\n      \u003cp>Las uniones que se desmontan y las piezas que abren y cierran.\u003c/p>\n      \u003cul>\u003cli>Tipos de brida y clases.\u003c/li>\u003cli>Juntas y espárragos.\u003c/li>\u003cli>Apriete en cruz.\u003c/li>\u003cli>Válvulas: para qué sirve cada una.\u003c/li>\u003c/ul>\n      \u003cspan class=\"go\">Ver bridas →\u003c/span>\u003c/a>\u003c/li>\n    \u003cli>\u003ca href=\"TUB_4_Isometricos.html\" style=\"--c:var(--warn)\">\n      \u003cspan class=\"num\">Bloque 4\u003c/span>\u003ch2>Leer un isométrico\u003c/h2>\n      \u003cdiv class=\"pic\">\u003csvg viewBox=\"0 0 300 120\" aria-hidden=\"true\">\u003cg stroke=\"var(--line)\" stroke-width=\"1\">\u003cpath d=\"M0 20 L300 193 M0 60 L300 233 M0 100 L300 273 M0 -20 L300 153 M0 -60 L300 113 M0 -100 L300 73 M300 20 L0 193 M300 60 L0 233 M300 -20 L0 153 M300 -60 L0 113 M300 -100 L0 73\"/>\u003c/g>\u003cpath d=\"M40 90 L110 50 V20 L180 60 L250 20\" fill=\"none\" stroke=\"var(--warn)\" stroke-width=\"5\"/>\u003cg fill=\"var(--ink)\">\u003ccircle cx=\"110\" cy=\"50\" r=\"4\"/>\u003ccircle cx=\"110\" cy=\"20\" r=\"4\"/>\u003ccircle cx=\"180\" cy=\"60\" r=\"4\"/>\u003c/g>\u003cline x1=\"250\" y1=\"10\" x2=\"250\" y2=\"30\" stroke=\"var(--ink)\" stroke-width=\"3\"/>\u003c/svg>\u003c/div>\n      \u003cp>El plano en 3D que usa el tubero.\u003c/p>\n      \u003cul>\u003cli>Norte de planta y ejes.\u003c/li>\u003cli>Símbolos de codos, bridas y válvulas.\u003c/li>\u003cli>Cotas y elevaciones.\u003c/li>\u003cli>Seguir el camino del fluido.\u003c/li>\u003c/ul>\n      \u003cspan class=\"go\">Leer planos →\u003c/span>\u003c/a>\u003c/li>\n    \u003cli>\u003ca href=\"TUB_5_Taller.html\" style=\"--c:var(--steel)\">\n      \u003cspan class=\"num\">Bloque 5\u003c/span>\u003ch2>Del plano al taller\u003c/h2>\n      \u003cdiv class=\"pic\">\u003csvg viewBox=\"0 0 300 120\" aria-hidden=\"true\">\u003cpath d=\"M30 90 H120 a30 30 0 0 0 26 -15 L180 30 a30 30 0 0 1 26 -15 H280\" fill=\"none\" stroke=\"var(--steel)\" stroke-width=\"14\"/>\u003cg stroke=\"var(--molten)\" stroke-width=\"2\" stroke-dasharray=\"5 4\">\u003cline x1=\"120\" y1=\"105\" x2=\"120\" y2=\"70\"/>\u003cline x1=\"206\" y1=\"35\" x2=\"206\" y2=\"2\"/>\u003c/g>\u003ctext x=\"125\" y=\"112\" font-size=\"12\">avance\u003c/text>\u003ctext x=\"150\" y=\"60\" font-size=\"12\" font-weight=\"700\">carrete\u003c/text>\u003c/svg>\u003c/div>\n      \u003cp>Las cuentas y los trucos para cortar y montar a la primera.\u003c/p>\n      \u003cul>\u003cli>El avance de un codo.\u003c/li>\u003cli>Calcular el carrete.\u003c/li>\u003cli>Bayonetas.\u003c/li>\u003cli>Orden de montaje y bridas a nivel.\u003c/li>\u003c/ul>\n      \u003cspan class=\"go\">Al taller →\u003c/span>\u003c/a>\u003c/li>\n  \u003c/ol>\n\n  \u003cdiv class=\"callout shop\">\u003ch4>Cómo usar estos bloques\u003c/h4>\u003cp>Cada bloque tiene recuadros \u003cb>«En 10 segundos»\u003c/b> con lo esencial, dibujos y calculadoras que se pueden \u003cb>tocar\u003c/b>, y un \u003cb>test de 8 preguntas\u003c/b> al final. Lo que viene de fuera de los documentos del módulo va en cajas con \u003cb>borde discontinuo\u003c/b>.\u003c/p>\u003c/div>\n  \u003cdiv class=\"callout key\">\u003ch4>¿Por qué tanto inglés y tantas pulgadas?\u003c/h4>\u003cp>La tubería industrial se diseña casi siempre con \u003cb>normas de Estados Unidos\u003c/b> (ASME, ASTM, API). Por eso en los planos y en los catálogos verás pulgadas, libras y palabras como \u003ci>elbow\u003c/i>, \u003ci>flange\u003c/i> o \u003ci>schedule\u003c/i>. Aquí te las traducimos todas, y las medidas las ponemos también en \u003cb>milímetros\u003c/b>.\u003c/p>\u003c/div>\n\u003c/section>\n\u003cfooter>\n  \u003cp style=\"margin:0\">\u003cb>Recurso elaborado por Xurxo.\u003c/b> Las fuentes de cada bloque están al pie de cada uno.\u003c/p>\n\u003c/footer>\n\u003c/main>\n\u003cscript>\n(function(){\n  \"use strict\";\n  var $=function(s,r){return (r||document).querySelector(s)};\n  v