n:.4rem 0}\n.panel .go{display:inline-block;margin-top:.4rem;font-weight:700}\n.g-dim{opacity:.22;transition:opacity .25s}\n.g-on{transition:opacity .25s}\nsvg text{font-family:\"Atkinson Hyperlegible\",system-ui,sans-serif;fill:var(--ink)}\nsvg .halo{paint-order:stroke;stroke:var(--card);stroke-width:4px;stroke-linejoin:round}\n.flicker{animation:flick .18s steps(2) infinite alternate}\n@keyframes flick{from{opacity:.75}to{opacity:1}}\n.drop{animation:fall 1.1s linear infinite}\n.drop:nth-child(2){animation-delay:.36s}.drop:nth-child(3){animation-delay:.72s}\n@keyframes fall{0%{transform:translateY(-8px);opacity:0}15%{opacity:1}85%{opacity:1}100%{transform:translateY(20px);opacity:0}}\n.still .drop,.still.flicker{animation:none}\n\n/* modos de transferencia */\n.mode{margin:1.3rem 0;background:var(--card);border:1px solid var(--line);border-radius:10px;overflow:hidden}\n.mode .scene{background:var(--steel-soft);display:grid;place-items:center;padding:.6rem}\n.mode .scene svg{width:min(100%,17rem);height:auto}\n.mode .body{padding:.2rem 1.1rem 1.1rem}\n.mode h3{margin:.8rem 0 .3rem}\n.facts{display:grid;grid-template-columns:1fr 1fr;gap:.5rem;margin:.7rem 0}\n.facts div{background:var(--paper);border-radius:6px;padding:.5rem .7rem;font-size:.95rem}\n.facts b{display:block;font:700 1.35rem \"Barlow Condensed\",sans-serif;color:var(--arc)}\n.tw{animation:tw 2.4s ease-in-out infinite}\n@keyframes tw{0%,100%{transform:translateY(0)}38%,52%{transform:translateY(21px)}}\n.arc-cc{animation:arccc 2.4s steps(1) infinite}\n@keyframes arccc{0%{opacity:1}34%{opacity:0}56%{opacity:1}}\n.gl{transform-box:fill-box;transform-origin:50% 0;animation:gl 2.6s ease-in infinite}\n@keyframes gl{0%{transform:scale(.2);opacity:1}62%{transform:scale(1);opacity:1}70%{transform:translateY(0) scale(1);opacity:1}92%{transform:translateY(17px) scale(1);opacity:.9}100%{transform:translateY(17px) scale(.7);opacity:0}}\n.sp{animation:sp .55s linear infinite}\n.sp:nth-of-type(2){animation-delay:.14s}.sp:nth-of-type(3){animation-delay:.28s}.sp:nth-of-type(4){animation-delay:.42s}\n@keyframes sp{0%{transform:translateY(0);opacity:0}15%{opacity:1}100%{transform:translateY(19px);opacity:1}}\n.pu{transform-box:fill-box;transform-origin:50% 0;animation:pu 1.6s ease-in infinite}\n@keyframes pu{0%{transform:scale(.2);opacity:1}18%{transform:scale(.75);opacity:1}24%{transform:translateY(0) scale(.75)}48%{transform:translateY(17px) scale(.75);opacity:1}54%,100%{transform:translateY(17px) scale(.75);opacity:0}}\n.still .tw,.still .arc-cc,.still .gl,.still .sp,.still .pu{animation:none}\n\n/* ampliaciones con fuentes externas */\n.ext{margin:1.4rem 0;padding:.1rem 1rem 1rem;border:1.5px dashed var(--steel);border-radius:10px;background:var(--card)}\n.ext>.tag{display:inline-block;margin:.8rem 0 .1rem;font-size:.85rem;font-weight:700;color:var(--ink2);background:var(--steel-soft);border-radius:99px;padding:.15rem .7rem}\n.ext h3{margin-top:.9rem}\n.ext .scroll{background:var(--paper)}\n.legend{list-style:none;padding:0;margin:.7rem 0 0;display:grid;gap:.45rem}\n.legend li{display:flex;gap:.6rem;align-items:flex-start}\n.legend b{flex:none;display:grid;place-items:center;width:1.55rem;height:1.55rem;border-radius:50%;background:var(--ink);color:var(--card);font-size:.85rem;margin-top:.1rem}\n.figsvg{margin:1.2rem 0}\n.figsvg .diagram{margin:0;padding:.4rem}\n.figsvg svg{max-width:26rem}\n.src a{word-break:break-word}\n/* cierre */\n.keys{list-style:none;margin:1.2rem 0;padding:0;display:grid;gap:.55rem;counter-reset:k}\n.keys li{counter-increment:k;padding:.8rem 1rem .8rem 3.1rem;position:relative;background:var(--card);border:1px solid var(--line);border-radius:8px}\n.keys li::before{content:counter(k);position:absolute;left:.8rem;top:.7rem;width:1.7rem;height:1.7rem;display:grid;place-items:center;border-radius:50%;background:var(--molten);color:#fff;font:700 1.05rem \"Barlow Condensed\",sans-serif}\n:root[data-theme=\"dark\"] .keys li::before{color:#0E141B}\n@media (prefers-color-scheme:dark){:root:not([data-theme=\"light\"]) .keys li::before{color:#0E141B}}\n.quiz{margin:1.2rem 0;background:var(--card);border:1px solid var(--line);border-radius:10px;padding:1rem 1.1rem 1.2rem}\n.quiz .q{font-weight:700;font-size:1.1rem;margin:.2rem 0 .8rem}\n.quiz .opts{display:grid;gap:.5rem}\n.quiz .opts button{font:inherit;text-align:left;padding:.7rem .9rem;border-radius:8px;border:1.5px solid var(--line);background:var(--paper);color:var(--ink);cursor:pointer;min-height:2.8rem}\n.quiz .opts button.ok{border-color:var(--gas);background:var(--gas-soft)}\n.quiz .opts button.no{border-color:var(--molten);background:var(--molten-soft)}\n.quiz .fb{margin:.8rem 0 0;padding:.7rem .9rem;border-radius:8px;background:var(--steel-soft)}\n.quiz .nav{display:flex;justify-content:space-between;align-items:center;margin-top:.9rem;gap:.6rem}\n.quiz .nav span{color:var(--ink2);font-size:.9rem}\n.btn{font:inherit;font-weight:700;padding:.6rem 1.1rem;border-radius:99px;border:0;background:var(--arc);color:var(--on-arc);cursor:pointer;min-height:2.6rem}\nfooter{margin-top:2.5rem;padding:1.6rem 0 2.4rem;border-top:1px solid var(--line);color:var(--ink2);font-size:.9rem}\nfooter ul{padding-left:1.1rem}\n.lb{position:fixed;inset:0;z-index:50;background:rgba(6,9,14,.94);display:none;flex-direction:column}\n.lb.open{display:flex}\n.lb .top{display:flex;justify-content:space-between;align-items:center;padding:calc(.6rem + env(safe-area-inset-top,0px)) 1rem .6rem;color:#fff;font-size:.9rem}\n.lb .top button{font:inherit;font-weight:700;background:#fff;color:#111;border:0;border-radius:99px;padding:.45rem 1rem;min-height:2.5rem;cursor:pointer}\n.lb .pan{flex:1;overflow:auto;-webkit-overflow-scrolling:touch;padding:0 0 calc(1rem + env(safe-area-inset-bottom,0px))}\n.lb .pan img{display:block;width:max(100%,900px);max-width:none;background:#fff;margin:0 auto}\n@media (prefers-reduced-motion:reduce){\n  html{scroll-behavior:auto}\n  *,*::before,*::after{animation:none!important;transition:none!important}\n}\n\n/* ===== Añadidos serie TIG ===== */\n/* navegación entre bloques */\n.blocknav{display:flex;gap:.35rem;overflow-x:auto;padding:.5rem 1.1rem 0;scrollbar-width:none}\n.blocknav::-webkit-scrollbar{display:none}\n.blocknav a{flex:none;text-decoration:none;font-size:.8rem;font-weight:700;color:var(--ink2);padding:.15rem .6rem;border-radius:6px;background:var(--steel-soft)}\n.blocknav a.cur{background:var(--ink);color:var(--card)}\n.nextblock{display:flex;justify-content:space-between;gap:.6rem;flex-wrap:wrap;margin:2rem 0 0}\n.nextblock a{flex:1 1 14rem;display:block;text-decoration:none;padding:.9rem 1rem;border-radius:10px;border:1.5px solid var(--line);background:var(--card);color:var(--ink)}\n.nextblock a small{display:block;color:var(--ink2);font-size:.85rem}\n.nextblock a b{font:700 1.35rem \"Barlow Condensed\",sans-serif;color:var(--arc)}\n.nextblock a.next{text-align:right;border-color:var(--arc)}\n/* \"En 10 segundos\" y \"Lo que tienes que recordar\" */\n.en10{margin:1rem 0 1.1rem;padding:.85rem 1rem;border-radius:10px;background:var(--ink);color:var(--card);font-size:1.12rem;line-height:1.45}\n.en10::before{content:\"EN 10 SEGUNDOS\";display:block;font:700 .82rem \"Barlow Condensed\",sans-serif;letter-spacing:.08em;opacity:.7;margin-bottom:.2rem}\n.en10 b{color:inherit;text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:3px}\n.recuerda{margin:1.4rem 0 .4rem;padding:.8rem 1rem;border:2px solid var(--c,var(--arc));border-radius:10px;background:var(--card)}\n.recuerda h4{margin:0 0 .3rem;font:700 1.15rem \"Barlow Condensed\",sans-serif;color:var(--c,var(--arc))}\n.recuerda ul{margin:.2rem 0 0;padding-left:1.15rem}.recuerda li{margin:.25rem 0}\n.callout.danger{border-left-color:#C0262D;background:#FDE4E4}.callout.danger h4{color:#A1171E}\n:root[data-theme=\"dark\"] .callout.danger{background:#3A1214}:root[data-theme=\"dark\"] .callout.danger h4{color:#FF8A8F}\n@media (prefers-color-scheme:dark){:root:not([data-theme=\"light\"]) .callout.danger{background:#3A1214}:root:not([data-theme=\"light\"]) .callout.danger h4{color:#FF8A8F}}\n.analogy{display:flex;gap:.7rem;align-items:flex-start;margin:1rem 0;padding:.75rem .9rem;border-radius:10px;background:var(--steel-soft)}\n.analogy .ico{flex:none;width:2.2rem;height:2.2rem;display:grid;place-items:center;border-radius:50%;background:var(--card);font:700 1.2rem \"Barlow Condensed\",sans-serif;color:var(--arc)}\n.analogy p{margin:0}\n/* tarjetas de \"qué elegir\" */\n.pick{display:grid;gap:.5rem;grid-template-columns:repeat(auto-fit,minmax(9.5rem,1fr));margin:1rem 0 .6rem}\n.pick button{font:inherit;font-weight:700;text-align:left;padding:.7rem .85rem;border-radius:10px;border:1.5px solid var(--line);background:var(--card);color:var(--ink);cursor:pointer;min-height:3rem}\n.pick button[aria-pressed=\"true\"]{border-color:var(--arc);background:var(--arc-soft);box-shadow:inset 0 0 0 1px var(--arc)}\n.pick button small{display:block;font-weight:400;color:var(--ink2);font-size:.85rem}\n.result{margin:.4rem 0 1rem;padding:.9rem 1rem;border-radius:10px;background:var(--card);border:1px solid var(--line);border-left:6px solid var(--arc)}\n.result h3{margin:.1rem 0 .4rem;color:var(--arc)}\n.result dl{display:grid;grid-template-columns:auto 1fr;gap:.25rem .8rem;margin:.3rem 0}\n.result dt{font-weight:700}.result dd{margin:0;color:var(--ink)}\n.result .warn{margin:.6rem 0 0;font-size:.95rem;color:var(--warn)}\n/* despiece interactivo */\n.explode{margin:1.2rem 0;background:var(--card);border:1px solid var(--line);border-radius:10px;overflow:hidden}\n.explode svg{display:block;width:100%;height:auto}\n.explode .part{cursor:pointer;transition:opacity .2s}\n.explode .part:focus{outline:none}\n.explode.sel .part{opacity:.3}.explode.sel .part.on{opacity:1}\n.explode .part.on .hl{stroke:var(--molten);stroke-width:3}\n.explode .info{padding:.8rem 1rem 1rem;border-top:1px solid var(--line);min-height:6.5rem}\n.explode .info h3{margin:.1rem 0 .3rem;color:var(--molten)}\n.explode .info p{margin:.3rem 0}\n/* fichas de defecto */\n.defect{margin:1.4rem 0;border:1px solid var(--line);border-radius:12px;background:var(--card);overflow:hidden}\n.defect>header{display:flex;gap:.7rem;align-items:center;padding:.8rem 1rem;background:var(--steel-soft)}\n.defect>header .n{flex:none;width:2.3rem;height:2.3rem;display:grid;place-items:center;border-radius:50%;background:#C0262D;color:#fff;font:700 1.2rem \"Barlow Condensed\",sans-serif}\n.defect>header h3{margin:0;font-size:1.5rem}\n.defect>header .tag{margin-left:auto;font-size:.75rem;font-weight:700;padding:.15rem .5rem;border-radius:99px;background:var(--card);color:var(--ink2);white-space:nowrap}\n.defect .pic{background:var(--paper);padding:.6rem;display:grid;place-items:center;border-bottom:1px solid var(--line)}\n.defect .pic svg{width:100%;max-width:24rem;height:auto}\n.defect .pic img{max-width:100%;height:auto;border-radius:6px}\n.defect .grid4{display:grid;gap:0}\n@media(min-width:620px){.defect .grid4{grid-template-columns:1fr 1fr}}\n.defect .grid4>div{padding:.7rem 1rem .8rem;border-top:1px solid var(--line)}\n.defect .grid4 h4{margin:0 0 .25rem;font:700 1.08rem \"Barlow Condensed\",sans-serif;letter-spacing:.02em;text-transform:uppercase}\n.defect .grid4 ul{margin:.1rem 0 0;padding-left:1.1rem}.defect .grid4 li{margin:.2rem 0}\n.defect .see h4{color:var(--arc)}.defect .why h4{color:var(--molten)}.defect .fix h4{color:var(--gas)}.defect .avoid h4{color:var(--warn)}\n/* diagnóstico */\n.diag{margin:1.2rem 0;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:.8rem 1rem 1rem}\n.diag ol{margin:.5rem 0 0;padding-left:1.3rem}.diag li{margin:.45rem 0}\n.diag .go{font-weight:700}\n/* lista de comprobación */\n.check{list-style:none;padding:0;margin:1rem 0;display:grid;gap:.45rem}\n.check label{display:flex;gap:.7rem;align-items:flex-start;padding:.65rem .85rem;border:1px solid var(--line);border-radius:8px;background:var(--card);cursor:pointer}\n.check input{flex:none;width:1.35rem;height:1.35rem;margin:.1rem 0 0;accent-color:var(--gas)}\n.check label:has(input:checked){background:var(--gas-soft);border-color:var(--gas)}\n.check-status{font-weight:700;color:var(--gas)}\n/* quiz: barra de resultado e imagen */\n.meter{height:.7rem;border-radius:99px;background:var(--steel-soft);overflow:hidden;margin:.4rem 0}\n.meter span{display:block;height:100%;background:var(--gas)}\n.qfig{margin:0 0 .8rem;padding:.4rem;background:#fff;border:1px solid var(--line);border-radius:8px;text-align:center}\n.qfig img,.qfig svg{max-width:100%;max-height:15rem;height:auto}\n/* tabla de colores */\n.sw{display:inline-block;width:1.1rem;height:1.1rem;border-radius:3px;vertical-align:-.2rem;margin-right:.35rem;border:1px solid rgba(0,0,0,.3)}\n.big-num{font:700 2.4rem/1 \"Barlow Condensed\",sans-serif;color:var(--arc)}\n\n/* ===== Añadidos serie MONTAJE ===== */\n/* portada con dibujo en vez de foto */\n.hero svg.bg{display:block;width:100%;height:min(62vh,420px)}\n/* calculadoras y deslizadores */\n.calc{margin:1.2rem 0;background:var(--card);border:1px solid var(--line);border-radius:10px;padding:.9rem 1rem 1rem}\n.calc h3{margin:.1rem 0 .5rem}\n.calc .row{display:flex;flex-wrap:wrap;gap:.6rem 1rem;align-items:end;margin:.4rem 0}\n.calc label{display:flex;flex-direction:column;gap:.25rem;font-size:.92rem;font-weight:700;color:var(--ink2)}\n.calc input[type=number]{font:inherit;font-size:1.1rem;width:7.5rem;padding:.45rem .6rem;border-radius:8px;border:1.5px solid var(--line);background:var(--paper);color:var(--ink)}\n.calc input[type=range]{width:100%;accent-color:var(--arc);min-height:2rem}\n.calc .out{margin:.7rem 0 0;padding:.7rem .9rem;border-radius:8px;background:var(--steel-soft)}\n.calc .out.ok{background:var(--gas-soft)}.calc .out.bad{background:var(--molten-soft)}\n.calc .out b.big{font:700 1.7rem \"Barlow Condensed\",sans-serif}\n.calc svg{display:block;width:100%;max-width:26rem;margin:.4rem auto 0;height:auto}\n/* buscador de palabras */\n.gloss input{font:inherit;width:100%;padding:.6rem .8rem;border-radius:8px;border:1.5px solid var(--line);background:var(--paper);color:var(--ink)}\n.gloss table{margin-top:.6rem}\n.gloss td:first-child{width:45%}\n/* paso a paso con dibujo */\n.stepper{margin:1.3rem 0;background:var(--card);border:1px solid var(--line);border-radius:10px;overflow:hidden}\n.stepper svg{display:block;width:100%;height:auto;background:var(--steel-soft)}\n.stepper .ctrl{display:flex;justify-content:space-between;align-items:center;gap:.5rem;padding:.6rem .9rem;border-top:1px solid var(--line)}\n.stepper .ctrl span{font-weight:700;color:var(--ink2)}\n.stepper .txt{padding:.1rem 1.1rem 1rem}\n.stepper .txt h3{margin:.7rem 0 .3rem;color:var(--arc)}\n.btn.ghost{background:var(--paper);color:var(--ink);border:1.5px solid var(--line)}\n.btn:disabled{opacity:.4;cursor:default}\n.st{transition:opacity .35s}.st.hide{opacity:0}.st.new .hl{filter:drop-shadow(0 0 4px #FF9A2E)}\n\n\u003c/style>\n\u003cstyle>\n.iso-grid line{stroke:var(--line);stroke-width:1}\n#rutaSvg .seg{stroke:var(--ink);stroke-width:5;stroke-linecap:round;opacity:.25}\n#rutaSvg .seg.done{opacity:1}\n#rutaSvg .seg.cur{stroke:var(--molten);opacity:1}\n\u003c/style>\n\u003c/head>\n\u003cbody>\n\u003cheader class=\"topnav\" id=\"topnav\">\n  \u003cdiv class=\"bar\" id=\"bar\">\u003c/div>\n  \u003cnav class=\"blocknav\" aria-label=\"Bloques de tubería\">\n    \u003ca href=\"TUB_0_Portada.html\">Portada\u003c/a>\n    \u003ca href=\"TUB_1_Tuberia.html\">1 La tubería\u003c/a>\n    \u003ca href=\"TUB_2_Accesorios.html\">2 Accesorios\u003c/a>\n    \u003ca href=\"TUB_3_Bridas_Valvulas.html\">3 Bridas y válvulas\u003c/a>\n    \u003ca href=\"TUB_4_Isometricos.html\" class=\"cur\" aria-current=\"page\">4 Isométricos\u003c/a>\n    \u003ca href=\"TUB_5_Taller.html\">5 Al taller\u003c/a>\n  \u003c/nav>\n  \u003cnav class=\"chips\" id=\"chips\" aria-label=\"Secciones\">\n    \u003ca href=\"#inicio\">Inicio\u003c/a>\n    \u003ca href=\"#planos\">Los planos\u003c/a>\n    \u003ca href=\"#ejes\">Ejes y norte\u003c/a>\n    \u003ca href=\"#simbolos\">Símbolos\u003c/a>\n    \u003ca href=\"#cotas\">Cotas\u003c/a>\n    \u003ca href=\"#elevaciones\">Elevaciones\u003c/a>\n    \u003ca href=\"#ruta\">Sigue el fluido\u003c/a>\n    \u003ca href=\"#cajetin\">Lo que trae el plano\u003c/a>\n    \u003ca href=\"#palabras\">Inglés\u003c/a>\n    \u003ca href=\"#ideas\">Ideas clave\u003c/a>\n  \u003c/nav>\n\u003c/header>\n\n\u003cdiv class=\"hero\" id=\"inicio\">\n  \u003csvg class=\"bg\" viewBox=\"0 0 800 420\" preserveAspectRatio=\"xMidYMid slice\" role=\"img\" aria-label=\"Dibujo: plano isométrico de una tubería sobre una cuadrícula a 30 grados.\">\n    \u003crect width=\"800\" height=\"420\" fill=\"#16314F\"/>\n    \u003cg stroke=\"#2A4E75\" stroke-width=\"1\" id=\"heroGrid\">\u003c/g>\n    \u003cpath d=\"M120 330 L320 215 V95 L500 199 L660 107\" fill=\"none\" stroke=\"#E8EEF5\" stroke-width=\"7\" stroke-linejoin=\"round\"/>\n    \u003cg fill=\"#FFB27A\">\u003ccircle cx=\"320\" cy=\"215\" r=\"8\"/>\u003ccircle cx=\"320\" cy=\"95\" r=\"8\"/>\u003ccircle cx=\"500\" cy=\"199\" r=\"8\"/>\u003c/g>\n    \u003cg stroke=\"#E8EEF5\" stroke-width=\"6\">\u003cline x1=\"110\" y1=\"312\" x2=\"132\" y2=\"350\"/>\u003cline x1=\"650\" y1=\"89\" x2=\"672\" y2=\"127\"/>\u003c/g>\n    \u003cg font-size=\"20\" font-weight=\"700\">\u003ctext x=\"690\" y=\"60\" style=\"fill:#FFB27A\">N\u003c/text>\u003c/g>\n    \u003cpath d=\"M640 80 L686 54\" stroke=\"#FFB27A\" stroke-width=\"4\"/>\n  \u003c/svg>\n  \u003cdiv class=\"txt wrap\">\n    \u003ch1>Bloque 4. Leer un isométrico\u003c/h1>\n    \u003cp class=\"sub\">El plano en 3D del tubero: una línea, unos puntos y unas cotas que lo dicen todo.\u003c/p>\n    \u003cp class=\"ctx\">CFGM Soldadura y Calderería · Montaje de tubería\u003c/p>\n    \u003cp class=\"ctx\" style=\"margin-top:.3rem\">\u003cb>Autor: Xurxo\u003c/b>\u003c/p>\n  \u003c/div>\n\u003c/div>\n\n\u003cmain class=\"wrap\">\n\n\u003csection id=\"intro\">\n  \u003cp class=\"lead\">En el taller de tubería no se trabaja con el plano de la planta entera. Cada línea tiene su \u003cb>isométrico\u003c/b>: un dibujo en 3D, sin escala, con \u003cb>todo lo que necesitas\u003c/b> para fabricarla y montarla. Si sabes leerlo, sabes qué cortar, qué soldar y dónde va.\u003c/p>\n  \u003ch3>Al terminar sabrás\u003c/h3>\n  \u003cul class=\"list\">\n    \u003cli>distinguir un plano de planta, un alzado y un isométrico;\u003c/li>\n    \u003cli>orientarte con el \u003cb>norte de planta\u003c/b> y los seis sentidos: norte, sur, este, oeste, arriba y abajo;\u003c/li>\n    \u003cli>reconocer los símbolos de tubería, codos, bridas, válvulas y reducciones;\u003c/li>\n    \u003cli>leer cotas y \u003cb>elevaciones\u003c/b>;\u003c/li>\n    \u003cli>describir el \u003cb>camino del fluido\u003c/b> por una línea;\u003c/li>\n    \u003cli>traducir las palabras y abreviaturas en inglés de los planos.\u003c/li>\n  \u003c/ul>\n\u003c/section>\n\n\u003c!-- ============ PLANOS ============ -->\n\u003csection id=\"planos\">\n  \u003ch2>Los planos de una tubería\u003c/h2>\n  \u003cdiv class=\"en10\">Una misma tubería se puede dibujar en \u003cb>2D\u003c/b> (planta y alzados, como en dibujo técnico) o en \u003cb>3D\u003c/b> con el \u003cb>isométrico\u003c/b>. El isométrico es el que se usa en el taller y en el montaje.\u003c/div>\n  \u003cdiv class=\"scroll\">\u003ctable>\n    \u003cthead>\u003ctr>\u003cth>Plano\u003c/th>\u003cth>Qué enseña\u003c/th>\u003cth>Quién lo usa\u003c/th>\u003c/tr>\u003c/thead>\n    \u003ctbody>\n      \u003ctr>\u003ctd>Diagrama de proceso (P&amp;ID)\u003c/td>\u003ctd>Un esquema: qué equipos, qué líneas, qué válvulas e instrumentos. Sin medidas.\u003c/td>\u003ctd>Ingeniería, operación\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>Planta (layout) y alzados\u003c/td>\u003ctd>La instalación vista desde arriba y de lado, a escala, con equipos y tuberías.\u003c/td>\u003ctd>Ingeniería, jefes de obra\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>Isométrico\u003c/td>\u003ctd>\u003cb>Una línea\u003c/b> (o un trozo) en 3D, con cotas, accesorios, soldaduras y lista de materiales.\u003c/td>\u003ctd>\u003cb>Taller y montaje: tú\u003c/b>\u003c/td>\u003c/tr>\n    \u003c/tbody>\n  \u003c/table>\u003c/div>\n  \u003cfigure>\n    \u003cdiv class=\"imgbox zoomable\">\u003cimg id=\"f-tub\" src=\"data:image/jpeg;base64,\" alt=\"Arriba, una tubería en isométrico dibujada con una línea gruesa y puntos; abajo, la misma tubería en 2D con doble línea para 14 pulgadas o más y una línea para 12 o menos.\">\u003c/div>\n    \u003cfigcaption>\u003cb>Fuente: presentación «6.1 Piping (Simbología I)», diap. 14.\u003c/b> En el isométrico (3D) \u003cb>todas las tuberías\u003c/b>, finas o gordas, se dibujan con \u003cb>una línea gruesa\u003c/b>. En 2D, las de 14\" o más se dibujan con doble línea.\u003c/figcaption>\n  \u003c/figure>\n  \u003cdiv class=\"callout hot\">\u003ch4>Sin escala\u003c/h4>\u003cp>El isométrico \u003cb>no está a escala\u003c/b>. Un tramo de 5 m puede estar dibujado más corto que uno de 1 m. \u003cb>Nunca midas con la regla sobre el plano\u003c/b>: lee las cotas.\u003c/p>\u003c/div>\n  \u003cdiv class=\"recuerda\">\u003ch4>Lo que tienes que recordar\u003c/h4>\u003cul>\n    \u003cli>P&amp;ID = esquema. Planta = desde arriba. Isométrico = una línea en 3D.\u003c/li>\n    \u003cli>En el isométrico, toda tubería es una línea gruesa.\u003c/li>\n    \u003cli>No está a escala: manda la cota.\u003c/li>\n  \u003c/ul>\u003c/div>\n\u003c/section>\n\n\u003c!-- ============ EJES ============ -->\n\u003csection id=\"ejes\" style=\"--c:var(--molten)\">\n  \u003ch2>Los ejes y el norte de planta\u003c/h2>\n  \u003cdiv class=\"en10\">En el isométrico hay \u003cb>tres ejes\u003c/b>: uno vertical (arriba y abajo) y dos inclinados \u003cb>30°\u003c/b> (norte-sur y este-oeste). Una \u003cb>flecha N\u003c/b> dice hacia dónde está el norte \u003cb>de la planta\u003c/b>, que no es el norte geográfico.\u003c/div>\n  \u003cdiv class=\"figsvg\">\u003cdiv class=\"diagram\">\n    \u003csvg viewBox=\"0 0 300 240\" role=\"img\" aria-labelledby=\"rosaT\">\n      \u003ctitle id=\"rosaT\">Rosa de los ejes isométricos: arriba, abajo, norte hacia arriba a la derecha, este hacia abajo a la derecha, sur abajo a la izquierda y oeste arriba a la izquierda.\u003c/title>\n      \u003cg stroke=\"var(--ink)\" stroke-width=\"2.5\">\n        \u003cline x1=\"150\" y1=\"120\" x2=\"150\" y2=\"30\"/>\u003cline x1=\"150\" y1=\"120\" x2=\"150\" y2=\"210\"/>\n        \u003cline x1=\"150\" y1=\"120\" x2=\"240\" y2=\"68\"/>\u003cline x1=\"150\" y1=\"120\" x2=\"60\" y2=\"172\"/>\n        \u003cline x1=\"150\" y1=\"120\" x2=\"240\" y2=\"172\"/>\u003cline x1=\"150\" y1=\"120\" x2=\"60\" y2=\"68\"/>\n      \u003c/g>\n      \u003cpath d=\"M240 68 l-16 -1 l8 14 Z\" fill=\"var(--molten)\"/>\n      \u003cg font-size=\"15\" font-weight=\"700\" text-anchor=\"middle\">\n        \u003ctext x=\"150\" y=\"22\">UP · arriba\u003c/text>\u003ctext x=\"150\" y=\"232\">DN · abajo\u003c/text>\n        \u003ctext x=\"262\" y=\"64\" style=\"fill:var(--molten)\">N\u003c/text>\u003ctext x=\"40\" y=\"185\">S\u003c/text>\n        \u003ctext x=\"258\" y=\"190\">E\u003c/text>\u003ctext x=\"44\" y=\"64\">W · O\u003c/text>\n      \u003c/g>\n      \u003cpath d=\"M190 120 A40 40 0 0 0 184.6 100\" fill=\"none\" stroke=\"var(--arc)\" stroke-width=\"2\"/>\u003cline x1=\"150\" y1=\"120\" x2=\"200\" y2=\"120\" stroke=\"var(--arc)\" stroke-dasharray=\"4 3\"/>\u003ctext x=\"203\" y=\"112\" font-size=\"12\" style=\"fill:var(--arc)\">30°\u003c/text>\n    \u003c/svg>\n  \u003c/div>\u003c/div>\n  \u003cfigure>\n    \u003cdiv class=\"imgbox zoomable\">\u003cimg id=\"f-n\" src=\"data:image/jpeg;base64,\" alt=\"Rosa de los ejes en 3D con UP, DN, N, S, E y W, y la flecha del norte en 2D.\">\u003c/div>\n    \u003cfigcaption>\u003cb>Fuente: presentación «6.1 Piping (Simbología I)», diap. 24.\u003c/b> Las abreviaturas en inglés: N = norte, S = sur, E = este, W = oeste (west), UP = arriba, DN = abajo (down). La flecha N es el \u003cb>norte de la planta\u003c/b>.\u003c/figcaption>\n  \u003c/figure>\n  \u003cul class=\"list\">\n    \u003cli>El \u003cb>norte de planta\u003c/b> lo elige la ingeniería para que la planta quede «cuadrada» en los planos. Puede estar girado respecto al norte real.\u003c/li>\n    \u003cli>Los tramos que van \u003cb>N-S\u003c/b> o \u003cb>E-O\u003c/b> se dibujan a 30°. Los verticales, en vertical.\u003c/li>\n    \u003cli>Dos tubos dibujados \u003cb>paralelos\u003c/b> en el isométrico son paralelos en la realidad.\u003c/li>\n  \u003c/ul>\n  \u003cdiv class=\"analogy\">\u003cspan class=\"ico\">≈\u003c/span>\u003cp>\u003cb>Es como mirar una caja de zapatos desde una esquina, un poco desde arriba:\u003c/b> ves tres caras a la vez. Cada arista de la caja es un eje: alto, largo y ancho.\u003c/p>\u003c/div>\n  \u003cdiv class=\"recuerda\" style=\"--c:var(--molten)\">\u003ch4>Lo que tienes que recordar\u003c/h4>\u003cul>\n    \u003cli>Vertical = arriba/abajo. A 30° = norte-sur y este-oeste.\u003c/li>\n    \u003cli>La flecha N es el norte de la planta, no el de la brújula.\u003c/li>\n    \u003cli>W = oeste. DN = abajo.\u003c/li>\n  \u003c/ul>\u003c/div>\n\u003c/section>\n\n\u003c!-- ============ SÍMBOLOS ============ -->\n\u003csection id=\"simbolos\" style=\"--c:var(--gas)\">\n  \u003ch2>Los símbolos\u003c/h2>\n  \u003cdiv class=\"en10\">En el isométrico la tubería es una \u003cb>línea gruesa\u003c/b> y cada \u003cb>soldadura es un punto\u003c/b>. Los accesorios tienen su símbolo. Toca cada uno.\u003c/div>\n  \u003cdiv class=\"diagram\" id=\"sim\">\n    \u003csvg viewBox=\"0 0 320 170\" role=\"img\" aria-labelledby=\"simT\" id=\"simSvg\">\u003ctitle id=\"simT\">Símbolo isométrico elegido sobre una cuadrícula a 30 grados.\u003c/title>\u003c/svg>\n    \u003cdiv class=\"tabs\" id=\"simTabs\">\u003c/div>\n    \u003cdiv class=\"panel\" id=\"simPanel\" aria-live=\"polite\">\u003c/div>\n  \u003c/div>\n  \u003cfigure>\n    \u003cdiv class=\"imgbox zoomable\">\u003cimg id=\"f-bwn\" src=\"data:image/jpeg;base64,\" alt=\"Símbolos de la brida de cuello en 2D (con su foto) y en isométrico, en varias direcciones.\">\u003c/div>\n    \u003cfigcaption>\u003cb>Fuente: presentación «6.1 Piping (Simbología I)», diap. 37.\u003c/b> Brida de cuello (WN) en 2D y en 3D. En 3D: un \u003cb>punto\u003c/b> (la soldadura a tope) y una \u003cb>raya\u003c/b> (la brida), siempre perpendicular al tubo.\u003c/figcaption>\n  \u003c/figure>\n  \u003cdiv class=\"callout shop\">\u003ch4>Cuenta los puntos\u003c/h4>\u003cp>Cada punto es una soldadura que tienes que hacer. Contarlos te dice cuánto trabajo tiene el isométrico. En el Bloque 5 lo usarás para calcular el coste.\u003c/p>\u003c/div>\n  \u003cdiv class=\"recuerda\" style=\"--c:var(--gas)\">\u003ch4>Lo que tienes que recordar\u003c/h4>\u003cul>\n    \u003cli>Línea gruesa = tubo. Punto = soldadura.\u003c/li>\n    \u003cli>Codo BW: un punto en cada extremo. Codo SW o TH: una raya.\u003c/li>\n    \u003cli>Brida: raya perpendicular al tubo.\u003c/li>\n  \u003c/ul>\u003c/div>\n\u003c/section>\n\n\u003c!-- ============ COTAS ============ -->\n\u003csection id=\"cotas\">\n  \u003ch2>Las cotas\u003c/h2>\n  \u003cdiv class=\"en10\">Las cotas van en \u003cb>milímetros\u003c/b> y se miden \u003cb>entre ejes\u003c/b>: de centro a centro de codos, tes y válvulas, o hasta la cara de una brida. \u003cb>No\u003c/b> son el largo del tubo que hay que cortar.\u003c/div>\n  \u003cfigure>\n    \u003cdiv class=\"imgbox zoomable\">\u003cimg id=\"f-cmm\" src=\"data:image/jpeg;base64,\" alt=\"Dos veces el mismo isométrico con bridas de cuello y codos a tope, con cotas en milímetros: 1705, 1638, 2083. En uno el desvío se acota en una pared vertical y en el otro en el suelo.\">\u003c/div>\n    \u003cfigcaption>\u003cb>Fuente: presentación «6.1 Piping (Simbología I)», diap. 40.\u003c/b> Mismo isométrico acotado de dos formas. El tramo que va en diagonal se marca con un \u003cb>triángulo rayado\u003c/b>: en vertical si es una «cota de pared», en horizontal si es una «cota de suelo».\u003c/figcaption>\n  \u003c/figure>\n  \u003cul class=\"list\">\n    \u003cli>La cota va \u003cb>paralela\u003c/b> al tramo que mide, con sus líneas de referencia.\u003c/li>\n    \u003cli>Cuando un tramo va \u003cb>en diagonal\u003c/b> (no sigue ningún eje), se dibuja un \u003cb>triángulo rayado\u003c/b> que dice en qué plano está: el rayado vertical es un plano vertical (pared), el horizontal es el suelo.\u003c/li>\n    \u003cli>Esos tramos en diagonal se llaman \u003cb>bayonetas\u003c/b>. Cómo se calculan, en el Bloque 5.\u003c/li>\n    \u003cli>En planos americanos verás las cotas en \u003cb>pies y pulgadas\u003c/b> (5'-7 ⅛\"). En nuestros ejercicios, siempre en mm.\u003c/li>\n  \u003c/ul>\n  \u003cdiv class=\"callout hot\">\u003ch4>Cota ≠ largo del tubo\u003c/h4>\u003cp>La cota va de eje a eje. El tubo que cortas es \u003cb>más corto\u003c/b>: hay que quitarle lo que ocupan los accesorios y sumar las separaciones de soldadura. Es el error más típico de quien empieza.\u003c/p>\u003c/div>\n  \u003cdiv class=\"recuerda\">\u003ch4>Lo que tienes que recordar\u003c/h4>\u003cul>\n    \u003cli>Cotas en mm, de eje a eje.\u003c/li>\n    \u003cli>Triángulo rayado = tramo en diagonal (bayoneta).\u003c/li>\n    \u003cli>La cota no es el largo del tubo.\u003c/li>\n  \u003c/ul>\u003c/div>\n\u003c/section>\n\n\u003c!-- ============ ELEVACIONES ============ -->\n\u003csection id=\"elevaciones\" style=\"--c:var(--warn)\">\n  \u003ch2>Las elevaciones (EL)\u003c/h2>\n  \u003cdiv class=\"en10\">La \u003cb>elevación\u003c/b> (EL) es la \u003cb>altura\u003c/b> del eje del tubo. Para no tener números negativos, el suelo de la planta se pone a \u003cb>EL 100000\u003c/b> (100 m). Un tubo a EL 100690 está \u003cb>690 mm\u003c/b> por encima del suelo.\u003c/div>\n  \u003cfigure>\n    \u003cdiv class=\"imgbox zoomable\">\u003cimg id=\"f-el\" src=\"data:image/jpeg;base64,\" alt=\"Alzado y perfil de un intercambiador y un recipiente con elevaciones en milímetros: pavimento EL 100000, tubería EL 100690 y eje del intercambiador EL 101950.\">\u003c/div>\n    \u003cfigcaption>\u003cb>Fuente: presentación «6.1 Piping (Simbología I)», diap. 44.\u003c/b> Pavimento a EL 100000. El eje de la tubería a EL 100690 (690 mm sobre el suelo) y el del intercambiador a EL 101950 (1950 mm).\u003c/figcaption>\n  \u003c/figure>\n  \u003cdiv class=\"calc\" id=\"elCalc\">\n    \u003ch3>Calcula la elevación\u003c/h3>\n    \u003cdiv class=\"row\">\n      \u003clabel for=\"elS\">Elevación del suelo\u003cinput id=\"elS\" type=\"number\" step=\"1\" value=\"100000\">\u003c/label>\n      \u003clabel for=\"elH\">Altura del eje sobre el suelo (mm)\u003cinput id=\"elH\" type=\"number\" step=\"1\" value=\"690\">\u003c/label>\n    \u003c/div>\n    \u003cdiv class=\"out\" id=\"elOut\">\u003c/div>\n    \u003cdiv class=\"row\" style=\"margin-top:.8rem\">\n      \u003clabel for=\"elA\">EL de un tramo\u003cinput id=\"elA\" type=\"number\" step=\"1\" value=\"101211\">\u003c/label>\n      \u003clabel for=\"elB\">EL de otro tramo\u003cinput id=\"elB\" type=\"number\" step=\"1\" value=\"100320\">\u003c/label>\n    \u003c/div>\n    \u003cdiv class=\"out\" id=\"elOut2\">\u003c/div>\n  \u003c/div>\n  \u003cul class=\"list\">\n    \u003cli>La elevación es la del \u003cb>eje\u003c/b> (CL, \u003ci>center line\u003c/i>), salvo que el plano diga \u003cb>BOP\u003c/b> (parte de abajo del tubo) o \u003cb>TOP\u003c/b> (parte de arriba).\u003c/li>\n    \u003cli>Con dos elevaciones, la \u003cb>resta\u003c/b> te da cuánto sube o baja un tramo vertical.\u003c/li>\n  \u003c/ul>\n  \u003cdiv class=\"recuerda\" style=\"--c:var(--warn)\">\u003ch4>Lo que tienes que recordar\u003c/h4>\u003cul>\n    \u003cli>EL = altura del eje. Suelo = EL 100000.\u003c/li>\n    \u003cli>Diferencia de EL = largo de un tramo vertical (entre ejes).\u003c/li>\n  \u003c/ul>\u003c/div>\n\u003c/section>\n\n\u003c!-- ============ RUTA ============ -->\n\u003csection id=\"ruta\" style=\"--c:var(--arc)\">\n  \u003ch2>Sigue el camino del fluido\u003c/h2>\n  \u003cdiv class=\"en10\">Leer un isométrico es \u003cb>recorrerlo con el dedo\u003c/b>, de brida a brida, diciendo hacia dónde va: «sale al norte, baja, gira al este…». Si sabes contarlo, lo entiendes.\u003c/div>\n  \u003cdiv class=\"stepper\" id=\"rt\">\n    \u003csvg viewBox=\"0 0 400 260\" role=\"img\" aria-labelledby=\"rtT\" id=\"rutaSvg\">\u003ctitle id=\"rtT\">Isométrico de ejemplo; el tramo actual se marca en naranja.\u003c/title>\u003c/svg>\n    \u003cdiv class=\"ctrl\">\u003cbutton class=\"btn ghost\" type=\"button\" id=\"rPrev\">← Anterior\u003c/button>\u003cspan id=\"rN\">\u003c/span>\u003cbutton class=\"btn\" type=\"button\" id=\"rNext\">Siguiente →\u003c/button>\u003c/div>\n    \u003cdiv class=\"txt\" id=\"rTxt\" aria-live=\"polite\">\u003c/div>\n  \u003c/div>\n  \u003ch3>Ahora tú\u003c/h3>\n  \u003cfigure>\n    \u003cdiv class=\"imgbox zoomable\">\u003cimg id=\"f-tr\" src=\"data:image/jpeg;base64,\" alt=\"Cuatro isométricos A, B, C y D de 6, 8, 4 y 12 pulgadas para describir la trayectoria del fluido.\">\u003c/div>\n    \u003cfigcaption>\u003cb>Fuente: presentación «6.1 Piping (Simbología I)», diap. 45, ejercicio 1.\u003c/b> Describe el camino del fluido en A, B, C y D. Fíjate en la flecha N de cada uno: no siempre está igual.\u003c/figcaption>\n  \u003c/figure>\n  \u003cdetails>\u003csummary>Solución del isométrico A\u003c/summary>\u003cdiv class=\"in\">\n    \u003cfigure>\u003cdiv class=\"imgbox zoomable\">\u003cimg id=\"f-tra\" src=\"data:image/jpeg;base64,\" alt=\"Solución del isométrico A: sale de la brida al norte, baja, gira al este, sube, va al norte, al oeste, al norte y termina en la brida.\">\u003c/div>\n    \u003cfigcaption>\u003cb>Fuente: presentación «6.1 Piping (Simbología I)», diap. 46.\u003c/b>\u003c/figcaption>\u003c/figure>\n    \u003col class=\"list\">\u003cli>Sale de la brida de la izquierda hacia el \u003cb>norte\u003c/b>.\u003c/li>\u003cli>En un codo, \u003cb>baja\u003c/b>.\u003c/li>\u003cli>En otro codo, gira al \u003cb>este\u003c/b>.\u003c/li>\u003cli>\u003cb>Sube\u003c/b>.\u003c/li>\u003cli>Va al \u003cb>norte\u003c/b>.\u003c/li>\u003cli>Va al \u003cb>oeste\u003c/b>.\u003c/li>\u003cli>Vuelve al \u003cb>norte\u003c/b>.\u003c/li>\u003cli>Termina en la brida de la derecha.\u003c/li>\u003c/ol>\n  \u003c/div>\u003c/details>\n  \u003cdiv class=\"recuerda\">\u003ch4>Lo que tienes que recordar\u003c/h4>\u003cul>\n    \u003cli>Recorre la línea de brida a brida.\u003c/li>\n    \u003cli>Cada codo es un cambio: dirección (N, S, E, O) o altura (sube, baja).\u003c/li>\n    \u003cli>Mira primero la flecha N.\u003c/li>\n  \u003c/ul>\u003c/div>\n\u003c/section>\n\n\u003c!-- ============ CAJETÍN ============ -->\n\u003csection id=\"cajetin\" style=\"--c:var(--steel)\">\n  \u003ch2>Lo que trae el isométrico, además del dibujo\u003c/h2>\n  \u003cdiv class=\"en10\">Un isométrico real trae el \u003cb>nombre de la línea\u003c/b>, el \u003cb>número de plano\u003c/b>, a qué plano \u003cb>continúa\u003c/b>, y una \u003cb>lista de materiales\u003c/b> con cada pieza.\u003c/div>\n  \u003cfigure>\n    \u003cdiv class=\"imgbox zoomable\">\u003cimg id=\"f-ej1\" src=\"data:image/jpeg;base64,\" alt=\"Isométrico de ejercicio con la línea 5 pulgadas 5664 V FA, cotas en milímetros y una lista de lo que se pide: número de plano, elevaciones, tabla de accesorios, diámetros, carretes, cantidad de tubo y precio de soldadura.\">\u003c/div>\n    \u003cfigcaption>\u003cb>Fuente: «16 Isométricos» del módulo, ejercicio 1.\u003c/b> El nombre de la línea va escrito a lo largo del tubo: \u003cb>5\" - 5664 - V - FA\u003c/b>.\u003c/figcaption>\n  \u003c/figure>\n  \u003cdiv class=\"scroll\">\u003ctable>\n    \u003cthead>\u003ctr>\u003cth>Dato\u003c/th>\u003cth>Ejemplo\u003c/th>\u003cth>Qué te dice\u003c/th>\u003c/tr>\u003c/thead>\n    \u003ctbody>\n      \u003ctr>\u003ctd>Nombre de la línea\u003c/td>\u003ctd>5\" - 5664 - V - FA\u003c/td>\u003ctd>Diámetro (5\"), número de línea (5664) y los códigos del fluido y de la \u003cb>especificación\u003c/b> (el «menú» de materiales, clases y espesores de esa línea). Los códigos se explican en la leyenda del proyecto.\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>Número de plano\u003c/td>\u003ctd>EL-5032 (en un cajetín o junto a la línea)\u003c/td>\u003ctd>Qué isométrico es.\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>Continuación\u003c/td>\u003ctd>«Continúa en ISO 5033»\u003c/td>\u003ctd>La línea sigue en otro plano.\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>Lista de materiales (BOM)\u003c/td>\u003ctd>4 codos 90° LR 5\" SCH 40, 2 bridas WN…\u003c/td>\u003ctd>Todo lo que hay que pedir al almacén.\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>Soldadura de campo (FW)\u003c/td>\u003ctd>Un punto con «FW»\u003c/td>\u003ctd>Esa soldadura se hace \u003cb>en la obra\u003c/b>, no en el taller. Se suele dejar el tubo un poco más largo para ajustar.\u003c/td>\u003c/tr>\n    \u003c/tbody>\n  \u003c/table>\u003c/div>\n\u003c/section>\n\n\u003c!-- ============ PALABRAS ============ -->\n\u003csection id=\"palabras\" style=\"--c:var(--warn)\">\n  \u003ch2>El inglés de los planos\u003c/h2>\n  \u003cdiv class=\"en10\">Los isométricos y los catálogos vienen llenos de abreviaturas en inglés. Busca aquí la que no entiendas.\u003c/div>\n  \u003cdiv class=\"calc gloss\">\n    \u003clabel for=\"gq\">Escribe la palabra o la abreviatura\u003c/label>\n    \u003cinput id=\"gq\" type=\"search\" placeholder=\"Por ejemplo: ELL, BOP, gasket…\" autocomplete=\"off\">\n    \u003cdiv class=\"scroll\">\u003ctable>\u003cthead>\u003ctr>\u003cth>En el plano\u003c/th>\u003cth>En castellano\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody id=\"gt\">\u003c/tbody>\u003c/table>\u003c/div>\n  \u003c/div>\n\u003c/section>\n\n\u003c!-- ============ IDEAS CLAVE ============ -->\n\u003csection id=\"ideas\">\n  \u003ch2>Ideas clave\u003c/h2>\n  \u003cp class=\"lead\">Si recuerdas esto, un isométrico ya no es un jeroglífico.\u003c/p>\n  \u003col class=\"keys\">\n    \u003cli>El \u003cb>isométrico\u003c/b> dibuja una línea en 3D. Es el plano del taller y del montaje.\u003c/li>\n    \u003cli>Ejes: \u003cb>vertical\u003c/b> (arriba/abajo) y dos a \u003cb>30°\u003c/b> (N-S y E-O).\u003c/li>\n    \u003cli>La flecha \u003cb>N\u003c/b> es el norte de la planta. W = oeste, DN = abajo.\u003c/li>\n    \u003cli>Línea gruesa = tubo. \u003cb>Punto = soldadura\u003c/b>. Raya perpendicular = brida.\u003c/li>\n    \u003cli>No está a escala: \u003cb>manda la cota\u003c/b>, en mm y de eje a eje.\u003c/li>\n    \u003cli>Triángulo rayado = tramo en diagonal (\u003cb>bayoneta\u003c/b>).\u003c/li>\n    \u003cli>\u003cb>EL\u003c/b> = altura del eje. Suelo = EL 100000.\u003c/li>\n    \u003cli>Léelo recorriéndolo: «sale al norte, baja, gira al este…».\u003c/li>\n  \u003c/ol>\n  \u003ch3>Comprueba lo que has aprendido\u003c/h3>\n  \u003cdiv class=\"quiz\" id=\"quiz\">\u003c/div>\n  \u003cdiv class=\"nextblock\">\n    \u003ca href=\"TUB_3_Bridas_Valvulas.html\">\u003csmall>Anterior\u003c/small>\u003cb>← Bloque 3 · Bridas y válvulas\u003c/b>\u003c/a>\n    \u003ca class=\"next\" href=\"TUB_5_Taller.html\">\u003csmall>Siguiente\u003c/small>\u003cb>Bloque 5 · Al taller →\u003c/b>\u003c/a>\n  \u003c/div>\n\u003c/section>\n\n\u003cfooter>\n  \u003cp style=\"margin:0 0 1rem\">\u003cb>Recurso elaborado por Xurxo.\u003c/b> Serie Tubería · Bloque 4 de 5.\u003c/p>\n  \u003cdetails>\n    \u003csummary>Fuentes y diferencias entre ellas\u003c/summary>\n    \u003cdiv class=\"in\">\n      \u003cp>\u003cb>Documentos del módulo\u003c/b>\u003c/p>\n      \u003cul>\n        \u003cli>\u003cb>Presentación «6.1 Piping (Simbología I)»\u003c/b>: planos 2D y 3D, norte de planta, símbolos de tubería, codos, bridas y reducciones, cotas de pared y de suelo, elevaciones en mm con pavimento a 100000, ejercicios de trayectoria. Figuras de las diapositivas 14, 24, 37, 40, 44, 45 y 46.\u003c/li>\n        \u003cli>\u003cb>«16 Isométricos»\u003c/b> del módulo: ejercicios con nombre de línea, clases, penetración y dilatación. Figura del ejercicio 1.\u003c/li>\n        \u003cli>\u003cb>«Manual práctico del tubero»\u003c/b>, CIFO Tarragona (2012), cap. 2: coordenadas de obra, proyección ortogonal e isométrica, diagramas P&amp;ID, simbología.\u003c/li>\n      \u003c/ul>\n      \u003cp>\u003cb>Diferencias detectadas\u003c/b>\u003c/p>\n      \u003cul>\n        \u003cli>\u003cb>Unidades.\u003c/b> La presentación trae ejemplos en pies y pulgadas (planos americanos) y en mm. Se trabaja en \u003cb>mm\u003c/b>, como dice la propia presentación («nosotros pondremos las elevaciones en mm»).\u003c/li>\n        \u003cli>\u003cb>Codos SW y TH.\u003c/b> La presentación avisa de que no todas las empresas los dibujan igual (unas con una raya, otras con un punto). Aquí se usa la raya, y se recuerda mirar la leyenda del proyecto.\u003c/li>\n        \u003cli>\u003cb>Nombre de la línea.\u003c/b> Los ejercicios usan «5\" - 5664 - V - FA» sin explicar las letras. Cada proyecto tiene su código; se explica qué partes suele tener y se remite a la leyenda.\u003c/li>\n      \u003c/ul>\n      \u003cp class=\"small\">Los dibujos sin pie de fuente son esquemas propios. Toca una imagen para ampliarla.\u003c/p>\n    \u003c/div>\n  \u003c/details>\n\u003c/footer>\n\n\u003c/main>\n\n\u003cdiv class=\"lb\" id=\"lb\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Figura ampliada\">\n  \u003cdiv class=\"top\">\u003cspan>Desliza para moverte por la figura\u003c/span>\u003cbutton type=\"button\" id=\"lbClose\">Cerrar\u003c/button>\u003c/div>\n  \u003cdiv class=\"pan\">\u003cimg id=\"lbImg\" alt=\"\">\u003c/div>\n\u003c/div>\n\n\u003cscript>\nwindow.QUIZ=[\n  {q:\"¿Qué plano usas en el taller para fabricar una línea de tubería?\",o:[\"El P&ID\",\"El isométrico\",\"La planta general\"],a:1,\n   e:\"El isométrico dibuja la línea en 3D con todas las cotas, accesorios y soldaduras.\"},\n  {q:\"En un isométrico, ¿qué quiere decir un punto sobre la línea?\",o:[\"Un soporte\",\"Una soldadura\",\"Un cambio de diámetro\"],a:1,\n   e:\"Cada punto es una soldadura. Contarlos te dice cuánto trabajo hay.\"},\n  {q:\"En el plano un tramo de 3 m parece más corto que otro de 1 m. ¿Qué pasa?\",o:[\"El plano está mal\",\"Nada: el isométrico no está a escala, mandan las cotas\",\"Hay que medir con regla\"],a:1,\n   e:\"El isométrico no va a escala. Se leen las cotas, nunca se mide sobre el papel.\"},\n  {q:\"La flecha N del isométrico indica…\",o:[\"El norte geográfico, el de la brújula\",\"El norte de la planta, elegido por la ingeniería\",\"Hacia dónde va el fluido\"],a:1,\n   e:\"Es el norte de planta. Puede no coincidir con el geográfico.\"},\n  {q:\"¿Qué significa «DN» junto a la rosa de los ejes?\",o:[\"Diámetro nominal\",\"Abajo (down)\",\"Dirección norte\"],a:1,\n   e:\"En la rosa de ejes, UP = arriba y DN = abajo. (Ojo: en un tubo, DN es diámetro nominal. Mira el contexto.)\"},\n  {q:\"El suelo está a EL 100000 y el eje de un tubo a EL 101950. ¿A qué altura está el eje?\",o:[\"101,95 m\",\"1950 mm sobre el suelo\",\"19,5 m\"],a:1,\n   e:\"101950 − 100000 = 1950 mm sobre el suelo.\"},\n  {q:\"Una cota de 1638 entre dos codos, ¿es el largo del tubo que cortas?\",o:[\"Sí, exacto\",\"No: es de eje a eje; el tubo es más corto\",\"No: hay que sumarle los codos\"],a:1,\n   e:\"La cota va entre ejes. Al tubo hay que quitarle lo que ocupan los codos (el avance) y tener en cuenta la separación de soldadura.\"},\n  {q:\"Un tramo en diagonal lleva dibujado un triángulo rayado en vertical. ¿Qué indica?\",o:[\"Que va en un plano vertical (cota de pared)\",\"Que es una soldadura de campo\",\"Que lleva aislamiento\"],a:0,\n   e:\"El rayado dice en qué plano está la bayoneta: vertical (pared) u horizontal (suelo).\"}\n];\n\u003c/script>\n\u003cscript>\n(function(){\n  \"use strict\";\n  var $=function(s,r){return (r||document).querySelector(s)};\n  var $$=function(s,r){r