gle(\"on\",+g.getAttribute(\"data-k\")===k)});info.innerHTML='\u003ch3>'+P[k].h+'\u003c/h3>\u003cp>'+P[k].p+'\u003c/p>'}\n  parts.forEach(function(g){var k=+g.getAttribute(\"data-k\");g.addEventListener(\"click\",function(){show(k)});g.addEventListener(\"keydown\",function(e){if(e.key===\"Enter\"||e.key===\" \"){e.preventDefault();show(k)}})});\n\n  /* ---- tipos de brida (medio corte, eje abajo) ---- */\n  var AX='\u003cline x1=\"10\" y1=\"150\" x2=\"390\" y2=\"150\" stroke=\"var(--ink2)\" stroke-dasharray=\"10 4 2 4\"/>\u003ctext x=\"300\" y=\"145\" font-size=\"11\" style=\"fill:var(--ink2)\">eje\u003c/text>';\n  var TUBO=function(x2){return '\u003crect x=\"20\" y=\"100\" width=\"'+(x2-20)+'\" height=\"10\" fill=\"var(--steel-soft)\" stroke=\"var(--steel)\" stroke-width=\"2\"/>\u003ctext x=\"40\" y=\"94\" font-size=\"12\">tubo\u003c/text>'};\n  var W='fill=\"var(--molten)\" stroke=\"var(--molten)\"';\n  var B=[\n    {t:\"WN · cuello\",c:\"var(--arc)\",h:\"Brida de cuello (WN, welding neck)\",p:\"Tiene un \u003cb>cuello cónico\u003c/b> que se suelda \u003cb>a tope\u003c/b> al tubo, con bisel y penetración completa. Es la más resistente y la más usada en procesos de presión y temperatura. Hay que pedirla con el \u003cb>schedule del tubo\u003c/b>, para que coincidan los espesores.\",\n     d:TUBO(116)+'\u003cpath d=\"M120 100 L170 75 V40 H200 V110 H120 Z\" fill=\"var(--arc-soft)\" stroke=\"var(--arc)\" stroke-width=\"2\"/>\u003cpath d=\"M112 96 L124 96 L120 110 L116 110 Z\" '+W+'/>\u003ctext x=\"210\" y=\"70\" font-size=\"12\" font-weight=\"700\" style=\"fill:var(--molten)\">1 soldadura a tope\u003c/text>'},\n    {t:\"SO · deslizante\",c:\"var(--gas)\",h:\"Brida deslizante (SO, slip-on)\",p:\"El tubo \u003cb>entra\u003c/b> por dentro de la brida. Se suelda con \u003cb>dos cordones de ángulo\u003c/b>: uno por fuera y otro por dentro, en la cara. El tubo se queda un poco antes de la cara (unos milímetros) para que quepa el cordón interior. Más barata y fácil de alinear, pero aguanta menos.\",\n     d:TUBO(194)+'\u003cpath d=\"M134 100 L150 82 V40 H200 V100 Z\" fill=\"var(--gas-soft)\" stroke=\"var(--gas)\" stroke-width=\"2\"/>\u003cpath d=\"M120 100 L140 100 L140 92 Z\" '+W+'/>\u003cpath d=\"M194 110 V100 H200 Z\" '+W+'/>\u003ctext x=\"210\" y=\"70\" font-size=\"12\" font-weight=\"700\" style=\"fill:var(--molten)\">2 cordones de ángulo\u003c/text>\u003ctext x=\"210\" y=\"88\" font-size=\"11\">fuera y dentro\u003c/text>'},\n    {t:\"SW · enchufe\",c:\"var(--molten)\",h:\"Brida de enchufe (SW, socket-weld)\",p:\"Como la deslizante, pero el agujero tiene un \u003cb>escalón\u003c/b> (el enchufe). El tubo entra hasta el escalón, se saca la \u003cb>holgura\u003c/b> y se suelda con \u003cb>un cordón de ángulo por fuera\u003c/b>. Para tubos pequeños.\",\n     d:TUBO(182)+'\u003cpath d=\"M134 100 L150 82 V40 H200 V110 H186 V100 Z\" fill=\"var(--molten-soft)\" stroke=\"var(--molten)\" stroke-width=\"2\"/>\u003cpath d=\"M120 100 L140 100 L140 92 Z\" '+W+'/>\u003cline x1=\"182\" y1=\"105\" x2=\"186\" y2=\"105\" stroke=\"var(--ink)\" stroke-width=\"2\"/>\u003ctext x=\"210\" y=\"70\" font-size=\"12\" font-weight=\"700\" style=\"fill:var(--molten)\">1 cordón de ángulo\u003c/text>\u003ctext x=\"210\" y=\"88\" font-size=\"11\">y holgura en el fondo\u003c/text>'},\n    {t:\"Roscada\",c:\"var(--steel)\",h:\"Brida roscada (TH)\",p:\"El tubo, roscado, se \u003cb>enrosca\u003c/b> en la brida. \u003cb>No se suelda.\u003c/b> Para tubos pequeños, presiones bajas o sitios donde no se puede soldar (zonas con riesgo de incendio).\",\n     d:TUBO(196)+'\u003cpath d=\"M150 100 V40 H200 V100 Z\" fill=\"var(--steel-soft)\" stroke=\"var(--steel)\" stroke-width=\"2\"/>\u003cpath d=\"M150 100 l5 -5 l5 5 l5 -5 l5 5 l5 -5 l5 5 l5 -5 l5 5 l5 -5 l5 5\" fill=\"none\" stroke=\"var(--ink)\" stroke-width=\"1.5\"/>\u003ctext x=\"210\" y=\"70\" font-size=\"12\" font-weight=\"700\">sin soldadura\u003c/text>'},\n    {t:\"Loca\",c:\"var(--warn)\",h:\"Brida loca (lap joint) con collarín (stub end)\",p:\"Al tubo se le suelda a tope un \u003cb>collarín\u003c/b> (stub end). La brida va \u003cb>suelta\u003c/b> detrás y \u003cb>gira\u003c/b>: así es fácil alinear los agujeros. Se usa mucho con \u003cb>inoxidable\u003c/b>: el collarín es de inox y la brida, que no toca el fluido, puede ser de acero al carbono, más barata.\",\n     d:TUBO(116)+'\u003cpath d=\"M120 100 H190 V68 H200 V110 H120 Z\" fill=\"var(--warn-soft)\" stroke=\"var(--warn)\" stroke-width=\"2\"/>\u003cpath d=\"M158 98 V40 H188 V98 Z\" fill=\"var(--arc-soft)\" stroke=\"var(--arc)\" stroke-width=\"2\"/>\u003cpath d=\"M112 96 L124 96 L120 110 L116 110 Z\" '+W+'/>\u003ctext x=\"210\" y=\"60\" font-size=\"12\" font-weight=\"700\">brida suelta\u003c/text>\u003ctext x=\"120\" y=\"128\" font-size=\"11\">collarín (stub end)\u003c/text>'},\n    {t:\"Ciega\",c:\"#C0262D\",h:\"Brida ciega (blind)\",p:\"Un disco \u003cb>sin agujero central\u003c/b>. Cierra el final de una línea o una boquilla que no se usa. No se suelda: se atornilla a otra brida con su junta. Muy útil para pruebas de presión.\",\n     d:'\u003cpath d=\"M170 40 H200 V150 H170 Z\" fill=\"#FDE4E4\" stroke=\"#C0262D\" stroke-width=\"2\"/>\u003ctext x=\"210\" y=\"70\" font-size=\"12\" font-weight=\"700\">sin agujero\u003c/text>\u003ctext x=\"210\" y=\"88\" font-size=\"11\">tapa la línea\u003c/text>'}\n  ];\n  var bs=$(\"#btSvg\");\n  tabs($(\"#btTabs\"),$(\"#btPanel\"),B,function(it){bs.innerHTML='\u003crect width=\"400\" height=\"170\" fill=\"var(--card)\"/>'+it.d+AX+'\u003crect x=\"176\" y=\"50\" width=\"16\" height=\"12\" fill=\"var(--card)\" stroke=\"var(--ink2)\" stroke-dasharray=\"3 2\"/>\u003ctext x=\"226\" y=\"35\" font-size=\"10\" style=\"fill:var(--ink2)\">agujero del espárrago (discontinuo)\u003c/text>';$(\"#btPanel\").innerHTML='\u003ch3>'+it.h+'\u003c/h3>\u003cp>'+it.p+'\u003c/p>'});\n\n  /* ---- apriete en cruz ---- */\n  var ORD={4:[1,3,2,4],8:[1,5,3,7,2,6,4,8],12:[1,5,9,3,7,11,2,6,10,4,8,12]};\n  var nb=$(\"#nb\"),svg=$(\"#cruzSvg\"),out=$(\"#cruzOut\"),step=0;\n  function draw(){\n    var n=+nb.value,o=ORD[n],h='\u003ccircle cx=\"130\" cy=\"130\" r=\"115\" fill=\"var(--steel-soft)\" stroke=\"var(--steel)\" stroke-width=\"2\"/>\u003ccircle cx=\"130\" cy=\"130\" r=\"58\" fill=\"var(--card)\" stroke=\"var(--steel)\" stroke-width=\"2\"/>\u003cline x1=\"130\" y1=\"5\" x2=\"130\" y2=\"255\" stroke=\"var(--ink2)\" stroke-dasharray=\"8 4\"/>\u003cline x1=\"5\" y1=\"130\" x2=\"255\" y2=\"130\" stroke=\"var(--ink2)\" stroke-dasharray=\"8 4\"/>';\n    var pos={},line=\"\";\n    o.forEach(function(lab,i){var a=(-90+180/n+i*360/n)*Math.PI/180;pos[lab]=[130+88*Math.cos(a),130+88*Math.sin(a)]});\n    for(var s=1;s\u003cstep;s++){var p1=pos[s],p2=pos[s+1];line+='\u003cline x1=\"'+p1[0]+'\" y1=\"'+p1[1]+'\" x2=\"'+p2[0]+'\" y2=\"'+p2[1]+'\" stroke=\"var(--molten)\" stroke-width=\"2\" stroke-dasharray=\"5 3\" opacity=\".7\"/>'}\n    o.forEach(function(lab){var p=pos[lab],done=lab\u003c=step,cur=lab===step;h+='\u003ccircle class=\"bolt\" cx=\"'+p[0]+'\" cy=\"'+p[1]+'\" r=\"15\" fill=\"'+(cur?\"var(--molten)\":done?\"var(--gas)\":\"var(--card)\")+'\" stroke=\"var(--ink)\" stroke-width=\"1.5\"/>'+(done?'\u003ctext x=\"'+p[0]+'\" y=\"'+(p[1]+5)+'\" text-anchor=\"middle\" font-size=\"14\" font-weight=\"700\" style=\"fill:#fff\">'+lab+'\u003c/text>':'')});\n    svg.innerHTML=h+line;\n    out.className=\"out\"+(step===n?\" ok\":\"\");\n    out.innerHTML=step===0?'Pulsa \u003cb>Siguiente\u003c/b> para ver qué espárrago va primero.':step===n?'\u003cb>Vuelta completa.\u003c/b> Ahora se repite la misma cruz en la siguiente pasada: mano → 30 % → 70 % → 100 %.':'Espárrago \u003cb>'+step+'\u003c/b>. '+(step%2===0?'Es el de \u003cb>enfrente\u003c/b> del anterior.':'Saltamos un cuarto de vuelta.');\n    $(\"#cNext\").disabled=step===n;\n  }\n  $(\"#cNext\").onclick=function(){step++;draw()};$(\"#cReset\").onclick=function(){step=0;draw()};nb.onchange=function(){step=0;draw()};draw();\n\n  /* ---- válvulas ---- */\n  var BT='\u003cpath d=\"M10 20 L90 60 V20 L10 60 Z\" fill=\"none\" stroke=\"var(--ink)\" stroke-width=\"3\"/>';\n  var V=[\n    {t:\"Compuerta\",c:\"var(--arc)\",img:\"compuerta\",en:\"gate valve\",s:BT,f:\"Aislamiento: todo o nada.\",p:\"Una \u003cb>compuerta\u003c/b> (una cuña) sube y baja \u003cb>perpendicular al flujo\u003c/b>, movida por un husillo y un volante. Abierta, casi no frena el fluido. \u003cb>No sirve para regular\u003c/b>: a medio abrir vibra y se desgasta. Es lenta: muchas vueltas de volante.\"},\n    {t:\"Globo\",c:\"var(--gas)\",img:\"globo\",en:\"globe valve\",s:BT+'\u003ccircle cx=\"50\" cy=\"40\" r=\"8\" fill=\"var(--ink)\"/>',f:\"Regulación.\",p:\"Un \u003cb>disco\u003c/b> baja contra un \u003cb>asiento\u003c/b>. El fluido hace una «S» dentro. Frena más el fluido, pero \u003cb>regula muy bien\u003c/b> el caudal. Lleva \u003cb>flecha\u003c/b> de sentido.\"},\n    {t:\"Retención\",c:\"var(--molten)\",img:\"check\",en:\"check valve\",s:'\u003cpath d=\"M15 15 V65 L85 15 V65\" fill=\"none\" stroke=\"var(--ink)\" stroke-width=\"3\"/>\u003cpath d=\"M70 26 L85 15 L80 32\" fill=\"none\" stroke=\"var(--ink)\" stroke-width=\"3\"/>',f:\"Un solo sentido.\",p:\"Se abre sola con el fluido y se \u003cb>cierra sola\u003c/b> si el fluido intenta volver. Por dentro puede llevar una \u003cb>clapeta\u003c/b>, un disco, una bola o un pistón. Protege bombas y equipos. Lleva \u003cb>flecha\u003c/b>. Si se cierra de golpe produce el \u003cb>golpe de ariete\u003c/b>.\"},\n    {t:\"Bola\",c:\"var(--warn)\",img:\"bola\",en:\"ball valve\",s:BT+'\u003ccircle cx=\"50\" cy=\"40\" r=\"8\" fill=\"var(--card)\" stroke=\"var(--ink)\" stroke-width=\"3\"/>',f:\"Aislamiento rápido (¼ de vuelta).\",p:\"Una \u003cb>bola con un agujero\u003c/b>. Con \u003cb>un cuarto de vuelta\u003c/b> de la palanca, el agujero se pone en línea (abierta) o atravesado (cerrada). Rápida y estanca. La de \u003cb>macho\u003c/b> (plug valve) es parecida, con un cono o cilindro agujereado.\"},\n    {t:\"Mariposa\",c:\"var(--steel)\",img:\"mariposa\",en:\"butterfly valve\",s:'\u003cline x1=\"25\" y1=\"15\" x2=\"25\" y2=\"65\" stroke=\"var(--ink)\" stroke-width=\"3\"/>\u003cline x1=\"75\" y1=\"15\" x2=\"75\" y2=\"65\" stroke=\"var(--ink)\" stroke-width=\"3\"/>\u003cline x1=\"25\" y1=\"65\" x2=\"75\" y2=\"15\" stroke=\"var(--ink)\" stroke-width=\"3\"/>\u003ccircle cx=\"50\" cy=\"40\" r=\"7\" fill=\"var(--ink)\"/>',f:\"Aislamiento y algo de regulación.\",p:\"Un \u003cb>disco\u003c/b> gira sobre un eje dentro del tubo: de canto, abierta; de frente, cerrada. Cuarto de vuelta. Es \u003cb>corta y ligera\u003c/b>: la reina de los \u003cb>diámetros grandes\u003c/b> (agua, refrigeración).\"},\n    {t:\"Diafragma\",c:\"var(--gas)\",img:null,en:\"diaphragm valve\",s:BT+'\u003cpath d=\"M30 30 Q50 10 70 30\" fill=\"none\" stroke=\"var(--ink)\" stroke-width=\"3\"/>',f:\"Fluidos sucios, corrosivos o alimentarios.\",p:\"Una \u003cb>membrana de goma\u003c/b> se aprieta contra un resalte y corta el paso. El mecanismo \u003cb>no toca el fluido\u003c/b>: va bien con ácidos, lodos o en industria alimentaria y farmacéutica. Regula y corta.\"},\n    {t:\"Seguridad\",c:\"#C0262D\",img:\"seguridad\",en:\"safety / relief valve\",s:'\u003cpath d=\"M50 40 L20 70 H80 Z M50 40 L80 25 V55 Z\" fill=\"none\" stroke=\"var(--ink)\" stroke-width=\"3\"/>\u003cpath d=\"M50 40 V8 M42 30 l16 -5 M42 22 l16 -5 M42 14 l16 -5\" stroke=\"var(--ink)\" stroke-width=\"2.5\" fill=\"none\"/>',f:\"Protección contra sobrepresión.\",p:\"Un \u003cb>muelle\u003c/b> la mantiene cerrada. Si la presión pasa del valor de \u003cb>tarado\u003c/b>, se abre sola y suelta fluido hasta que baja. Es la última protección de un depósito o una caldera. \u003cb>Va precintada: no se toca ni se tapa su salida\u003c/b>.\"}\n  ];\n  var vp=$(\"#vPanel\");\n  tabs($(\"#vTabs\"),vp,V,function(it){\n    var im=it.img?'\u003cimg src=\"'+$(\"#V-\"+it.img).getAttribute(\"src\")+'\" alt=\"Foto y corte de una válvula de '+it.t.toLowerCase()+'.\">':'\u003cp class=\"muted small\">Sin foto en los documentos del módulo.\u003c/p>';\n    vp.innerHTML='\u003ch3>Válvula de '+it.t.toLowerCase()+' \u003cspan class=\"muted small\">('+it.en+')\u003c/span>\u003c/h3>\u003cdiv class=\"vpic\">\u003csvg viewBox=\"0 0 100 80\" role=\"img\" aria-label=\"Símbolo de la válvula de '+it.t.toLowerCase()+'\">'+it.s+'\u003c/svg>\u003cdiv>\u003cp style=\"margin:0\">\u003cb>'+it.f+'\u003c/b>\u003c/p>\u003cp style=\"margin:.3rem 0 0\">'+it.p+'\u003c/p>\u003c/div>\u003c/div>'+im;\n  });\n})();\n\u003c/script>\n\u003c/body>\n\u003c/html>\n","TUB_4_Isometricos.html":"\u003c!DOCTYPE html>\n\u003chtml lang=\"es\">\n\u003chead>\n\u003cmeta charset=\"utf-8\">\n\u003cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n\u003ctitle>Tubería · Bloque 4 · Leer un isométrico\u003c/title>\n\u003clink rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n\u003clink rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n\u003clink href=\"https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&family=Barlow+Condensed:wght@600;700&display=swap\" rel=\"stylesheet\">\n\u003cstyle>\n:root{\n  --paper:#F1F3F6; --card:#FFFFFF; --ink:#141C28; --ink2:#465364; --line:#D3D9E0;\n  --arc:#2450E6; --arc-soft:#E3E9FF; --on-arc:#FFFFFF;\n  --molten:#C74A08; --molten-soft:#FFE8DA;\n  --gas:#0B857B; --gas-soft:#D9F2EF;\n  --steel:#5C6B7C; --steel-soft:#E6EAEF;\n  --warn:#7A4A00; --warn-soft:#FFF1CF;\n  --fig-bg:#FFFFFF;\n  box-sizing:border-box;\n  padding-top:env(safe-area-inset-top,0px);\n  padding-bottom:env(safe-area-inset-bottom,0px);\n}\n@media (prefers-color-scheme:dark){\n  :root:not([data-theme=\"light\"]){\n    --paper:#0E141B; --card:#161E29; --ink:#E8EEF5; --ink2:#A2AFBE; --line:#2A3543;\n    --arc:#8FA8FF; --arc-soft:#1A2544; --on-arc:#0E141B;\n    --molten:#FF9159; --molten-soft:#33200F;\n    --gas:#45D0C3; --gas-soft:#10312E;\n    --steel:#9AA8B8; --steel-soft:#222C38;\n    --warn:#FFC766; --warn-soft:#33260A;\n  }\n}\n:root[data-theme=\"dark\"]{\n  --paper:#0E141B; --card:#161E29; --ink:#E8EEF5; --ink2:#A2AFBE; --line:#2A3543;\n  --arc:#8FA8FF; --arc-soft:#1A2544; --on-arc:#0E141B;\n  --molten:#FF9159; --molten-soft:#33200F;\n  --gas:#45D0C3; --gas-soft:#10312E;\n  --steel:#9AA8B8; --steel-soft:#222C38;\n  --warn:#FFC766; --warn-soft:#33260A;\n}\nhtml{scroll-padding-top:calc(env(safe-area-inset-top,0px) + 4.2rem);scroll-behavior:smooth;-webkit-text-size-adjust:100%}\n*,*::before,*::after{box-sizing:border-box}\nbody{margin:0;background:var(--paper);color:var(--ink);font:400 1.0625rem/1.62 \"Atkinson Hyperlegible\",system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;overflow-x:hidden}\nimg,svg{max-width:100%}\nh1,h2,h3{font-family:\"Barlow Condensed\",\"Arial Narrow\",Impact,sans-serif;font-weight:700;line-height:1.06;margin:0;letter-spacing:.005em}\nh2{font-size:clamp(1.9rem,6.4vw,2.6rem)}\nh3{font-size:1.4rem;margin:1.6rem 0 .5rem}\np{margin:.7rem 0}\na{color:var(--arc)}\n:focus-visible{outline:3px solid var(--arc);outline-offset:2px;border-radius:4px}\n.wrap{max-width:46rem;margin-inline:auto;padding-inline:1.1rem}\nsection{padding-block:2.6rem 1rem;border-top:1px solid var(--line)}\nsection:first-of-type{border-top:0}\n.lead{font-size:1.18rem;line-height:1.5;color:var(--ink);margin-top:.9rem}\n.muted{color:var(--ink2)}\n.small{font-size:.9rem}\n\n/* barra superior */\n.topnav{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:var(--card);border-bottom:1px solid var(--line)}\n.topnav .bar{height:3px;background:var(--arc);width:0;transition:width .1s linear}\n.chips{display:flex;gap:.4rem;overflow-x:auto;padding:.55rem 1.1rem;scrollbar-width:none;-webkit-overflow-scrolling:touch}\n.chips::-webkit-scrollbar{display:none}\n.chips a{flex:none;text-decoration:none;color:var(--ink2);font-size:.92rem;padding:.3rem .75rem;border-radius:99px;border:1px solid var(--line);white-space:nowrap}\n.chips a