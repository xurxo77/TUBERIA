n.lb .top{display:flex;justify-content:space-between;align-items:center;padding:calc(.6rem + env(safe-area-inset-top,0px)) 1rem .6rem;color:#fff;font-size:.9rem}\n.lb .top button{font:inherit;font-weight:700;background:#fff;color:#111;border:0;border-radius:99px;padding:.45rem 1rem;min-height:2.5rem;cursor:pointer}\n.lb .pan{flex:1;overflow:auto;-webkit-overflow-scrolling:touch;padding:0 0 calc(1rem + env(safe-area-inset-bottom,0px))}\n.lb .pan img{display:block;width:max(100%,900px);max-width:none;background:#fff;margin:0 auto}\n@media (prefers-reduced-motion:reduce){\n  html{scroll-behavior:auto}\n  *,*::before,*::after{animation:none!important;transition:none!important}\n}\n\n/* ===== Añadidos serie TIG ===== */\n/* navegación entre bloques */\n.blocknav{display:flex;gap:.35rem;overflow-x:auto;padding:.5rem 1.1rem 0;scrollbar-width:none}\n.blocknav::-webkit-scrollbar{display:none}\n.blocknav a{flex:none;text-decoration:none;font-size:.8rem;font-weight:700;color:var(--ink2);padding:.15rem .6rem;border-radius:6px;background:var(--steel-soft)}\n.blocknav a.cur{background:var(--ink);color:var(--card)}\n.nextblock{display:flex;justify-content:space-between;gap:.6rem;flex-wrap:wrap;margin:2rem 0 0}\n.nextblock a{flex:1 1 14rem;display:block;text-decoration:none;padding:.9rem 1rem;border-radius:10px;border:1.5px solid var(--line);background:var(--card);color:var(--ink)}\n.nextblock a small{display:block;color:var(--ink2);font-size:.85rem}\n.nextblock a b{font:700 1.35rem \"Barlow Condensed\",sans-serif;color:var(--arc)}\n.nextblock a.next{text-align:right;border-color:var(--arc)}\n/* \"En 10 segundos\" y \"Lo que tienes que recordar\" */\n.en10{margin:1rem 0 1.1rem;padding:.85rem 1rem;border-radius:10px;background:var(--ink);color:var(--card);font-size:1.12rem;line-height:1.45}\n.en10::before{content:\"EN 10 SEGUNDOS\";display:block;font:700 .82rem \"Barlow Condensed\",sans-serif;letter-spacing:.08em;opacity:.7;margin-bottom:.2rem}\n.en10 b{color:inherit;text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:3px}\n.recuerda{margin:1.4rem 0 .4rem;padding:.8rem 1rem;border:2px solid var(--c,var(--arc));border-radius:10px;background:var(--card)}\n.recuerda h4{margin:0 0 .3rem;font:700 1.15rem \"Barlow Condensed\",sans-serif;color:var(--c,var(--arc))}\n.recuerda ul{margin:.2rem 0 0;padding-left:1.15rem}.recuerda li{margin:.25rem 0}\n.callout.danger{border-left-color:#C0262D;background:#FDE4E4}.callout.danger h4{color:#A1171E}\n:root[data-theme=\"dark\"] .callout.danger{background:#3A1214}:root[data-theme=\"dark\"] .callout.danger h4{color:#FF8A8F}\n@media (prefers-color-scheme:dark){:root:not([data-theme=\"light\"]) .callout.danger{background:#3A1214}:root:not([data-theme=\"light\"]) .callout.danger h4{color:#FF8A8F}}\n.analogy{display:flex;gap:.7rem;align-items:flex-start;margin:1rem 0;padding:.75rem .9rem;border-radius:10px;background:var(--steel-soft)}\n.analogy .ico{flex:none;width:2.2rem;height:2.2rem;display:grid;place-items:center;border-radius:50%;background:var(--card);font:700 1.2rem \"Barlow Condensed\",sans-serif;color:var(--arc)}\n.analogy p{margin:0}\n/* tarjetas de \"qué elegir\" */\n.pick{display:grid;gap:.5rem;grid-template-columns:repeat(auto-fit,minmax(9.5rem,1fr));margin:1rem 0 .6rem}\n.pick button{font:inherit;font-weight:700;text-align:left;padding:.7rem .85rem;border-radius:10px;border:1.5px solid var(--line);background:var(--card);color:var(--ink);cursor:pointer;min-height:3rem}\n.pick button[aria-pressed=\"true\"]{border-color:var(--arc);background:var(--arc-soft);box-shadow:inset 0 0 0 1px var(--arc)}\n.pick button small{display:block;font-weight:400;color:var(--ink2);font-size:.85rem}\n.result{margin:.4rem 0 1rem;padding:.9rem 1rem;border-radius:10px;background:var(--card);border:1px solid var(--line);border-left:6px solid var(--arc)}\n.result h3{margin:.1rem 0 .4rem;color:var(--arc)}\n.result dl{display:grid;grid-template-columns:auto 1fr;gap:.25rem .8rem;margin:.3rem 0}\n.result dt{font-weight:700}.result dd{margin:0;color:var(--ink)}\n.result .warn{margin:.6rem 0 0;font-size:.95rem;color:var(--warn)}\n/* despiece interactivo */\n.explode{margin:1.2rem 0;background:var(--card);border:1px solid var(--line);border-radius:10px;overflow:hidden}\n.explode svg{display:block;width:100%;height:auto}\n.explode .part{cursor:pointer;transition:opacity .2s}\n.explode .part:focus{outline:none}\n.explode.sel .part{opacity:.3}.explode.sel .part.on{opacity:1}\n.explode .part.on .hl{stroke:var(--molten);stroke-width:3}\n.explode .info{padding:.8rem 1rem 1rem;border-top:1px solid var(--line);min-height:6.5rem}\n.explode .info h3{margin:.1rem 0 .3rem;color:var(--molten)}\n.explode .info p{margin:.3rem 0}\n/* fichas de defecto */\n.defect{margin:1.4rem 0;border:1px solid var(--line);border-radius:12px;background:var(--card);overflow:hidden}\n.defect>header{display:flex;gap:.7rem;align-items:center;padding:.8rem 1rem;background:var(--steel-soft)}\n.defect>header .n{flex:none;width:2.3rem;height:2.3rem;display:grid;place-items:center;border-radius:50%;background:#C0262D;color:#fff;font:700 1.2rem \"Barlow Condensed\",sans-serif}\n.defect>header h3{margin:0;font-size:1.5rem}\n.defect>header .tag{margin-left:auto;font-size:.75rem;font-weight:700;padding:.15rem .5rem;border-radius:99px;background:var(--card);color:var(--ink2);white-space:nowrap}\n.defect .pic{background:var(--paper);padding:.6rem;display:grid;place-items:center;border-bottom:1px solid var(--line)}\n.defect .pic svg{width:100%;max-width:24rem;height:auto}\n.defect .pic img{max-width:100%;height:auto;border-radius:6px}\n.defect .grid4{display:grid;gap:0}\n@media(min-width:620px){.defect .grid4{grid-template-columns:1fr 1fr}}\n.defect .grid4>div{padding:.7rem 1rem .8rem;border-top:1px solid var(--line)}\n.defect .grid4 h4{margin:0 0 .25rem;font:700 1.08rem \"Barlow Condensed\",sans-serif;letter-spacing:.02em;text-transform:uppercase}\n.defect .grid4 ul{margin:.1rem 0 0;padding-left:1.1rem}.defect .grid4 li{margin:.2rem 0}\n.defect .see h4{color:var(--arc)}.defect .why h4{color:var(--molten)}.defect .fix h4{color:var(--gas)}.defect .avoid h4{color:var(--warn)}\n/* diagnóstico */\n.diag{margin:1.2rem 0;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:.8rem 1rem 1rem}\n.diag ol{margin:.5rem 0 0;padding-left:1.3rem}.diag li{margin:.45rem 0}\n.diag .go{font-weight:700}\n/* lista de comprobación */\n.check{list-style:none;padding:0;margin:1rem 0;display:grid;gap:.45rem}\n.check label{display:flex;gap:.7rem;align-items:flex-start;padding:.65rem .85rem;border:1px solid var(--line);border-radius:8px;background:var(--card);cursor:pointer}\n.check input{flex:none;width:1.35rem;height:1.35rem;margin:.1rem 0 0;accent-color:var(--gas)}\n.check label:has(input:checked){background:var(--gas-soft);border-color:var(--gas)}\n.check-status{font-weight:700;color:var(--gas)}\n/* quiz: barra de resultado e imagen */\n.meter{height:.7rem;border-radius:99px;background:var(--steel-soft);overflow:hidden;margin:.4rem 0}\n.meter span{display:block;height:100%;background:var(--gas)}\n.qfig{margin:0 0 .8rem;padding:.4rem;background:#fff;border:1px solid var(--line);border-radius:8px;text-align:center}\n.qfig img,.qfig svg{max-width:100%;max-height:15rem;height:auto}\n/* tabla de colores */\n.sw{display:inline-block;width:1.1rem;height:1.1rem;border-radius:3px;vertical-align:-.2rem;margin-right:.35rem;border:1px solid rgba(0,0,0,.3)}\n.big-num{font:700 2.4rem/1 \"Barlow Condensed\",sans-serif;color:var(--arc)}\n\n/* ===== Añadidos serie MONTAJE ===== */\n/* portada con dibujo en vez de foto */\n.hero svg.bg{display:block;width:100%;height:min(62vh,420px)}\n/* calculadoras y deslizadores */\n.calc{margin:1.2rem 0;background:var(--card);border:1px solid var(--line);border-radius:10px;padding:.9rem 1rem 1rem}\n.calc h3{margin:.1rem 0 .5rem}\n.calc .row{display:flex;flex-wrap:wrap;gap:.6rem 1rem;align-items:end;margin:.4rem 0}\n.calc label{display:flex;flex-direction:column;gap:.25rem;font-size:.92rem;font-weight:700;color:var(--ink2)}\n.calc input[type=number]{font:inherit;font-size:1.1rem;width:7.5rem;padding:.45rem .6rem;border-radius:8px;border:1.5px solid var(--line);background:var(--paper);color:var(--ink)}\n.calc input[type=range]{width:100%;accent-color:var(--arc);min-height:2rem}\n.calc .out{margin:.7rem 0 0;padding:.7rem .9rem;border-radius:8px;background:var(--steel-soft)}\n.calc .out.ok{background:var(--gas-soft)}.calc .out.bad{background:var(--molten-soft)}\n.calc .out b.big{font:700 1.7rem \"Barlow Condensed\",sans-serif}\n.calc svg{display:block;width:100%;max-width:26rem;margin:.4rem auto 0;height:auto}\n/* buscador de palabras */\n.gloss input{font:inherit;width:100%;padding:.6rem .8rem;border-radius:8px;border:1.5px solid var(--line);background:var(--paper);color:var(--ink)}\n.gloss table{margin-top:.6rem}\n.gloss td:first-child{width:45%}\n/* paso a paso con dibujo */\n.stepper{margin:1.3rem 0;background:var(--card);border:1px solid var(--line);border-radius:10px;overflow:hidden}\n.stepper svg{display:block;width:100%;height:auto;background:var(--steel-soft)}\n.stepper .ctrl{display:flex;justify-content:space-between;align-items:center;gap:.5rem;padding:.6rem .9rem;border-top:1px solid var(--line)}\n.stepper .ctrl span{font-weight:700;color:var(--ink2)}\n.stepper .txt{padding:.1rem 1.1rem 1rem}\n.stepper .txt h3{margin:.7rem 0 .3rem;color:var(--arc)}\n.btn.ghost{background:var(--paper);color:var(--ink);border:1.5px solid var(--line)}\n.btn:disabled{opacity:.4;cursor:default}\n.st{transition:opacity .35s}.st.hide{opacity:0}.st.new .hl{filter:drop-shadow(0 0 4px #FF9A2E)}\n\n\u003c/style>\n\u003cstyle>\n.calc select{font:inherit;font-size:1.02rem;padding:.45rem .6rem;border-radius:8px;border:1.5px solid var(--line);background:var(--paper);color:var(--ink)}\n.formula{margin:1rem 0;padding:.8rem 1rem;border-radius:10px;background:var(--card);border:2px solid var(--molten);text-align:center;font:700 1.45rem/1.3 \"Barlow Condensed\",sans-serif}\n.formula small{display:block;font:400 .9rem \"Atkinson Hyperlegible\",sans-serif;color:var(--ink2)}\n.wl{display:grid;grid-template-columns:1fr 1fr auto;gap:.5rem;align-items:end;margin:.35rem 0}\n.wl input{width:100%!important}\n.wl button{min-height:2.4rem}\n\u003c/style>\n\u003c/head>\n\u003cbody>\n\u003cheader class=\"topnav\" id=\"topnav\">\n  \u003cdiv class=\"bar\" id=\"bar\">\u003c/div>\n  \u003cnav class=\"blocknav\" aria-label=\"Bloques de tubería\">\n    \u003ca href=\"TUB_0_Portada.html\">Portada\u003c/a>\n    \u003ca href=\"TUB_1_Tuberia.html\">1 La tubería\u003c/a>\n    \u003ca href=\"TUB_2_Accesorios.html\">2 Accesorios\u003c/a>\n    \u003ca href=\"TUB_3_Bridas_Valvulas.html\">3 Bridas y válvulas\u003c/a>\n    \u003ca href=\"TUB_4_Isometricos.html\">4 Isométricos\u003c/a>\n    \u003ca href=\"TUB_5_Taller.html\" class=\"cur\" aria-current=\"page\">5 Al taller\u003c/a>\n  \u003c/nav>\n  \u003cnav class=\"chips\" id=\"chips\" aria-label=\"Secciones\">\n    \u003ca href=\"#inicio\">Inicio\u003c/a>\n    \u003ca href=\"#avance\">El avance\u003c/a>\n    \u003ca href=\"#carrete\">El carrete\u003c/a>\n    \u003ca href=\"#bayoneta\">Bayonetas\u003c/a>\n    \u003ca href=\"#coste\">Pulgadas-diámetro\u003c/a>\n    \u003ca href=\"#orden\">Orden de montaje\u003c/a>\n    \u003ca href=\"#brida\">Colocar una brida\u003c/a>\n    \u003ca href=\"#prueba\">Prueba y traceado\u003c/a>\n    \u003ca href=\"#ideas\">Ideas clave\u003c/a>\n  \u003c/nav>\n\u003c/header>\n\n\u003cdiv class=\"hero\" id=\"inicio\">\n  \u003csvg class=\"bg\" viewBox=\"0 0 800 420\" preserveAspectRatio=\"xMidYMid slice\" role=\"img\" aria-label=\"Dibujo: tubería con dos codos que forman una bayoneta; marcados el avance de cada codo y el carrete entre ellos.\">\n    \u003crect width=\"800\" height=\"420\" fill=\"#16314F\"/>\n    \u003cpath d=\"M-20 320 H250 A90 90 0 0 0 313 294 L487 120 A90 90 0 0 1 550 94 H820\" fill=\"none\" stroke=\"#9FB3C8\" stroke-width=\"44\"/>\n    \u003cg stroke=\"#FFB27A\" stroke-width=\"6\">\u003cline x1=\"250\" y1=\"296\" x2=\"250\" y2=\"344\"/>\u003cline x1=\"296\" y1=\"277\" x2=\"330\" y2=\"311\"/>\u003cline x1=\"470\" y1=\"103\" x2=\"504\" y2=\"137\"/>\u003cline x1=\"550\" y1=\"70\" x2=\"550\" y2=\"118\"/>\u003c/g>\n    \u003cg stroke=\"#E8EEF5\" stroke-width=\"2\" stroke-dasharray=\"8 6\">\u003cline x1=\"250\" y1=\"380\" x2=\"380\" y2=\"380\"/>\u003cline x1=\"380\" y1=\"390\" x2=\"380\" y2=\"40\"/>\u003cline x1=\"380\" y1=\"40\" x2=\"550\" y2=\"40\"/>\u003c/g>\n    \u003cg font-size=\"20\" font-weight=\"700\">\u003ctext x=\"270\" y=\"405\" style=\"fill:#FFB27A\">avance\u003c/text>\u003ctext x=\"400\" y=\"230\" style=\"fill:#FFB27A\">carrete\u003c/text>\u003c/g>\n  \u003c/svg>\n  \u003cdiv class=\"txt wrap\">\n    \u003ch1>Bloque 5. Del plano al taller\u003c/h1>\n    \u003cp class=\"sub\">Las cuentas para cortar el tubo a la primera y los trucos para montarlo derecho.\u003c/p>\n    \u003cp class=\"ctx\">CFGM Soldadura y Calderería · Montaje de tubería\u003c/p>\n    \u003cp class=\"ctx\" style=\"margin-top:.3rem\">\u003cb>Autor: Xurxo\u003c/b>\u003c/p>\n  \u003c/div>\n\u003c/div>\n\n\u003cmain class=\"wrap\">\n\n\u003csection id=\"intro\">\n  \u003cp class=\"lead\">Ya sabes leer un isométrico. Ahora hay que \u003cb>cortar los tubos\u003c/b>. Las cotas van de eje a eje, pero tú cortas tubo. La diferencia está en lo que \u003cb>ocupa cada accesorio\u003c/b> y en la \u003cb>separación\u003c/b> que dejas para soldar. Con dos o tres cuentas sencillas, todo encaja.\u003c/p>\n  \u003col class=\"chain\" aria-label=\"Pasos para sacar un carrete\">\n    \u003cli>\u003ca href=\"#avance\">\u003cb>1\u003c/b>Leer la cota\u003c/a>\u003c/li>\n    \u003cli>\u003ca href=\"#avance\">\u003cb>2\u003c/b>Restar avances\u003c/a>\u003c/li>\n    \u003cli>\u003ca href=\"#carrete\">\u003cb>3\u003c/b>Restar separa&shy;ciones\u003c/a>\u003c/li>\n    \u003cli>\u003ca href=\"#carrete\">\u003cb>4\u003c/b>Cortar y biselar\u003c/a>\u003c/li>\n    \u003cli>\u003ca href=\"#brida\">\u003cb>5\u003c/b>Presen&shy;tar\u003c/a>\u003c/li>\n    \u003cli>\u003ca href=\"#orden\">\u003cb>6\u003c/b>Puntear y compro&shy;bar\u003c/a>\u003c/li>\n    \u003cli>\u003ca href=\"#orden\">\u003cb>7\u003c/b>Soldar\u003c/a>\u003c/li>\n  \u003c/ol>\n  \u003ch3>Al terminar sabrás\u003c/h3>\n  \u003cul class=\"list\">\n    \u003cli>calcular el \u003cb>avance\u003c/b> de un codo de cualquier ángulo;\u003c/li>\n    \u003cli>calcular el largo de un \u003cb>carrete\u003c/b> a partir de la cota;\u003c/li>\n    \u003cli>resolver una \u003cb>bayoneta\u003c/b> con Pitágoras;\u003c/li>\n    \u003cli>calcular las \u003cb>pulgadas-diámetro\u003c/b> de soldadura de un isométrico y su coste;\u003c/li>\n    \u003cli>montar un isométrico en buen orden y colocar una \u003cb>brida a nivel\u003c/b>.\u003c/li>\n  \u003c/ul>\n  \u003cp class=\"muted small\">Necesitas una calculadora con las teclas \u003cb>tan\u003c/b> y \u003cb>tan⁻¹\u003c/b>, o el móvil en modo científico.\u003c/p>\n\u003c/section>\n\n\u003c!-- ============ AVANCE ============ -->\n\u003csection id=\"avance\">\n  \u003ch2>El avance de un codo\u003c/h2>\n  \u003cdiv class=\"en10\">El \u003cb>avance\u003c/b> es la distancia desde la \u003cb>cara del codo\u003c/b> hasta el \u003cb>punto donde se cruzan los ejes\u003c/b>. Es lo que el codo «se come» de la cota. En un codo de 90° de radio largo, el avance es igual al radio: \u003cb>1,5 × NPS\u003c/b>.\u003c/div>\n  \u003cfigure>\n    \u003cdiv class=\"imgbox zoomable\">\u003cimg id=\"f-av\" src=\"data:image/jpeg;base64,\" alt=\"Codo de 60 grados y codo de 90 grados con el avance marcado: la distancia desde la cara del codo hasta el cruce de los ejes. Fórmula: avance igual a 1,5 por NPS por la tangente de alfa medios.\">\u003c/div>\n    \u003cfigcaption>\u003cb>Fuente: «Manual práctico del tubero», CIFO Tarragona, pág. 17\u003c/b> (con anotaciones de la presentación del módulo). Cada codo tiene \u003cb>dos avances\u003c/b>, uno por cada lado.\u003c/figcaption>\n  \u003c/figure>\n  \u003cdiv class=\"formula\">Avance = 1,5 × NPS × 25,4 × tan(α / 2)\u003csmall>α = ángulo del codo · NPS en pulgadas · resultado en mm · solo codos BW de radio largo, NPS ¾\" o más\u003c/small>\u003c/div>\n  \u003cdiv class=\"calc\" id=\"avCalc\">\n    \u003ch3>Calcula el avance\u003c/h3>\n    \u003cdiv class=\"row\">\n      \u003clabel for=\"aN\">NPS (\")\u003cinput id=\"aN\" type=\"number\" min=\"0.75\" step=\"0.25\" value=\"4\">\u003c/label>\n      \u003clabel for=\"aA\">Ángulo del codo (°)\u003cinput id=\"aA\" type=\"number\" min=\"1\" max=\"90\" step=\"1\" value=\"60\">\u003c/label>\n    \u003c/div>\n    \u003cinput id=\"aR\" type=\"range\" min=\"5\" max=\"90\" step=\"1\" value=\"60\" aria-label=\"Ángulo del codo\">\n    \u003csvg viewBox=\"0 0 300 200\" role=\"img\" aria-label=\"Codo del ángulo elegido con su avance marcado.\" id=\"avSvg\">\u003c/svg>\n    \u003cdiv class=\"out\" id=\"avOut\">\u003c/div>\n  \u003c/div>\n  \u003cdiv class=\"scroll\">\u003ctable>\n    \u003cthead>\u003ctr>\u003cth>Codo LR\u003c/th>\u003cth>Avance rápido\u003c/th>\u003cth>Ejemplo 4\"\u003c/th>\u003c/tr>\u003c/thead>\n    \u003ctbody>\n      \u003ctr>\u003ctd>90°\u003c/td>\u003ctd>≈ 38 × NPS (mm)\u003c/td>\u003ctd>152 mm\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>45°\u003c/td>\u003ctd>≈ 16 × NPS (mm)\u003c/td>\u003ctd>63 mm\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>60°\u003c/td>\u003ctd>≈ 22 × NPS (mm)\u003c/td>\u003ctd>88 mm\u003c/td>\u003c/tr>\n    \u003c/tbody>\n  \u003c/table>\u003c/div>\n  \u003cdiv class=\"callout hot\">\u003ch4>Solo codos BW\u003c/h4>\u003cp>Un codo de enchufe o roscado \u003cb>no se corta\u003c/b>: perderías el enchufe o la rosca. Por eso los SW y TH solo existen a 90° y 45°, y su medida se saca del catálogo (distancia del centro al fondo del enchufe).\u003c/p>\u003c/div>\n  \u003cdiv class=\"recuerda\">\u003ch4>Lo que tienes que recordar\u003c/h4>\u003cul>\n    \u003cli>Avance = de la cara del codo al cruce de ejes.\u003c/li>\n    \u003cli>90° LR: 1,5 × NPS × 25,4 ≈ 38 × NPS mm.\u003c/li>\n    \u003cli>Otro ángulo: × tan(α/2). Solo BW.\u003c/li>\n  \u003c/ul>\u003c/div>\n\u003c/section>\n\n\u003c!-- ============ CARRETE ============ -->\n\u003csection id=\"carrete\" style=\"--c:var(--gas)\">\n  \u003ch2>El carrete: cuánto tubo cortar\u003c/h2>\n  \u003cdiv class=\"en10\">Largo del tubo = \u003cb>cota\u003c/b> − \u003cb>lo que ocupan los accesorios\u003c/b> de cada lado − \u003cb>las separaciones\u003c/b> de soldadura. En tubería BW, lo que ocupa un codo es su \u003cb>avance\u003c/b>.\u003c/div>\n  \u003cdiv class=\"formula\">Tubo = cota − avance₁ − avance₂ − 2 × separación\u003csmall>la separación es la de la raíz de soldadura (en los ejercicios del módulo, «penetración»: 3,25 o 4 mm)\u003c/small>\u003c/div>\n  \u003cdiv class=\"calc\" id=\"caCalc\">\n    \u003ch3>Calcula el carrete\u003c/h3>\n    \u003cdiv class=\"row\">\n      \u003clabel for=\"kC\">Cota entre ejes (mm)\u003cinput id=\"kC\" type=\"number\" min=\"0\" step=\"1\" value=\"1047\">\u003c/label>\n      \u003clabel for=\"kN\">NPS (\")\u003cinput id=\"kN\" type=\"number\" min=\"0.75\" step=\"0.25\" value=\"4\">\u003c/label>\n      \u003clabel for=\"kP\">Separación (mm)\u003cinput id=\"kP\" type=\"number\" min=\"0\" step=\"0.25\" value=\"3.25\">\u003c/label>\n    \u003c/div>\n    \u003cdiv class=\"row\">\n      \u003clabel for=\"k1\">Lado 1\u003cselect id=\"k1\">\u003coption value=\"90\">Codo 90° LR\u003c/option>\u003coption value=\"45\">Codo 45° LR\u003c/option>\u003coption value=\"a\" selected>Codo de otro ángulo\u003c/option>\u003coption value=\"x\">Otra pieza (escribo la medida)\u003c/option>\u003c/select>\u003c/label>\n      \u003clabel for=\"k1v\">Ángulo (°) o medida (mm)\u003cinput id=\"k1v\" type=\"number\" step=\"1\" value=\"80\">\u003c/label>\n    \u003c/div>\n    \u003cdiv class=\"row\">\n      \u003clabel for=\"k2\">Lado 2\u003cselect id=\"k2\">\u003coption value=\"90\">Codo 90° LR\u003c/option>\u003coption value=\"45\">Codo 45° LR\u003c/option>\u003coption value=\"a\" selected>Codo de otro ángulo\u003c/option>\u003coption value=\"x\">Otra pieza (escribo la medida)\u003c/option>\u003c/select>\u003c/label>\n      \u003clabel for=\"k2v\">Ángulo (°) o medida (mm)\u003cinput id=\"k2v\" type=\"number\" step=\"1\" value=\"80\">\u003c/label>\n    \u003c/div>\n    \u003csvg viewBox=\"0 0 320 90\" role=\"img\" aria-label=\"Esquema del carrete entre dos accesorios, con la cota, los avances y las separaciones.\" id=\"caSvg\">\u003c/svg>\n    \u003cdiv class=\"out\" id=\"caOut\">\u003c/div>\n  \u003c/div>\n  \u003cp class=\"muted small\">Los valores de partida son el ejemplo del manual del tubero (pág. 20): tubo de 4\", tramo de 1047 mm entre dos codos de 80° y separación de 3,25 mm. Resultado: unos \u003cb>785 mm\u003c/b> (el manual redondea el avance a 128 mm y da 784).\u003c/p>\n  \u003cdiv class=\"callout shop\">\u003ch4>Para otras piezas, el catálogo\u003c/h4>\u003cp>Para bridas de cuello, tes o reducciones, «lo que ocupa» la pieza viene en el \u003cb>catálogo\u003c/b> (en el de Tubasol, la columna de medida «centro a cara» o «longitud»). En una unión \u003cb>SW\u003c/b>, lo que cuenta es la distancia del eje \u003cb>al fondo del enchufe\u003c/b>, y en vez de la separación se resta la \u003cb>holgura\u003c/b> de dilatación (3 mm en los ejercicios).\u003c/p>\u003c/div>\n  \u003cdiv class=\"callout hot\">\u003ch4>Las soldaduras de campo, más largas\u003c/h4>\u003cp>Si el plano marca una soldadura de campo (FW), ese tubo se deja \u003cb>más largo\u003c/b> (por ejemplo 100 mm) y se corta a medida en la obra. Así se absorben los errores de la obra.\u003c/p>\u003c/div>\n  \u003cdiv class=\"recuerda\" style=\"--c:var(--gas)\">\u003ch4>Lo que tienes que recordar\u003c/h4>\u003cul>\n    \u003cli>Tubo = cota − avances − separaciones.\u003c/li>\n    \u003cli>Las medidas de bridas, tes y reducciones, del catálogo.\u003c/li>\n    \u003cli>En SW: al fondo del enchufe, menos la holgura.\u003c/li>\n  \u003c/ul>\u003c/div>\n\u003c/section>\n\n\u003c!-- ============ BAYONETA ============ -->\n\u003csection id=\"bayoneta\" style=\"--c:var(--molten)\">\n  \u003ch2>Bayonetas: el desvío con dos codos\u003c/h2>\n  \u003cdiv class=\"en10\">Una \u003cb>bayoneta\u003c/b> es un desvío: la tubería se aparta de su eje con \u003cb>dos codos iguales\u003c/b> y sigue paralela. Se resuelve con un \u003cb>triángulo rectángulo\u003c/b>: los catetos son el desplazamiento y el recorrido; la hipotenusa, la cota del tramo inclinado.\u003c/div>\n  \u003cdiv class=\"calc\" id=\"bayCalc\">\n    \u003ch3>Resuelve tu bayoneta\u003c/h3>\n    \u003cdiv class=\"row\">\n      \u003clabel for=\"bD\">Desplazamiento (mm)\u003cinput id=\"bD\" type=\"number\" min=\"1\" step=\"1\" value=\"750\">\u003c/label>\n      \u003clabel for=\"bL\">Recorrido (mm)\u003cinput id=\"bL\" type=\"number\" min=\"1\" step=\"1\" value=\"1300\">\u003c/label>\n      \u003clabel for=\"bN\">NPS (\")\u003cinput id=\"bN\" type=\"number\" min=\"0.75\" step=\"0.25\" value=\"4\">\u003c/label>\n      \u003clabel for=\"bP\">Separación (mm)\u003cinput id=\"bP\" type=\"number\" min=\"0\" step=\"0.25\" value=\"3.25\">\u003c/label>\n    \u003c/div>\n    \u003csvg viewBox=\"0 0 320 220\" role=\"img\" aria-label=\"Triángulo de la bayoneta: desplazamiento, recorrido, hipotenusa y ángulo de los codos.\" id=\"baySvg\">\u003c/svg>\n    \u003cdiv class=\"out\" id=\"bayOut\">\u003c/div>\n  \u003c/div>\n  \u003col class=\"steps\">\n    \u003cli>\u003cspan>\u003cb>Hipotenusa\u003c/b> (Pitágoras): H = √(desplazamiento² + recorrido²). Es la cota de eje a eje del tramo inclinado.\u003c/span>\u003c/li>\n    \u003cli>\u003cspan>\u003cb>Ángulo de los codos\u003c/b>: α = tan⁻¹(desplazamiento ÷ recorrido). Los dos codos son iguales.\u003c/span>\u003c/li>\n    \u003cli>\u003cspan>\u003cb>Avance\u003c/b> de cada codo: 1,5 × NPS × 25,4 × tan(α/2).\u003c/span>\u003c/li>\n    \u003cli>\u003cspan>\u003cb>Carrete\u003c/b> inclinado: H − 2 avances − 2 separaciones.\u003c/span>\u003c/li>\n  \u003c/ol>\n  \u003cdiv class=\"callout key\">\u003ch4>¿De pared o de suelo?\u003c/h4>\u003cp>En el isométrico, el \u003cb>triángulo rayado\u003c/b> te dice en qué plano está la bayoneta (Bloque 4). Si el rayado es vertical, el desvío sube o baja (de pared); si es horizontal, el desvío va hacia un lado en el suelo. Las cuentas son las mismas.\u003c/p>\u003c/div>\n  \u003cdiv class=\"ext\">\n    \u003cspan class=\"tag\">Ampliación con fuentes externas\u003c/span>\n    \u003ch3>Bayoneta de doble desplazamiento\u003c/h3>\n    \u003cp>A veces el tramo se desvía a la vez \u003cb>hacia un lado y hacia arriba\u003c/b> (el isométrico dibuja dos triángulos rayados). Se resuelven \u003cb>dos triángulos\u003c/b>: primero el del suelo (da una hipotenusa), y con ella y la altura, el segundo. La hipotenusa final es \u003cb>√(a² + b² + c²)\u003c/b>. Además, los codos van \u003cb>girados\u003c/b>: el plano del codo no es vertical ni horizontal, y el ángulo de giro se saca del primer triángulo. El manual del tubero lo resuelve en sus págs. 19 y 20; es materia de segundo curso.\u003c/p>\n  \u003c/div>\n  \u003cdiv class=\"recuerda\" style=\"--c:var(--molten)\">\u003ch4>Lo que tienes que recordar\u003c/h4>\u003cul>\n    \u003cli>Bayoneta = desvío con dos codos iguales.\u003c/li>\n    \u003cli>H = √(d² + r²). α = tan⁻¹(d/r).\u003c/li>\n    \u003cli>Carrete inclinado = H − 2 avances − 2 separaciones.\u003c/li>\n  \u003c/ul>\u003c/div>\n\u003c/section>\n\n\u003c!-- ============ COSTE ============ -->\n\u003csection id=\"coste\" style=\"--c:var(--warn)\">\n  \u003ch2>Pulgadas-diámetro: cuánta soldadura hay\u003c/h2>\n  \u003cdiv class=\"en10\">En tubería, la soldadura se mide en \u003cb>pulgadas-diámetro\u003c/b>: cada soldadura cuenta tantas pulgadas como el \u003cb>NPS\u003c/b> del tubo. Una soldadura de 6\" son 6 pulgadas-diámetro. Se suman todas y se multiplica por el precio.\u003c/div>\n  \u003cdiv class=\"calc\" id=\"pdCalc\">\n    \u003ch3>Calcula el coste de soldar un isométrico\u003c/h3>\n    \u003cdiv id=\"pdRows\">\u003c/div>\n    \u003cdiv class=\"row\">\u003cbutton class=\"btn ghost\" type=\"button\" id=\"pdAdd\">+ Añadir diámetro\u003c/button>\n      \u003clabel for=\"pdE\">Precio (€ por pulgada-diámetro)\u003cinput id=\"pdE\" type=\"number\" min=\"0\" step=\"0.5\" value=\"18\">\u003c/label>\u003c/div>\n    \u003cdiv class=\"out\" id=\"pdOut\">\u003c/div>\n  \u003c/div>\n  \u003cp class=\"muted small\">Ejemplo del ejercicio 1 de «16 Isométricos»: 4 soldaduras de 5\" (20 pulgadas) + 8 soldaduras de 3\" (24 pulgadas) = 44 pulgadas-diámetro × 18 € = \u003cb>792 €\u003c/b>.\u003c/p>\n  \u003cdiv class=\"callout hot\">\u003ch4>Diámetros, no perímetros\u003c/h4>\u003cp>No calcules la circunferencia de cada soldadura. Solo \u003cb>sumas los NPS\u003c/b> de cada punto del isométrico. Es la unidad con la que se presupuesta y se mide el rendimiento de un soldador de tubería.\u003c/p>\u003c/div>\n  \u003cdiv class=\"recuerda\" style=\"--c:var(--warn)\">\u003ch4>Lo que tienes que recordar\u003c/h4>\u003cul>\n    \u003cli>Cada soldadura = su NPS en pulgadas-diámetro.\u003c/li>\n    \u003cli>Cuenta los puntos del isométrico por diámetros.\u003c/li>\n    \u003cli>Total × precio = coste.\u003c/li>\n  \u003c/ul>\u003c/div>\n\u003c/section>\n\n\u003c!-- ============ ORDEN ============ -->\n\u003csection id=\"orden\">\n  \u003ch2>El orden de montaje\u003c/h2>\n  \u003cdiv class=\"en10\">Antes de empezar, \u003cb>piensa un minuto\u003c/b>: cómo es la pieza, por dónde empezar y cómo acabar. Se trata de montarla \u003cb>de una vez, moviéndola lo menos posible\u003c/b>, y comprobando paralelos y niveles mientras avanzas.\u003c/div>\n  \u003cfigure>\n    \u003cdiv class=\"imgbox zoomable\">\u003cimg id=\"f-or\" src=\"data:image/jpeg;base64,\" alt=\"A la izquierda, un isométrico; a la derecha, la misma tubería en producción sobre caballetes, con las piezas numeradas del 1 al 14 en el orden de montaje y las comprobaciones de paralelismo A, B y C y de nivel D y E.\">\u003c/div>\n    \u003cfigcaption>\u003cb>Fuente: «Manual práctico del tubero», CIFO Tarragona, pág. 27.\u003c/b> Izquierda: el isométrico. Derecha: el orden de montaje del 1 al 14, con las comprobaciones de \u003cb>paralelismo\u003c/b> (A, B, C) y de \u003cb>nivel\u003c/b> (D, E).\u003c/figcaption>\n  \u003c/figure>\n  \u003col class=\"steps\">\n    \u003cli>\u003cspan>\u003cb>Entiende la forma.\u003c/b> Un truco del manual: dobla una \u003cb>varilla o un alambre\u003c/b> imitando el isométrico. Con la pieza en la mano se ve todo.\u003c/span>\u003c/li>\n    \u003cli>\u003cspan>\u003cb>Empieza por la parte más cómoda\u003c/b>, sin chocar con nada alrededor.\u003c/span>\u003c/li>\n    \u003cli>\u003cspan>\u003cb>Monta las bridas boca arriba o en vertical\u003c/b> siempre que puedas. Boca abajo es mucho más difícil.\u003c/span>\u003c/li>\n    \u003cli>\u003cspan>\u003cb>Comprueba sobre la marcha\u003c/b> los tramos que deben quedar \u003cb>paralelos\u003c/b> y a \u003cb>mismo nivel\u003c/b>. Son medidas fáciles y muy fiables.\u003c/span>\u003c/li>\n    \u003cli>\u003cspan>\u003cb>No dejes que los errores se sumen.\u003c/b> Un milímetro aquí y otro allá, al final de la línea son un centímetro.\u003c/span>\u003c/li>\n  \u003c/ol>\n  \u003cdiv class=\"recuerda\">\u003ch4>Lo que tienes que recordar\u003c/h4>\u003cul>\n    \u003cli>Primero pensar; luego montar de una vez.\u003c/li>\n    \u003cli>Bridas boca arriba si se puede.\u003c/li>\n    \u003cli>Paralelos y niveles en cada paso.\u003c/li>\n  \u003c/ul>\u003c/div>\n\u003c/section>\n\n\u003c!-- ============ BRIDA ============ -->\n\u003csection id=\"brida\" style=\"--c:var(--arc)\">\n  \u003ch2>Colocar una brida a nivel\u003c/h2>\n  \u003cdiv class=\"en10\">Una brida mal girada no casa con la del equipo. Se coloca así: \u003cb>agujeros a nivel\u003c/b>, separación de soldadura, \u003cb>punto abajo\u003c/b>, comprobar nivel otra vez, \u003cb>escuadra\u003c/b>, y a soldar.\u003c/div>\n  \u003cfigure>\n    \u003cdiv class=\"imgbox zoomable\">\u003cimg id=\"f-br\" src=\"data:image/jpeg;base64,\" alt=\"Seis pasos para colocar una brida: nivel apoyado en dos agujeros, separación de 3,25 milímetros, punteo inferior que tira de la brida, nivel corregido, comprobación con escuadra y brida lista para soldar.\">\u003c/div>\n    \u003cfigcaption>\u003cb>Fuente: «Manual práctico del tubero», CIFO Tarragona, pág. 41.\u003c/b> Figs. 1 a 6: colocación de una brida.\u003c/figcaption>\n  \u003c/figure>\n  \u003col class=\"steps\">\n    \u003cli>\u003cspan>\u003cb>Agujeros a nivel\u003c/b> (fig. 1). Apoya el nivel en dos agujeros. Lo normal es que los \u003cb>ejes pasen entre dos agujeros\u003c/b> («a caballo»), nunca por el centro de un agujero, salvo que el plano diga otra cosa.\u003c/span>\u003c/li>\n    \u003cli>\u003cspan>\u003cb>Presenta contra el tubo\u003c/b> respetando la \u003cb>separación\u003c/b> de raíz (fig. 2).\u003c/span>\u003c/li>\n    \u003cli>\u003cspan>\u003cb>Puntea abajo\u003c/b> y vuelve a comprobar el nivel: el punto, al enfriarse, \u003cb>tira\u003c/b> y gira la brida (figs. 3 y 4).\u003c/span>\u003c/li>\n    \u003cli>\u003cspan>\u003cb>Escuadra y metro\u003c/b>: la cara tiene que quedar perpendicular al tubo, comprobando en dos posiciones (fig. 5).\u003c/span>\u003c/li>\n    \u003cli>\u003cspan>Más puntos repartidos y \u003cb>a soldar\u003c/b> (fig. 6).\u003c/span>\u003c/li>\n  \u003c/ol>\n  \u003cdiv class=\"callout hot\">\u003ch4>Las coordenadas son las de la obra\u003c/h4>\u003cp>Si la brida va al final de un tramo inclinado, \u003cb>no\u003c/b> pongas los agujeros a nivel respecto al tubo inclinado. Los agujeros se colocan respecto a los \u003cb>ejes de la planta\u003c/b> (norte-sur, este-oeste y la vertical), que son los del equipo donde va a atornillarse.\u003c/p>\u003c/div>\n  \u003cdiv class=\"recuerda\">\u003ch4>Lo que tienes que recordar\u003c/h4>\u003cul>\n    \u003cli>Agujeros a caballo de los ejes, con el nivel.\u003c/li>\n    \u003cli>Punto abajo, y nivel otra vez.\u003c/li>\n    \u003cli>Escuadra antes de soldar.\u003c/li>\n  \u003c/ul>\u003c/div>\n\u003c/section>\n\n\u003c!-- ============ PRUEBA Y TRACEADO ============ -->\n\u003csection id=\"prueba\" style=\"--c:var(--steel)\">\n  \u003ch2>Después de montar: prueba y traceado\u003c/h2>\n  \u003cdiv class=\"en10\">Una tubería terminada se \u003cb>prueba\u003c/b> antes de llenarla de producto. Y algunas llevan un tubito pegado, el \u003cb>traceado\u003c/b>, que las mantiene calientes.\u003c/div>\n  \u003cdiv class=\"ext\">\n    \u003cspan class=\"tag\">Ampliación con fuentes externas\u003c/span>\n    \u003ch3>La prueba hidráulica\u003c/h3>\n    \u003cp>Se llena la línea de \u003cb>agua\u003c/b>, se purga el aire por los venteos y se sube la presión por encima de la de trabajo. La norma de tubería de proceso, \u003cb>ASME B31.3\u003c/b>, pide en general \u003cb>1,5 veces la presión de diseño\u003c/b> mantenida al menos \u003cb>10 minutos\u003c/b> (muchas empresas, más), y se revisan todas las soldaduras y bridas buscando fugas. Para probar se usan \u003cb>bridas ciegas\u003c/b> y se desmontan o aíslan los equipos que no aguantan esa presión (como las válvulas de seguridad).\u003c/p>\n  \u003c/div>\n  \u003ch3>El traceado de vapor\u003c/h3>\n  \u003cul class=\"list\">\n    \u003cli>Es un \u003cb>tubo fino\u003c/b> (de ½\", tipo \u003ci>tubing\u003c/i>) con vapor que va pegado a la tubería principal, bajo el aislamiento. Sirve para que el fluido \u003cb>no se enfríe\u003c/b> ni se solidifique (asfalto, azufre, fuelóleo).\u003c/li>\n    \u003cli>No es un aislamiento: es una \u003cb>fuente de calor\u003c/b>. Otras formas: \u003cb>traceado eléctrico\u003c/b> (cables con resistencia, más caro) y \u003cb>tubería encamisada\u003c/b> (un tubo dentro de otro, para temperaturas muy altas).\u003c/li>\n    \u003cli>El vapor sale de un \u003cb>colector\u003c/b> (manifold) y el condensado vuelve a otro, con purgadores. Según el documento del módulo, cada traceado no pasa de unos \u003cb>50 m\u003c/b> junto a la tubería.\u003c/li>\n    \u003cli>Se diseña al final del proyecto… y se suele olvidar. Quien lo sabe montar, destaca.\u003c/li>\n  \u003c/ul>\n  \u003cdiv class=\"recuerda\" style=\"--c:var(--steel)\">\u003ch4>Lo que tienes que recordar\u003c/h4>\u003cul>\n    \u003cli>Prueba con agua a más presión que la de trabajo, buscando fugas.\u003c/li>\n    \u003cli>Traceado = tubito caliente que acompaña a la tubería.\u003c/li>\n  \u003c/ul>\u003c/div>\n\u003c/section>\n\n\u003c!-- ============ IDEAS CLAVE ============ -->\n\u003csection id=\"ideas\">\n  \u003ch2>Ideas clave\u003c/h2>\n  \u003cp class=\"lead\">Con estas cuentas y estos trucos, el carrete sale a la primera.\u003c/p>\n  \u003col class=\"keys\">\n    \u003cli>La cota va de \u003cb>eje a eje\u003c/b>; el tubo es más corto.\u003c/li>\n    \u003cli>\u003cb>Avance\u003c/b> de un codo LR: 1,5 × NPS × 25,4 × tan(α/2). En 90°, unos 38 × NPS mm.\u003c/li>\n    \u003cli>Solo los codos \u003cb>BW\u003c/b> se cortan a otro ángulo.\u003c/li>\n    \u003cli>\u003cb>Tubo = cota − avances − separaciones.\u003c/b> Lo de otras piezas, del catálogo.\u003c/li>\n    \u003cli>\u003cb>Bayoneta\u003c/b>: H = √(d² + r²) y α = tan⁻¹(d/r).\u003c/li>\n    \u003cli>Soldadura en \u003cb>pulgadas-diámetro\u003c/b>: se suman los NPS de cada soldadura.\u003c/li>\n    \u003cli>Monta de una vez, bridas boca arriba, comprobando \u003cb>paralelos y niveles\u003c/b>.\u003c/li>\n    \u003cli>Brida: \u003cb>agujeros a caballo\u003c/b>, punto abajo, nivel otra vez y escuadra.\u003c/li>\n  \u003c/ol>\n  \u003ch3>Comprueba lo que has aprendido\u003c/h3>\n  \u003cdiv class=\"quiz\" id=\"quiz\">\u003c/div>\n  \u003cdiv class=\"nextblock\">\n    \u003ca href=\"TUB_4_Isometricos.html\">\u003csmall>Anterior\u003c/small>\u003cb>← Bloque 4 · Isométricos\u003c/b>\u003c/a>\n    \u003ca class=\"next\" href=\"TUB_0_Portada.html\">\u003csmall>Has terminado\u003c/small>\u003cb>Volver a la portada →\u003c/b>\u003c/a>\n  \u003c/div>\n\u003c/section>\n\n\u003cfooter>\n  \u003cp style=\"margin:0 0 1rem\">\u003cb>Recurso elaborado por Xurxo.\u003c/b> Serie Tubería · Bloque 5 de 5.\u003c/p>\n  \u003cdetails>\n    \u003csummary>Fuentes y diferencias entre ellas\u003c/summary>\n    \u003cdiv class=\"in\">\n      \u003cp>\u003cb>Documentos del módulo\u003c/b>\u003c/p>\n      \u003cul>\n        \u003cli>\u003cb>«Manual práctico del tubero»\u003c/b>, A. Akkers, CIFO Tarragona (2012): avance de un codo (págs. 16 y 17), bayonetas simples y de doble desplazamiento (págs. 18 a 20), criterio y orden de montaje (pág. 27), colocación de una brida (pág. 41). Figuras de las págs. 17, 27 y 41. Con anotaciones de la presentación del módulo.\u003c/li>\n        \u003cli>\u003cb>«16 Isométricos»\u003c/b> del módulo: datos de penetración y dilatación, carretes, cantidad de tubo y coste a 18 € por pulgada-diámetro.\u003c/li>\n        \u003cli>\u003cb>«6.6 Traceado de vapor»\u003c/b> (J. M. Álvarez, CM2, 2019): qué es el traceado, métodos y distancias.\u003c/li>\n      \u003c/ul>\n      \u003cp>\u003cb>Fuentes externas\u003c/b>\u003c/p>\n      \u003cul class=\"src\">\n        \u003cli>ASME B31.3, apartado 345.4 (prueba hidrostática a 1,5 veces la presión de diseño, corregida por temperatura; al menos 10 minutos antes de revisar fugas). Resumen en EPCLand: \u003ca href=\"https://epcland.com/asme-b31-3-pressure-leak-test-2/\">epcland.com/asme-b31-3-pressure-leak-test-2\u003c/a>\u003c/li>\n      \u003c/ul>\n      \u003cp>\u003cb>Diferencias detectadas\u003c/b>\u003c/p>\n      \u003cul>\n        \u003cli>\u003cb>Avance del codo de 45°.\u003c/b> El manual da «diámetro en pulgadas × 18». La fórmula da ≈ \u003cb>× 16\u003c/b> (1,5 × 25,4 × tan 22,5° = 15,8), y el catálogo (ASME B16.9) da 64 mm para un 4\" (× 16), pero más en tamaños pequeños (22 mm en 1\", × 22). Se usa la fórmula y se recomienda el catálogo para los tamaños pequeños.\u003c/li>\n        \u003cli>\u003cb>«Penetración».\u003c/b> Los ejercicios llaman «penetración» a la separación entre tubo y accesorio antes de soldar. En soldadura, «penetración» es otra cosa (lo que entra el cordón). Aquí se dice \u003cb>separación de raíz\u003c/b> y se recuerda el nombre del ejercicio.\u003c/li>\n        \u003cli>\u003cb>Holgura del enchufe.\u003c/b> 3 mm en los ejercicios y en el manual; unos 1,6 mm en la norma ASME B31.3 (ver Bloque 2).\u003c/li>\n      \u003c/ul>\n      \u003cp class=\"small\">Los dibujos sin pie de fuente son esquemas propios. Toca una imagen para ampliarla.\u003c/p>\n    \u003c/div>\n  \u003c/details>\n\u003c/footer>\n\n\u003c/main>\n\n\u003cdiv class=\"lb\" id=\"lb\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Figura ampliada\">\n  \u003cdiv class=\"top\">\u003cspan>Desliza para moverte por la figura\u003c/span>\u003cbutton type=\"button\" id=\"lbClose\">Cerrar\u003c/button>\u003c/div>\n  \u003cdiv class=\"pan\">\u003cimg id=\"lbImg\" alt=\"\">\u003c/div>\n\u003c/div>\n\n\u003cscript>\nwindow.QUIZ=[\n  {q:\"¿Qué es el avance de un codo?\",o:[\"Lo que mide el codo por fuera\",\"La distancia de la cara del codo al cruce de los ejes\",\"El radio interior del codo\"],a:1,\n   e:\"Es lo que el codo «se come» de la cota: de su cara al punto donde se cruzan los ejes.\"},\n  {q:\"¿Cuánto avanza, más o menos, un codo de 90° LR de 6\\\"?\",o:[\"152 mm\",\"228 mm\",\"38 mm\"],a:1,\n   e:\"38 × 6 = 228 mm (exacto: 1,5 × 6 × 25,4 = 228,6 mm).\"},\n  {q:\"Cota de 1000 mm entre dos codos de 90° LR de 2\\\" a tope, separación de 3 mm. ¿Cuánto tubo cortas?\",o:[\"1000 mm\",\"Unos 842 mm\",\"Unos 924 mm\"],a:1,\n   e:\"Avance = 1,5 × 2 × 25,4 = 76,2 mm. 1000 − 2 × 76,2 − 2 × 3 = 841,6 ≈ 842 mm.\"},\n  {q:\"Necesitas un codo de 30°. ¿De dónde lo sacas?\",o:[\"De un codo SW de 45°\",\"Cortando un codo BW de 90° (o de 45°)\",\"No existe, hay que hacer un injerto\"],a:1,\n   e:\"Los codos BW se cortan al ángulo que haga falta. Los SW y TH no.\"},\n  {q:\"Bayoneta con 600 mm de desplazamiento y 800 mm de recorrido. ¿Cuál es la hipotenusa?\",o:[\"1400 mm\",\"1000 mm\",\"700 mm\"],a:1,\n   e:\"√(600² + 800²) = √1.000.000 = 1000 mm.\"},\n  {q:\"En esa bayoneta, ¿de cuántos grados son los codos?\",o:[\"Unos 37°\",\"45°\",\"Unos 53°\"],a:0,\n   e:\"α = tan⁻¹(600 ÷ 800) = tan⁻¹(0,75) ≈ 36,9°.\"},\n  {q:\"Un isométrico tiene 6 soldaduras de 4\\\" y 2 de 2\\\". ¿Cuántas pulgadas-diámetro son?\",o:[\"8\",\"28\",\"12\"],a:1,\n   e:\"6 × 4 + 2 × 2 = 24 + 4 = 28 pulgadas-diámetro.\"},\n  {q:\"Has dado un punto abajo a una brida. ¿Qué haces ahora?\",o:[\"Soldar entera\",\"Volver a comprobar el nivel de los agujeros, porque el punto tira\",\"Nada más\"],a:1,\n   e:\"Al enfriarse, el punto tira y puede girar la brida. Se comprueba otra vez el nivel y luego la escuadra.\"}\n];\n\u003c/script>\n\u003cscript>\n(function(){\n  \"use strict\";\n  var $=function(s,r){return (r||document).querySelector(s)};\n  var $$=function(s,r){return Array.prototype.slice.call((r||document).querySelectorAll(s))};\n  window.$=$; window.$$=$$;\n\n  /* ---------- Barra de progreso y sección activa ---------- */\n  var bar=$(\"#bar\"), links=$$(\"#chips a\"), secs=links.map(function(a){return $(a.getAttribute(\"href\"))});\n  function onScroll(){\n    var h=document.documentElement, max=h.scrollHeight-h.clientHeight;\n    if(bar)bar.style.width=(max>0?Math.min(100,h.scrollTop/max*100):0)+\"%\";\n    var y=window.scrollY+140, cur=0;\n    secs.forEach(function(s,i){if(s&&s.getBoundingClientRect().top+window.scrollY\u003c=y)cur=i});\n    links.forEach(function(a,i){\n      var on=i===cur; a.classList.toggle(\"on\",on);\n      if(on)a.setAttribute(\"aria-current\",\"true\"); else a.removeAttribute(\"aria-current\");\n    });\n    var on=links[cur]; if(on&&on!==onScroll.last){\n      onScroll.last=on; var c=$(\"#chips\"); c.scrollTo({left:on.offsetLeft-c.clientWidth/2+on.clientWidth/2,behavior:\"smooth\"});\n    }\n  }\n  if(links.length){window.addEventListener(\"scroll\",onScroll,{passive