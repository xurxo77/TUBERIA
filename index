;border-radius:8px;background:var(--card)}\ndetails>summary{cursor:pointer;padding:.7rem 1rem;font-weight:700;list-style:none}\ndetails>summary::-webkit-details-marker{display:none}\ndetails>summary::before{content:\"+\";display:inline-block;width:1.2rem;color:var(--arc);font-weight:700}\ndetails[open]>summary::before{content:\"–\"}\ndetails>.in{padding:0 1rem 1rem}\n.scroll{overflow-x:auto;-webkit-overflow-scrolling:touch;margin:1.1rem 0;border:1px solid var(--line);border-radius:8px;background:var(--card)}\ntable{border-collapse:collapse;width:100%;font-size:.93rem}\nth,td{text-align:left;padding:.55rem .7rem;border-bottom:1px solid var(--line);vertical-align:top}\nth{background:var(--steel-soft);font-weight:700}\ntr:last-child td{border-bottom:0}\ntd:first-child{font-weight:700;width:32%}\n@media(max-width:560px){table{font-size:.86rem}th,td{padding:.45rem .5rem}td:first-child{width:auto}}\n.two{display:grid;gap:.9rem;margin:1.2rem 0}\n@media(min-width:620px){.two{grid-template-columns:1fr 1fr}}\n.box{border:1px solid var(--line);background:var(--card);border-radius:8px;padding:.3rem 1rem .9rem}\n.box h3{margin-top:.8rem}\n.box ul,.list{margin:.4rem 0 0;padding-left:1.15rem}\n.box li,.list li{margin:.4rem 0}\n.plus h3{color:var(--gas)} .minus h3{color:var(--molten)}\n.principle{margin:1.3rem 0;display:grid;gap:.6rem}\n.principle div{padding:.8rem 1rem;border-left:6px solid var(--c);background:var(--card);border-radius:0 8px 8px 0;border-top:1px solid var(--line);border-right:1px solid var(--line);border-bottom:1px solid var(--line)}\n.principle b{color:var(--c)}\n.p1{--c:var(--arc)} .p2{--c:var(--gas)} .p3{--c:var(--molten)}\n.relations{display:grid;gap:.5rem;margin:1.2rem 0}\n.rel{display:flex;align-items:center;justify-content:space-between;gap:.5rem;padding:.7rem 1rem;background:var(--card);border:1px solid var(--line);border-radius:8px}\n.rel span{flex:1}\n.rel i{font-style:normal;font:700 1.4rem \"Barlow Condensed\",sans-serif;color:var(--arc);flex:none}\n.s