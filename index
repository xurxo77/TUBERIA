ap:.5rem;grid-template-columns:repeat(auto-fit,minmax(9.5rem,1fr));margin:1rem 0 .6rem}\n.pick button{font:inherit;font-weight:700;text-align:left;padding:.7rem .85rem;border-radius:10px;border:1.5px solid var(--line);background:var(--card);color:var(--ink);cursor:pointer;min-height:3rem}\n.pick button[aria-pressed=\"true\"]{border-color:var(--arc);background:var(--arc-soft);box-shadow:inset 0 0 0 1px var(--arc)}\n.pick button small{display:block;font-weight:400;color:var(--ink2);font-size:.85rem}\n.result{margin:.4rem 0 1rem;padding:.9rem 1rem;border-radius:10px;background:var(--card);border:1px solid var(--line);border-left:6px solid var(--arc)}\n.result h3{margin:.1rem 0 .4rem;color:var(--arc)}\n.result dl{display:grid;grid-template-columns:auto 1fr;gap:.25rem .8rem;margin:.3rem 0}\n.result dt{font-weight:700}.result dd{margin:0;color:var(--ink)}\n.result .warn{margin:.6rem 0 0;font-size:.95rem;color:var(--warn)}\n/* despiece interactivo */\n.explode{margin:1.2rem 0;background:var(--card);border:1px solid var(--line);border-radius:10px;overflow:hidden}\n.explode svg{display:block;width:100%;height:auto}\n.explode .part{cursor:pointer;transition:opacity .2s}\n.explode .part:focus{outline:none}\n.explode.sel .part{opacity:.3}.explode.sel .part.on{opacity:1}\n.explode .part.on .hl{stroke:var(--molten);stroke-width:3}\n.explode .info{padding:.8rem 1rem 1rem;border-top:1px solid var(--line);min-height:6.5rem}\n.explode .info h3{margin:.1rem 0 .3rem;color:var(--molten)}\n.explode .info p{margin:.3rem 0}\n/* fichas de defecto */\n.defect{margin:1.4rem 0;border:1px solid var(--line);border-radius:12px;background:var(--card);overflow:hidden}\n.defect>header{display:flex;gap:.7rem;align-items:center;padding:.8rem 1rem;background:var(--steel-soft)}\n.defect>header .n{flex:none;width:2.3rem;height:2.3rem;display:grid;place-items:center;border-radius:50%;background:#C0262D;color:#fff;font:700 1.2rem \"Barlow Condensed\",sans-serif}\n.defect>header h3{margin:0;font-size:1.5rem}\n.defect>header .tag{margin-left:auto;font-size:.75rem;font-weight:700;padding:.15rem .5rem;border-radius:99px;background:var(--card);color:var(--ink2);white-space:nowrap}\n.defect .pic{background:var(--paper);padding:.6rem;display:grid;place-items:center;border-bottom:1px solid var(--line)}\n.defect .pic svg{width:100%;max-width:24rem;height:auto}\n.defect .pic img{max-width:100%;height:auto;border-radius:6px}\n.defect .grid4{display:grid;gap:0}\n@media(min-width:620px){.defect .grid4{grid-template-columns:1fr 1fr}}\n.defect .grid4>div{padding:.7rem 1rem .8rem;border-top:1px solid var(--line)}\n.defect .grid4 h4{margin:0 0 .25rem;font:700 1.08rem \"Barlow Condensed\",sans-serif;letter-spacing:.02em;text-transform:uppercase}\n.defect .grid4 ul{margin:.1rem 0 0;padding-left:1.1rem}.defect .grid4 li{margin:.2rem 0}\n.defect .see h4{color:var(--arc)}.defect .why h4{color:var(--molten)}.defect .fix h4{color:var(--gas)}.defect .avoid h4{color:var(--warn)}\n/* diagnóstico */\n.diag{margin:1.2rem 0;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:.8rem 1rem 1rem}\n.diag ol{margin:.5rem 0 0;padding-left:1.3rem}.diag li{margin:.45rem 0}\n.diag .go{font-weight:700}\n/* lista de comprobación */\n.check{list-style:none;padding:0;margin:1rem 0;display:grid;gap:.45rem}\n.check label{display:flex;gap:.7rem;align-items:flex-start;padding:.65rem .85rem;border:1px solid var(--line);border-radius:8px;background:var(--card);cursor:pointer}\n.check input{flex:none;width:1.35rem;height:1.35rem;margin:.1rem 0 0;accent-color:var(--gas)}\n.check label:has(input:checked){background:var(--gas-soft);border-color:var(--gas)}\n.check-status{font-weight:700;color:var(--gas)}\n/* quiz: barra de resultado e imagen */\n.meter{height:.7rem;border-radius:99px;background:var(--steel-soft);overflow:hidden;margin:.4rem 0}\n.meter span{display:block;height:100%;background:var(--gas)}\n.qfig{margin:0 0 .8rem;padding:.4rem;background:#fff;border:1px solid var(--line);border-radius:8px;text-align:center}\n.qfig img,.qfig svg{max-width:100%;max-height:15rem;height:auto}\n/* tabla de colores */\n.sw{display:inline-block;width:1.1rem;height:1.1rem;border-radius:3px;vertical-align:-.2rem;margin-right:.35rem;border:1px solid rgba(0,0,0,.3)}\n.big-num{font:700 2.4rem/1 \"Barlow Condensed\",sans-serif;color:var(--arc)}\n\n/* ===== Añadidos serie MONTAJE ===== */\n/* portada con dibujo en vez de foto */\n.hero svg.bg{display:block;width:100%;height:min(62vh,420px)}\n/* calculadoras y deslizadores */\n.calc{margin:1.2rem 0;background:var(--card);border:1px solid var(--line);border-radius:10px;padding:.9rem 1rem 1rem}\n.calc h3{margin:.1rem 0 .5rem}\n.calc .row{display:flex;flex-wrap:wrap;gap:.6rem 1rem;align-items:end;margin:.4rem 0}\n.calc label{display:flex;flex-direction:column;gap:.25rem;font-size:.92rem;font-weight:700;color:var(--ink2)}\n.calc input[type=number]{font:inherit;font-size:1.1rem;width:7.5rem;padding:.45rem .6rem;border-radius:8px;border:1.5px solid var(--line);background:var(--paper);color:var(--ink)}\n.calc input[type=range]{width:100%;accent-color:var(--arc);min-height:2rem}\n.calc .out{margin:.7rem 0 0;padding:.7rem .9rem;border-radius:8px;background:var(--steel-soft)}\n.calc .out.ok{background:var(--gas-soft)}.calc .out.bad{background:var(--molten-soft)}\n.calc .out b.big{font:700 1.7rem \"Barlow Condensed\",sans-serif}\n.calc svg{display:block;width:100%;max-width:26rem;margin:.4rem auto 0;height:auto}\n/* buscador de palabras */\n.gloss input{font:inherit;width:100%;padding:.6rem .8rem;border-radius:8px;border:1.5px solid var(--line);background:var(--paper);color:var(--ink)}\n.gloss table{margin-top:.6rem}\n.gloss td:first-child{width:45%}\n/* paso a paso con dibujo */\n.stepper{margin:1.3rem 0;background:var(--card);border:1px solid var(--line);border-radius:10px;overflow:hidden}\n.stepper svg{display:block;width:100%;height:auto;background:var(--steel-soft)}\n.stepper .ctrl{display:flex;justify-content:space-between;align-items:center;gap:.5rem;padding:.6rem .9rem;border-top:1px solid var(--line)}\n.stepper .ctrl span{font-weight:700;color:var(--ink2)}\n.stepper .txt{padding:.1rem 1.1rem 1rem}\n.stepper .txt h3{margin:.7rem 0 .3rem;color:var(--arc)}\n.btn.ghost{background:var(--paper);color:var(--ink);border:1.5px solid var(--line)}\n.btn:disabled{opacity:.4;cursor:default}\n.st{transition:opacity .35s}.st.hide{opacity:0}.st.new .hl{filter:drop-shadow(0 0 4px #FF9A2E)}\n\n\u003c/style>\n\u003cstyle>\n.vpic{display:grid;gap:.7rem;grid-template-columns:7rem 1fr;align-items:center;margin:.7rem 0}\n.vpic svg{width:7rem;height:auto;background:var(--paper);border-radius:8px;border:1px solid var(--line)}\n#vPanel img{display:block;width:100%;height:auto;border-radius:8px;border:1px solid var(--line);background:#fff;margin:.4rem 0 .2rem}\n@media(max-width:480px){.vpic{grid-template-columns:5.5rem 1fr}.vpic svg{width:5.5rem}}\n.bolt{transition:fill .2s}\n\u003c/style>\n\u003c/head>\n\u003cbody>\n\u003cheader class=\"topnav\" id=\"topnav\">\n  \u003cdiv class=\"bar\" id=\"bar\">\u003c/div>\n  \u003cnav class=\"blocknav\" aria-label=\"Bloques de tubería\">\n    \u003ca href=\"TUB_0_Portada.html\">Portada\u003c/a>\n    \u003ca href=\"TUB_1_Tuberia.html\">1 La tubería\u003c/a>\n    \u003ca href=\"TUB_2_Accesorios.html\">2 Accesorios\u003c/a>\n    \u003ca href=\"TUB_3_Bridas_Valvulas.html\" class=\"cur\" aria-current=\"page\">3 Bridas y válvulas\u003c/a>\n    \u003ca href=\"TUB_4_Isometricos.html\">4 Isométricos\u003c/a>\n    \u003ca href=\"TUB_5_Taller.html\">5 Al taller\u003c/a>\n  \u003c/nav>\n  \u003cnav class=\"chips\" id=\"chips\" aria-label=\"Secciones\">\n    \u003ca href=\"#inicio\">Inicio\u003c/a>\n    \u003ca href=\"#brida\">La unión bridada\u003c/a>\n    \u003ca href=\"#tipos\">Tipos de brida\u003c/a>\n    \u003ca href=\"#clase\">Clase\u003c/a>\n    \u003ca href=\"#caras\">Caras y juntas\u003c/a>\n    \u003ca href=\"#marcado\">Marcado\u003c/a>\n    \u003ca href=\"#apriete\">Apriete en cruz\u003c/a>\n    \u003ca href=\"#valvulas\">Válvulas\u003c/a>\n    \u003ca href=\"#caracteristicas\">Datos de una válvula\u003c/a>\n    \u003ca href=\"#ideas\">Ideas clave\u003c/a>\n  \u003c/nav>\n\u003c/header>\n\n\u003cdiv class=\"hero\" id=\"inicio\">\n  \u003csvg class=\"bg\" viewBox=\"0 0 800 420\" preserveAspectRatio=\"xMidYMid slice\" role=\"img\" aria-label=\"Dibujo: dos bridas unidas con espárragos y una válvula de compuerta con su volante.\">\n    \u003crect width=\"800\" height=\"420\" fill=\"#16314F\"/>\n    \u003cpath d=\"M-20 240 H820\" stroke=\"#9FB3C8\" stroke-width=\"50\"/>\n    \u003cg fill=\"#C9D6E3\">\u003crect x=\"150\" y=\"150\" width=\"18\" height=\"180\"/>\u003crect x=\"172\" y=\"150\" width=\"18\" height=\"180\"/>\u003crect x=\"580\" y=\"150\" width=\"18\" height=\"180\"/>\u003crect x=\"602\" y=\"150\" width=\"18\" height=\"180\"/>\u003c/g>\n    \u003crect x=\"168\" y=\"150\" width=\"4\" height=\"180\" fill=\"#FFB27A\"/>\u003crect x=\"598\" y=\"150\" width=\"4\" height=\"180\" fill=\"#FFB27A\"/>\n    \u003cg stroke=\"#E8EEF5\" stroke-width=\"5\">\u003cline x1=\"135\" y1=\"168\" x2=\"205\" y2=\"168\"/>\u003cline x1=\"135\" y1=\"312\" x2=\"205\" y2=\"312\"/>\u003cline x1=\"565\" y1=\"168\" x2=\"635\" y2=\"168\"/>\u003cline x1=\"565\" y1=\"312\" x2=\"635\" y2=\"312\"/>\u003c/g>\n    \u003cg transform=\"translate(385 240)\">\u003cpath d=\"M-90 -60 L90 60 V-60 L-90 60 Z\" fill=\"#E8EEF5\"/>\u003cline x1=\"0\" y1=\"0\" x2=\"0\" y2=\"-150\" stroke=\"#E8EEF5\" stroke-width=\"8\"/>\u003cellipse cx=\"0\" cy=\"-150\" rx=\"70\" ry=\"12\" fill=\"none\" stroke=\"#FFB27A\" stroke-width=\"7\"/>\u003c/g>\n  \u003c/svg>\n  \u003cdiv class=\"txt wrap\">\n    \u003ch1>Bloque 3. Bridas y válvulas\u003c/h1>\n    \u003cp class=\"sub\">Las uniones que se pueden desmontar y las piezas que abren, cierran y protegen.\u003c/p>\n    \u003cp class=\"ctx\">CFGM Soldadura y Calderería · Montaje de tubería\u003c/p>\n    \u003cp class=\"ctx\" style=\"margin-top:.3rem\">\u003cb>Autor: Xurxo\u003c/b>\u003c/p>\n  \u003c/div>\n\u003c/div>\n\n\u003cmain class=\"wrap\">\n\n\u003csection id=\"intro\">\n  \u003cp class=\"lead\">Una tubería soldada entera no se puede desmontar. Pero las \u003cb>válvulas\u003c/b>, las \u003cb>bombas\u003c/b> y los \u003cb>depósitos\u003c/b> hay que poder quitarlos para repararlos. Para eso están las \u003cb>bridas\u003c/b>: dos discos que se aprietan con tornillos y una junta en medio.\u003c/p>\n  \u003ch3>Al terminar sabrás\u003c/h3>\n  \u003cul class=\"list\">\n    \u003cli>nombrar las partes de una unión bridada;\u003c/li>\n    \u003cli>reconocer las bridas de cuello (WN), deslizante (SO), de enchufe (SW), roscada, loca y ciega, y dónde se suelda cada una;\u003c/li>\n    \u003cli>entender la \u003cb>clase\u003c/b> de una brida (150, 300, 600…) y su \u003cb>cara\u003c/b> (FF, RF, RTJ);\u003c/li>\n    \u003cli>leer lo que lleva grabado una brida;\u003c/li>\n    \u003cli>apretar una brida \u003cb>en cruz\u003c/b> y en varias pasadas;\u003c/li>\n    \u003cli>saber para qué sirve cada tipo de \u003cb>válvula\u003c/b> y leer sus datos.\u003c/li>\n  \u003c/ul>\n\u003c/section>\n\n\u003c!-- ============ UNIÓN BRIDADA ============ -->\n\u003csection id=\"brida\">\n  \u003ch2>La unión bridada\u003c/h2>\n  \u003cdiv class=\"en10\">Una unión con bridas tiene \u003cb>tres cosas\u003c/b>: dos \u003cb>bridas\u003c/b>, una \u003cb>junta\u003c/b> entre ellas y los \u003cb>espárragos con sus tuercas\u003c/b> que lo aprietan todo.\u003c/div>\n  \u003cdiv class=\"explode\" id=\"ub\">\n    \u003csvg viewBox=\"0 0 400 220\" role=\"img\" aria-labelledby=\"ubT\">\n      \u003ctitle id=\"ubT\">Corte de una unión bridada: dos tubos, dos bridas de cuello, una junta y dos espárragos con tuercas.\u003c/title>\n      \u003crect width=\"400\" height=\"220\" fill=\"var(--card)\"/>\n      \u003cline x1=\"10\" y1=\"110\" x2=\"390\" y2=\"110\" stroke=\"var(--ink2)\" stroke-dasharray=\"10 4 2 4\"/>\n      \u003cg class=\"part\" data-k=\"0\" tabindex=\"0\" role=\"button\" aria-label=\"Tubos\">\u003cg class=\"hl\" fill=\"var(--steel-soft)\" stroke=\"var(--steel)\" stroke-width=\"2\">\u003crect x=\"10\" y=\"80\" width=\"100\" height=\"10\"/>\u003crect x=\"10\" y=\"130\" width=\"100\" height=\"10\"/>\u003crect x=\"290\" y=\"80\" width=\"100\" height=\"10\"/>\u003crect x=\"290\" y=\"130\" width=\"100\" height=\"10\"/>\u003c/g>\u003c/g>\n      \u003cg class=\"part\" data-k=\"1\" tabindex=\"0\" role=\"button\" aria-label=\"Bridas\">\u003cg class=\"hl\" fill=\"var(--arc-soft)\" stroke=\"var(--arc)\" stroke-width=\"2\">\u003cpath d=\"M114 80 L160 62 V20 H190 V90 H114 Z\"/>\u003cpath d=\"M114 140 L160 158 V200 H190 V130 H114 Z\"/>\u003cpath d=\"M286 80 L240 62 V20 H210 V90 H286 Z\"/>\u003cpath d=\"M286 140 L240 158 V200 H210 V130 H286 Z\"/>\u003c/g>\u003c/g>\n      \u003cg class=\"part\" data-k=\"2\" tabindex=\"0\" role=\"button\" aria-label=\"Junta\">\u003cg class=\"hl\" fill=\"var(--molten-soft)\" stroke=\"var(--molten)\" stroke-width=\"2\">\u003crect x=\"193\" y=\"62\" width=\"14\" height=\"28\"/>\u003crect x=\"193\" y=\"130\" width=\"14\" height=\"28\"/>\u003c/g>\u003c/g>\n      \u003cg class=\"part\" data-k=\"3\" tabindex=\"0\" role=\"button\" aria-label=\"Espárragos y tuercas\">\u003cg class=\"hl\" fill=\"var(--gas-soft)\" stroke=\"var(--gas)\" stroke-width=\"2\">\u003crect x=\"140\" y=\"30\" width=\"120\" height=\"10\"/>\u003crect x=\"140\" y=\"180\" width=\"120\" height=\"10\"/>\u003crect x=\"146\" y=\"22\" width=\"12\" height=\"26\"/>\u003crect x=\"242\" y=\"22\" width=\"12\" height=\"26\"/>\u003crect x=\"146\" y=\"172\" width=\"12\" height=\"26\"/>\u003crect x=\"242\" y=\"172\" width=\"12\" height=\"26\"/>\u003c/g>\u003c/g>\n      \u003cg class=\"part\" data-k=\"4\" tabindex=\"0\" role=\"button\" aria-label=\"Soldaduras\">\u003cg class=\"hl\" fill=\"var(--molten)\" stroke=\"var(--molten)\">\u003cpath d=\"M108 78 L116 78 L114 90 L110 90 Z\"/>\u003cpath d=\"M108 142 L116 142 L114 130 L110 130 Z\"/>\u003cpath d=\"M284 78 L292 78 L290 90 L286 90 Z\"/>\u003cpath d=\"M284 142 L292 142 L290 130 L286 130 Z\"/>\u003c/g>\u003c/g>\n    \u003c/svg>\n    \u003cdiv class=\"info\" id=\"ubInfo\" aria-live=\"polite\">\u003cp class=\"muted\">Toca una parte del dibujo.\u003c/p>\u003c/div>\n  \u003c/div>\n  \u003cdiv class=\"callout gas\">\u003ch4>¿Dónde hay bridas?\u003c/h4>\u003cp>En las \u003cb>boquillas\u003c/b> (o tubuladuras, toberas) de los equipos: depósitos, bombas, intercambiadores. En las \u003cb>válvulas\u003c/b>. Y donde haga falta \u003cb>desmontar\u003c/b> un tramo para limpiarlo o revisarlo. En el resto, se suelda: cada brida es un sitio por donde puede haber una fuga.\u003c/p>\u003c/div>\n  \u003cdiv class=\"recuerda\">\u003ch4>Lo que tienes que recordar\u003c/h4>\u003cul>\n    \u003cli>Brida + junta + espárragos = unión desmontable.\u003c/li>\n    \u003cli>Se usa en equipos, válvulas y tramos que hay que desmontar.\u003c/li>\n  \u003c/ul>\u003c/div>\n\u003c/section>\n\n\u003c!-- ============ TIPOS ============ -->\n\u003csection id=\"tipos\" style=\"--c:var(--gas)\">\n  \u003ch2>Tipos de brida y dónde se sueldan\u003c/h2>\n  \u003cdiv class=\"en10\">La brida se une al tubo de distintas formas. Las más usadas: de \u003cb>cuello (WN)\u003c/b>, a tope; \u003cb>deslizante (SO)\u003c/b>, con dos cordones de ángulo; y de \u003cb>enchufe (SW)\u003c/b>. La \u003cb>ciega\u003c/b> cierra una línea.\u003c/div>\n  \u003cdiv class=\"diagram\" id=\"bt\">\n    \u003csvg viewBox=\"0 0 400 170\" role=\"img\" aria-labelledby=\"btT\" id=\"btSvg\">\u003ctitle id=\"btT\">Medio corte de la brida elegida soldada al tubo. En naranja, las soldaduras.\u003c/title>\u003c/svg>\n    \u003cdiv class=\"tabs\" id=\"btTabs\">\u003c/div>\n    \u003cdiv class=\"panel\" id=\"btPanel\">\u003c/div>\n  \u003c/div>\n  \u003cfigure>\n    \u003cdiv class=\"imgbox zoomable\">\u003cimg id=\"f-so\" src=\"data:image/jpeg;base64,\" alt=\"Corte de una brida slip-on soldada al tubo con una soldadura exterior y otra interior.\">\u003c/div>\n    \u003cfigcaption>\u003cb>Fuente: presentación «6.0 Piping (Básico)», diap. 58.\u003c/b> Así se suelda una brida deslizante (slip-on): \u003cb>soldadura exterior\u003c/b> y \u003cb>soldadura interior\u003c/b>.\u003c/figcaption>\n  \u003c/figure>\n  \u003cdiv class=\"recuerda\" style=\"--c:var(--gas)\">\u003ch4>Lo que tienes que recordar\u003c/h4>\u003cul>\n    \u003cli>WN = a tope (1 soldadura). La más resistente.\u003c/li>\n    \u003cli>SO = 2 cordones de ángulo (fuera y dentro).\u003c/li>\n    \u003cli>SW = 1 cordón por fuera, con holgura en el fondo.\u003c/li>\n    \u003cli>Ciega = tapa con agujeros. Loca = gira libre sobre un collarín.\u003c/li>\n  \u003c/ul>\u003c/div>\n\u003c/section>\n\n\u003c!-- ============ CLASE ============ -->\n\u003csection id=\"clase\" style=\"--c:var(--molten)\">\n  \u003ch2>La clase: cuánta presión aguanta\u003c/h2>\n  \u003cdiv class=\"en10\">Igual que el tubo tiene schedule, la brida tiene \u003cb>clase\u003c/b> (en inglés \u003ci>class\u003c/i> o \u003ci>rating\u003c/i>). Las clases son \u003cb>150, 300, 400, 600, 900, 1500 y 2500\u003c/b>. Más clase = brida \u003cb>más gruesa\u003c/b> y \u003cb>más presión\u003c/b>.\u003c/div>\n  \u003cfigure>\n    \u003cdiv class=\"imgbox zoomable\">\u003cimg id=\"f-cl\" src=\"data:image/jpeg;base64,\" alt=\"Cuatro bridas para tubo de 3 pulgadas: clase 150, 400, 900 y 2500; cuanto más clase, más grande y gruesa es la brida.\">\u003c/div>\n    \u003cfigcaption>\u003cb>Fuente: presentación «6.0 Piping (Básico)», diap. 55.\u003c/b> Cuatro bridas para el mismo tubo de 3\": clase 150, 400, 900 y 2500. El tubo y el agujero son iguales; la brida crece.\u003c/figcaption>\n  \u003c/figure>\n  \u003cul class=\"list\">\n    \u003cli>Se escribe 150#, 150 lb o «clase 150». El símbolo \u003cb>#\u003c/b> quiere decir libras.\u003c/li>\n    \u003cli>Dos bridas que se unen tienen que ser de la \u003cb>misma clase\u003c/b> y del \u003cb>mismo NPS\u003c/b>: si no, los agujeros no coinciden.\u003c/li>\n    \u003cli>Las normas alemanas (DIN) y europeas usan la \u003cb>PN\u003c/b> (presión nominal, en bar): PN 6, 10, 16, 25, 40, 64, 100… No son intercambiables con las ASME.\u003c/li>\n  \u003c/ul>\n  \u003cdiv class=\"ext\">\n    \u003cspan class=\"tag\">Ampliación con fuentes externas\u003c/span>\n    \u003ch3>La clase no es «la presión máxima»\u003c/h3>\n    \u003cp>«Clase 150» no quiere decir que aguante 150 psi siempre. La norma \u003cb>ASME B16.5\u003c/b> da, para cada material, una \u003cb>tabla de presión y temperatura\u003c/b>: al subir la temperatura, la brida aguanta menos. Por ejemplo, una brida de acero al carbono (grupo 1.1) de clase 150 aguanta unos \u003cb>19,6 bar a temperatura ambiente\u003c/b>, pero solo unos \u003cb>13,8 bar a 200 °C\u003c/b>. Por eso la clase la elige el ingeniero con la presión \u003cb>y\u003c/b> la temperatura del fluido.\u003c/p>\n  \u003c/div>\n  \u003cdiv class=\"recuerda\" style=\"--c:var(--molten)\">\u003ch4>Lo que tienes que recordar\u003c/h4>\u003cul>\n    \u003cli>Clase = rating = serie. 150, 300, 600…\u003c/li>\n    \u003cli>Más clase: más gruesa, más tornillos o más gordos, más presión.\u003c/li>\n    \u003cli>Las dos bridas de una unión: misma clase y mismo NPS.\u003c/li>\n  \u003c/ul>\u003c/div>\n\u003c/section>\n\n\u003c!-- ============ CARAS Y JUNTAS ============ -->\n\u003csection id=\"caras\">\n  \u003ch2>Caras y juntas\u003c/h2>\n  \u003cdiv class=\"en10\">La \u003cb>cara\u003c/b> es la parte de la brida donde apoya la junta. Puede ser \u003cb>plana (FF)\u003c/b>, \u003cb>con resalte (RF)\u003c/b> o \u003cb>con ranura para anillo (RTJ)\u003c/b>. La junta tiene que ser la que va con esa cara.\u003c/div>\n  \u003cdiv class=\"figsvg\">\u003cdiv class=\"diagram\">\n    \u003csvg viewBox=\"0 0 420 160\" role=\"img\" aria-labelledby=\"carT\">\n      \u003ctitle id=\"carT\">Medio corte de tres caras de brida: plana, con resalte y con ranura para anillo, con su junta.\u003c/title>\n      \u003cg fill=\"var(--arc-soft)\" stroke=\"var(--arc)\" stroke-width=\"2\">\n        \u003cpath d=\"M20 20 H60 V120 H20 Z\"/>\u003cpath d=\"M160 20 H190 V120 H160 Z M190 70 H198 V120 H190 Z\"/>\u003cpath d=\"M300 20 H330 V120 H300 Z M330 70 H340 V86 H330 Z M330 100 H340 V120 H330 Z\"/>\n      \u003c/g>\n      \u003crect x=\"60\" y=\"20\" width=\"8\" height=\"100\" fill=\"var(--molten-soft)\" stroke=\"var(--molten)\" stroke-width=\"2\"/>\n      \u003crect x=\"198\" y=\"70\" width=\"8\" height=\"50\" fill=\"var(--molten-soft)\" stroke=\"var(--molten)\" stroke-width=\"2\"/>\n      \u003cpath d=\"M332 86 h10 l4 4 v6 l-4 4 h-10 l-4 -4 v-6 Z\" fill=\"var(--molten)\" stroke=\"var(--molten)\"/>\n      \u003cg font-size=\"13\" font-weight=\"700\" text-anchor=\"middle\">\u003ctext x=\"45\" y=\"145\">FF · plana\u003c/text>\u003ctext x=\"185\" y=\"145\">RF · con resalte\u003c/text>\u003ctext x=\"330\" y=\"145\">RTJ · anillo\u003c/text>\u003c/g>\n      \u003ctext x=\"74\" y=\"40\" font-size=\"11\" style=\"fill:var(--molten)\">junta\u003c/text>\u003ctext x=\"210\" y=\"66\" font-size=\"11\" style=\"fill:var(--molten)\">junta\u003c/text>\u003ctext x=\"350\" y=\"80\" font-size=\"11\" style=\"fill:var(--molten)\">anillo\u003c/text>\n    \u003c/svg>\n  \u003c/div>\u003c/div>\n  \u003cdiv class=\"scroll\">\u003ctable>\n    \u003cthead>\u003ctr>\u003cth>Cara\u003c/th>\u003cth>Cómo es\u003c/th>\u003cth>Cuándo se usa\u003c/th>\u003c/tr>\u003c/thead>\n    \u003ctbody>\n      \u003ctr>\u003ctd>FF (flat face)\u003c/td>\u003ctd>Toda la cara plana. La junta cubre toda la cara.\u003c/td>\u003ctd>Presiones bajas; con equipos de fundición o de plástico, que se romperían con una RF.\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>RF (raised face)\u003c/td>\u003ctd>Un resalte en el centro donde apoya la junta.\u003c/td>\u003ctd>\u003cb>La más común.\u003c/b>\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>RTJ (ring type joint)\u003c/td>\u003ctd>Una ranura donde entra un anillo metálico.\u003c/td>\u003ctd>Alta presión y temperatura. La más cara.\u003c/td>\u003c/tr>\n    \u003c/tbody>\n  \u003c/table>\u003c/div>\n  \u003cp>La cara de la brida tiene unas \u003cb>estrías en espiral\u003c/b> muy finas (el acabado \u003ci>stock finish\u003c/i>, como los surcos de un disco de vinilo). Sirven para que la junta agarre. \u003cb>No las rayes\u003c/b>: no la apoyes en el suelo ni la limpies con la radial.\u003c/p>\n  \u003ch3>Las juntas\u003c/h3>\n  \u003cul class=\"list\">\n    \u003cli>\u003cb>Planas no metálicas\u003c/b>: de fibra, grafito o goma. Para servicios suaves (agua, aire).\u003c/li>\n    \u003cli>\u003cb>Espirometálicas\u003c/b>: una espiral de acero con relleno blando (grafito o PTFE), con \u003cb>anillo exterior\u003c/b> que la centra y a veces \u003cb>anillo interior\u003c/b>. Para vapor, hidrocarburos, temperaturas altas.\u003c/li>\n    \u003cli>\u003cb>Encamisadas\u003c/b>: relleno blando con una «camisa» de metal por fuera.\u003c/li>\n    \u003cli>\u003cb>Anillos RTJ\u003c/b>: metálicos, de sección \u003cb>octogonal u oval\u003c/b>. Para las bridas RTJ.\u003c/li>\n  \u003c/ul>\n  \u003cfigure>\n    \u003cdiv class=\"imgbox zoomable\">\u003cimg id=\"f-je\" src=\"data:image/jpeg;base64,\" alt=\"Junta espirometálica con lo que lleva grabado: norma ASME B16.20, diámetro y clase, fabricante, material del anillo interior y de la espiral.\">\u003c/div>\n    \u003cfigcaption>\u003cb>Fuente: presentación «6.0 Piping (Básico)», diap. 60.\u003c/b> Lo que lleva escrito una junta espirometálica: norma (ASME B16.20), diámetro y clase, fabricante, materiales de la espiral, del relleno y de los anillos.\u003c/figcaption>\n  \u003c/figure>\n  \u003cdiv class=\"callout hot\">\u003ch4>La junta, siempre nueva\u003c/h4>\u003cp>Una junta que ya se ha apretado está \u003cb>aplastada\u003c/b>: no vuelve a sellar. Al desmontar una brida, \u003cb>se tira la junta\u003c/b> y se pone una nueva del mismo tipo, diámetro y clase.\u003c/p>\u003c/div>\n  \u003cdiv class=\"terms\">\n    \u003ch4>Tornillería\u003c/h4>\n    \u003cdl>\n      \u003cdt>Espárrago (stud bolt)\u003c/dt>\u003cdd>Varilla roscada en toda su longitud con \u003cb>dos tuercas\u003c/b>. Es lo normal en las bridas de tubería industrial.\u003c/dd>\n      \u003cdt>Tornillo (bolt)\u003c/dt>\u003cdd>Con cabeza y una tuerca. Se usa poco, en bridas pequeñas y de baja presión.\u003c/dd>\n      \u003cdt>Arandelas\u003c/dt>\u003cdd>En las bridas industriales normalmente \u003cb>no\u003c/b> se ponen.\u003c/dd>\n    \u003c/dl>\n  \u003c/div>\n  \u003cdiv class=\"recuerda\">\u003ch4>Lo que tienes que recordar\u003c/h4>\u003cul>\n    \u003cli>RF es la cara más común. RTJ para alta presión.\u003c/li>\n    \u003cli>No rayes la cara de la brida.\u003c/li>\n    \u003cli>Junta nueva cada vez que se desmonta.\u003c/li>\n    \u003cli>Espárragos con dos tuercas, sin arandelas.\u003c/li>\n  \u003c/ul>\u003c/div>\n\u003c/section>\n\n\u003c!-- ============ MARCADO ============ -->\n\u003csection id=\"marcado\" style=\"--c:var(--warn)\">\n  \u003ch2>Lo que lleva escrito una brida\u003c/h2>\n  \u003cdiv class=\"en10\">Toda brida (y todo accesorio) lleva grabados sus datos. Saber leerlos evita montar una pieza equivocada.\u003c/div>\n  \u003cfigure>\n    \u003cdiv class=\"imgbox zoomable\">\u003cimg id=\"f-mb\" src=\"data:image/jpeg;base64,\" alt=\"Brida de cuello con siete marcas grabadas en el borde, numeradas del 1 al 7.\">\u003c/div>\n    \u003cfigcaption>\u003cb>Fuente: presentación «6.0 Piping (Básico)», diap. 78.\u003c/b> Las siete marcas de una brida, numeradas.\u003c/figcaption>\n  \u003c/figure>\n  \u003col class=\"steps\">\n    \u003cli>\u003cspan>\u003cb>Fabricante\u003c/b>: su nombre o logotipo.\u003c/span>\u003c/li>\n    \u003cli>\u003cspan>\u003cb>Material\u003c/b> según ASTM. Ej.: \u003cb>A105N\u003c/b> (acero al carbono forjado; la N es «normalizado», un tratamiento térmico).\u003c/span>\u003c/li>\n    \u003cli>\u003cspan>\u003cb>Norma\u003c/b> de la brida. Ej.: \u003cb>B16\u003c/b> (ASME B16.5).\u003c/span>\u003c/li>\n    \u003cli>\u003cspan>\u003cb>Cara\u003c/b>. Ej.: \u003cb>RF\u003c/b>.\u003c/span>\u003c/li>\n    \u003cli>\u003cspan>\u003cb>Clase y NPS\u003c/b>. Ej.: \u003cb>150 / 6\u003c/b> = clase 150, brida de 6\".\u003c/span>\u003c/li>\n    \u003cli>\u003cspan>\u003cb>Schedule\u003c/b> del tubo al que se suelda (solo en WN y SW). Ej.: \u003cb>SCH 40\u003c/b>.\u003c/span>\u003c/li>\n    \u003cli>\u003cspan>\u003cb>Número de colada\u003c/b>: identifica el lote de acero. Ej.: 23/J5. Sirve para rastrear la pieza (trazabilidad).\u003c/span>\u003c/li>\n  \u003c/ol>\n  \u003cdiv class=\"callout shop\">\u003ch4>Apunta la colada\u003c/h4>\u003cp>En muchas obras hay que anotar el \u003cb>número de colada\u003c/b> de cada pieza que montas, para que se pueda saber de qué lote salió si un día falla. Si te lo piden, no te lo inventes: está grabado.\u003c/p>\u003c/div>\n\u003c/section>\n\n\u003c!-- ============ APRIETE ============ -->\n\u003csection id=\"apriete\">\n  \u003ch2>Apretar una brida: en cruz y por pasadas\u003c/h2>\n  \u003cdiv class=\"en10\">Los espárragos se aprietan \u003cb>en cruz\u003c/b> (uno y el de enfrente) y en \u003cb>varias vueltas\u003c/b>, subiendo poco a poco: a mano, 30 %, 70 % y 100 % del par. Así la junta se aplasta igual por todos lados.\u003c/div>\n  \u003cdiv class=\"calc\" id=\"cruz\">\n    \u003ch3>Sigue el orden\u003c/h3>\n    \u003cdiv class=\"row\">\n      \u003clabel for=\"nb\">Nº de espárragos\u003cselect id=\"nb\" style=\"font:inherit;padding:.4rem;border-radius:8px;border:1.5px solid var(--line);background:var(--paper);color:var(--ink)\">\u003coption>4\u003c/option>\u003coption selected>8\u003c/option>\u003coption>12\u003c/option>\u003c/select>\u003c/label>\n      \u003cbutton class=\"btn\" type=\"button\" id=\"cNext\">Siguiente\u003c/button>\n      \u003cbutton class=\"btn ghost\" type=\"button\" id=\"cReset\">Empezar\u003c/button>\n    \u003c/div>\n    \u003csvg viewBox=\"0 0 260 260\" role=\"img\" aria-label=\"Brida vista de frente con sus espárragos; se van numerando en el orden de apriete.\" id=\"cruzSvg\">\u003c/svg>\n    \u003cdiv class=\"out\" id=\"cruzOut\">\u003c/div>\n  \u003c/div>\n  \u003cdiv class=\"scroll\">\u003ctable>\n    \u003cthead>\u003ctr>\u003cth>Pasada\u003c/th>\u003cth>Cuánto se aprieta\u003c/th>\u003c/tr>\u003c/thead>\n    \u003ctbody>\n      \u003ctr>\u003ctd>1.ª\u003c/td>\u003ctd>Aproximar las tuercas, a mano si se puede, sin apretar.\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>2.ª\u003c/td>\u003ctd>30 % del par de apriete.\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>3.ª\u003c/td>\u003ctd>70 % del par.\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>4.ª\u003c/td>\u003ctd>100 % del par.\u003c/td>\u003c/tr>\n    \u003c/tbody>\n  \u003c/table>\u003c/div>\n  \u003cfigure>\n    \u003cdiv class=\"imgbox zoomable\">\u003cimg id=\"f-cz\" src=\"data:image/jpeg;base64,\" alt=\"Tres bridas vistas de frente con 8, 12 y 16 espárragos numerados en el orden de apriete en cruz.\">\u003c/div>\n    \u003cfigcaption>\u003cb>Fuente: «Manual práctico del tubero», CIFO Tarragona, pág. 40.\u003c/b> Orden de apriete en cruz para 8, 12 y 16 espárragos.\u003c/figcaption>\n  \u003c/figure>\n  \u003cul class=\"list\">\n    \u003cli>Empieza la cruz por la parte de la brida que \u003cb>más abierta\u003c/b> esté.\u003c/li>\n    \u003cli>El par (en N·m) se comprueba con \u003cb>llave dinamométrica\u003c/b>. El valor lo da el procedimiento.\u003c/li>\n    \u003cli>Pon \u003cb>lubricante antigripaje\u003c/b> en la rosca y bajo la tuerca: si no, la llave marca el par pero el espárrago no tira lo que debe.\u003c/li>\n    \u003cli>Para alinear agujeros se usa la \u003cb>parpalina\u003c/b> (barra con punta). Nunca el dedo.\u003c/li>\n  \u003c/ul>\n  \u003cdiv class=\"callout danger\">\u003ch4>Si aprietas en círculo, fuga segura\u003c/h4>\u003cp>Si aprietas los espárragos uno detrás de otro alrededor, la brida se cierra de un lado y se abre del otro. La junta queda pellizcada por un lado y floja por el otro. Fuga en la prueba… o con el fluido caliente.\u003c/p>\u003c/div>\n  \u003cdiv class=\"recuerda\">\u003ch4>Lo que tienes que recordar\u003c/h4>\u003cul>\n    \u003cli>En cruz: uno y el de enfrente.\u003c/li>\n    \u003cli>Por pasadas: mano → 30 % → 70 % → 100 %.\u003c/li>\n    \u003cli>Llave dinamométrica y antigripaje.\u003c/li>\n  \u003c/ul>\u003c/div>\n\u003c/section>\n\n\u003c!-- ============ VÁLVULAS ============ -->\n\u003csection id=\"valvulas\" style=\"--c:var(--arc)\">\n  \u003ch2>Válvulas: para qué sirve cada una\u003c/h2>\n  \u003cdiv class=\"en10\">Una válvula sirve para \u003cb>cortar\u003c/b> el paso, \u003cb>regular\u003c/b> el caudal, \u003cb>impedir que vuelva\u003c/b> el fluido o \u003cb>proteger\u003c/b> contra sobrepresión. Cada tipo hace bien una de esas cosas.\u003c/div>\n  \u003cdiv class=\"scroll\">\u003ctable>\n    \u003cthead>\u003ctr>\u003cth>Función\u003c/th>\u003cth>Qué hace\u003c/th>\u003cth>Válvulas típicas\u003c/th>\u003c/tr>\u003c/thead>\n    \u003ctbody>\n      \u003ctr>\u003ctd>Aislamiento (corte)\u003c/td>\u003ctd>Todo abierto o todo cerrado\u003c/td>\u003ctd>Compuerta, bola, macho, mariposa\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>Regulación\u003c/td>\u003ctd>Dejar pasar más o menos caudal\u003c/td>\u003ctd>Globo, mariposa, diafragma\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>Retención\u003c/td>\u003ctd>Dejar pasar en un solo sentido\u003c/td>\u003ctd>Retención (anti-retorno, check)\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>Seguridad\u003c/td>\u003ctd>Abrir sola si la presión sube demasiado\u003c/td>\u003ctd>Válvula de seguridad o de alivio\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>Control\u003c/td>\u003ctd>Regular sola, mandada por un sistema automático\u003c/td>\u003ctd>Válvula de control (con actuador)\u003c/td>\u003c/tr>\n    \u003c/tbody>\n  \u003c/table>\u003c/div>\n  \u003cdiv class=\"diagram\" id=\"vv\">\n    \u003cdiv class=\"tabs\" id=\"vTabs\" style=\"border-top:0\">\u003c/div>\n    \u003cdiv class=\"panel\" id=\"vPanel\" aria-live=\"polite\">\u003c/div>\n  \u003c/div>\n  \u003cdiv hidden>\u003cimg id=\"V-compuerta\" src=\"data:image/jpeg;base64,\" alt=\"\">\u003cimg id=\"V-globo\" src=\"data:image/jpeg;base64,\" alt=\"\">\u003cimg id=\"V-check\" src=\"data:image/jpeg;base64,\" alt=\"\">\u003cimg id=\"V-bola\" src=\"data:image/jpeg;base64,\" alt=\"\">\u003cimg id=\"V-mariposa\" src=\"data:image/jpeg;base64,\" alt=\"\">\u003cimg id=\"V-seguridad\" src=\"data:image/jpeg;base64,\" alt=\"\">\u003c/div>\n  \u003cp class=\"muted small\">Fotos y cortes de la presentación «6.2 Válvulas (y Equipos)» del módulo, diapositivas 5 a 10 y 30. Los símbolos son dibujos propios a partir de la diapositiva 33.\u003c/p>\n  \u003cdiv class=\"callout hot\">\u003ch4>Mira la flecha\u003c/h4>\u003cp>Las válvulas de \u003cb>globo\u003c/b> y de \u003cb>retención\u003c/b> tienen sentido: llevan una \u003cb>flecha en el cuerpo\u003c/b>. Si la montas al revés, la de retención no deja pasar nada y la de globo trabaja mal. Antes de presentarla, busca la flecha y compárala con el sentido del fluido en el plano.\u003c/p>\u003c/div>\n  \u003cdiv class=\"recuerda\">\u003ch4>Lo que tienes que recordar\u003c/h4>\u003cul>\n    \u003cli>Compuerta: cortar. Globo: regular. Retención: un solo sentido.\u003c/li>\n    \u003cli>Bola, macho y mariposa: cuarto de vuelta.\u003c/li>\n    \u003cli>Seguridad: abre sola por sobrepresión. No se toca.\u003c/li>\n    \u003cli>Globo y retención: respeta la flecha.\u003c/li>\n  \u003c/ul>\u003c/div>\n\u003c/section>\n\n\u003c!-- ============ CARACTERÍSTICAS ============ -->\n\u003csection id=\"caracteristicas\" style=\"--c:var(--gas)\">\n  \u003ch2>Los cuatro datos de una válvula\u003c/h2>\n  \u003cdiv class=\"en10\">Para pedir una válvula hacen falta cuatro datos: \u003cb>tamaño\u003c/b> (size), \u003cb>paso\u003c/b> (port), \u003cb>extremos\u003c/b> (ends) y \u003cb>presión\u003c/b> (rating).\u003c/div>\n  \u003cdiv class=\"scroll\">\u003ctable>\n    \u003cthead>\u003ctr>\u003cth>Dato\u003c/th>\u003cth>Qué es\u003c/th>\u003cth>Ejemplo\u003c/th>\u003c/tr>\u003c/thead>\n    \u003ctbody>\n      \u003ctr>\u003ctd>Tamaño (size)\u003c/td>\u003ctd>El NPS de la tubería donde va\u003c/td>\u003ctd>4\"\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>Paso (port)\u003c/td>\u003ctd>El agujero real por donde pasa el fluido. \u003cb>Total\u003c/b> (full port, igual que el tubo) o \u003cb>reducido\u003c/b> (standard port, más pequeño).\u003c/td>\u003ctd>Full port\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>Extremos (ends)\u003c/td>\u003ctd>Cómo se une: roscada (TH), enchufe (SW), a tope (BW) o con bridas (y la cara: RF, FF, RTJ)\u003c/td>\u003ctd>Bridas RF\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>Presión (rating)\u003c/td>\u003ctd>La clase, como en las bridas\u003c/td>\u003ctd>Clase 300\u003c/td>\u003c/tr>\n    \u003c/tbody>\n  \u003c/table>\u003c/div>\n  \u003cdiv class=\"callout key\">\u003ch4>Ejemplo de la presentación\u003c/h4>\u003cp>Válvula de compuerta: \u003cb>size ½\"\u003c/b>, \u003cb>full port\u003c/b>, \u003cb>rating 4500 lb\u003c/b>, \u003cb>ends socket-weld\u003c/b>. En castellano: válvula de compuerta de ½\", paso total, clase 4500, para soldar con enchufe.\u003c/p>\u003c/div>\n  \u003cdiv class=\"recuerda\" style=\"--c:var(--gas)\">\u003ch4>Lo que tienes que recordar\u003c/h4>\u003cul>\n    \u003cli>Size · port · ends · rating.\u003c/li>\n    \u003cli>Paso total = mismo agujero que el tubo. Paso reducido = más pequeño.\u003c/li>\n  \u003c/ul>\u003c/div>\n\u003c/section>\n\n\u003c!-- ============ IDEAS CLAVE ============ -->\n\u003csection id=\"ideas\">\n  \u003ch2>Ideas clave\u003c/h2>\n  \u003cp class=\"lead\">Si recuerdas esto, montarás bridas y válvulas sin fugas.\u003c/p>\n  \u003col class=\"keys\">\n    \u003cli>Unión bridada = \u003cb>2 bridas + junta + espárragos\u003c/b>. Se usa donde hay que desmontar.\u003c/li>\n    \u003cli>\u003cb>WN\u003c/b> a tope; \u003cb>SO\u003c/b> con dos cordones de ángulo; \u003cb>SW\u003c/b> con un cordón y holgura.\u003c/li>\n    \u003cli>La \u003cb>clase\u003c/b> (150, 300, 600…) es como el schedule de la brida. Las dos bridas, iguales.\u003c/li>\n    \u003cli>Cara \u003cb>RF\u003c/b> la más común. No rayes la cara.\u003c/li>\n    \u003cli>\u003cb>Junta nueva\u003c/b> cada vez que se desmonta.\u003c/li>\n    \u003cli>Lee lo grabado: material, norma, cara, clase, NPS, schedule y \u003cb>colada\u003c/b>.\u003c/li>\n    \u003cli>Apriete \u003cb>en cruz\u003c/b> y por pasadas: mano, 30 %, 70 %, 100 %.\u003c/li>\n    \u003cli>Compuerta corta, globo regula, retención en un sentido, seguridad protege. \u003cb>Mira la flecha\u003c/b>.\u003c/li>\n  \u003c/ol>\n  \u003ch3>Comprueba lo que has aprendido\u003c/h3>\n  \u003cdiv class=\"quiz\" id=\"quiz\">\u003c/div>\n  \u003cdiv class=\"nextblock\">\n    \u003ca href=\"TUB_2_Accesorios.html\">\u003csmall>Anterior\u003c/small>\u003cb>← Bloque 2 · Accesorios\u003c/b>\u003c/a>\n    \u003ca class=\"next\" href=\"TUB_4_Isometricos.html\">\u003csmall>Siguiente\u003c/small>\u003cb>Bloque 4 · Isométricos →\u003c/b>\u003c/a>\n  \u003c/div>\n\u003c/section>\n\n\u003cfooter>\n  \u003cp style=\"margin:0 0 1rem\">\u003cb>Recurso elaborado por Xurxo.\u003c/b> Serie Tubería · Bloque 3 de 5.\u003c/p>\n  \u003cdetails>\n    \u003csummary>Fuentes y diferencias entre ellas\u003c/summary>\n    \u003cdiv class=\"in\">\n      \u003cp>\u003cb>Documentos del módulo\u003c/b>\u003c/p>\n      \u003cul>\n        \u003cli>\u003cb>Presentación «6.0 Piping (Básico)»\u003c/b>, actividades sobre accesorios (bridas, clases ASME B16.5 y PN, caras RF, FF y RTJ, stock finish, juntas, tornillería, marcado de una brida). Figuras de las diapositivas 55, 58, 60 y 78.\u003c/li>\n        \u003cli>\u003cb>Presentación «6.2 Válvulas (y Equipos)»\u003c/b>: funciones, tipos, características (size, port, ends, rating) y símbolos. Fotos de las diapositivas 5 a 10 y 30.\u003c/li>\n        \u003cli>\u003cb>«Manual práctico del tubero»\u003c/b>, CIFO Tarragona (2012), págs. 32 a 41: válvulas, bridas, clases, caras, apriete en cruz (pág. 40, figura).\u003c/li>\n      \u003c/ul>\n      \u003cp>\u003cb>Fuentes externas\u003c/b>\u003c/p>\n      \u003cul class=\"src\">\n        \u003cli>ASME B16.5, tablas de presión y temperatura (grupo 1.1, acero al carbono A105). Tabla en Engineering ToolBox: \u003ca href=\"https://www.engineeringtoolbox.com/steel-flanges-pressure-rating-d_49.html\">engineeringtoolbox.com/steel-flanges-pressure-rating-d_49.html\u003c/a>\u003c/li>\n      \u003c/ul>\n      \u003cp>\u003cb>Diferencias detectadas\u003c/b>\u003c/p>\n      \u003cul>\n        \u003cli>\u003cb>Número de agujeros.\u003c/b> El manual dice «150 libras (4 orificios), 300 libras (8 orificios)». No es así siempre: el número de espárragos depende del \u003cb>diámetro y\u003c/b> de la clase (una brida de 4\" clase 150 ya lleva 8). Aquí no se da esa regla.\u003c/li>\n        \u003cli>\u003cb>Clase y presión.\u003c/b> La presentación pide completar «Rating o clase es la máxima presión que…» y dice «150 # = 150 PSI». Es una buena forma de recordarla, pero la presión que aguanta depende de la temperatura y del material (ver la ampliación). Se explican las dos cosas.\u003c/li>\n        \u003cli>\u003cb>Nombres de las válvulas.\u003c/b> Retención = anti-retorno = contraflujo = check. Globo = asiento. Se usan «retención» y «globo» y se dan los demás.\u003c/li>\n      \u003c/ul>\n      \u003cp class=\"small\">Los dibujos sin pie de fuente son esquemas propios. Toca una imagen para ampliarla.\u003c/p>\n    \u003c/div>\n  \u003c/details>\n\u003c/footer>\n\n\u003c/main>\n\n\u003cdiv class=\"lb\" id=\"lb\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Figura ampliada\">\n  \u003cdiv class=\"top\">\u003cspan>Desliza para moverte por la figura\u003c/span>\u003cbutton type=\"button\" id=\"lbClose\">Cerrar\u003c/button>\u003c/div>\n  \u003cdiv class=\"pan\">\u003cimg id=\"lbImg\" alt=\"\">\u003c/div>\n\u003c/div>\n\n\u003cscript>\nwindow.QUIZ=[\n  {q:\"¿Qué tres cosas forman una unión bridada?\",o:[\"Dos bridas, una junta y los espárragos\",\"Una brida, un codo y una válvula\",\"Dos bridas y un cordón de soldadura\"],a:0,\n   e:\"Dos bridas, la junta en medio y los espárragos con sus tuercas.\"},\n  {q:\"¿Qué brida se suelda al tubo a tope, con una sola soldadura de penetración completa?\",o:[\"Slip-on (SO)\",\"Welding neck (WN)\",\"Loca\"],a:1,\n   e:\"La de cuello (WN) se suelda a tope. Es la más resistente.\"},\n  {q:\"¿Cuántos cordones lleva una brida slip-on?\",o:[\"Uno, a tope\",\"Dos de ángulo: uno por fuera y otro por dentro\",\"Ninguno, va roscada\"],a:1,\n   e:\"La SO se desliza sobre el tubo y se suelda por fuera y por dentro.\"},\n  {q:\"Vas a unir una brida de 4\\\" clase 300 con otra. ¿Cómo tiene que ser la otra?\",o:[\"4\\\" y clase 300\",\"4\\\" de cualquier clase\",\"De cualquier tamaño si es clase 300\"],a:0,\n   e:\"Mismo NPS y misma clase. Si no, no coinciden los agujeros ni la junta.\"},\n  {q:\"Has desmontado una brida para cambiar una válvula. ¿Qué haces con la junta?\",o:[\"La limpio y la vuelvo a poner\",\"La tiro y pongo una nueva igual\",\"Pongo dos para que selle mejor\"],a:1,\n   e:\"Una junta apretada queda aplastada y no vuelve a sellar. Siempre nueva.\"},\n  {q:\"Brida de 8 espárragos. Has apretado el 1. ¿Cuál va después?\",o:[\"El que está al lado del 1\",\"El que está enfrente del 1\",\"Cualquiera\"],a:1,\n   e:\"En cruz: después del 1 va el de enfrente. Así la brida cierra paralela.\"},\n  {q:\"¿Qué válvula pones para regular el caudal?\",o:[\"Compuerta\",\"Globo\",\"Retención\"],a:1,\n   e:\"La de globo regula. La de compuerta es para todo o nada; si la dejas a medias se desgasta.\"},\n  {q:\"Una válvula de retención tiene una flecha en el cuerpo. ¿Qué indica?\",o:[\"El sentido en que debe ir el fluido\",\"Hacia dónde va el volante\",\"Nada importante\"],a:0,\n   e:\"La retención solo deja pasar en un sentido. Montada al revés, bloquea la línea.\"}\n];\n\u003c/script>\n\u003cscript