(--card);border:1px solid var(--line);border-radius:12px;padding:.8rem 1rem 1rem}\n.diag ol{margin:.5rem 0 0;padding-left:1.3rem}.diag li{margin:.45rem 0}\n.diag .go{font-weight:700}\n/* lista de comprobación */\n.check{list-style:none;padding:0;margin:1rem 0;display:grid;gap:.45rem}\n.check label{display:flex;gap:.7rem;align-items:flex-start;padding:.65rem .85rem;border:1px solid var(--line);border-radius:8px;background:var(--card);cursor:pointer}\n.check input{flex:none;width:1.35rem;height:1.35rem;margin:.1rem 0 0;accent-color:var(--gas)}\n.check label:has(input:checked){background:var(--gas-soft);border-color:var(--gas)}\n.check-status{font-weight:700;color:var(--gas)}\n/* quiz: barra de resultado e imagen */\n.meter{height:.7rem;border-radius:99px;background:var(--steel-soft);overflow:hidden;margin:.4rem 0}\n.meter span{display:block;height:100%;background:var(--gas)}\n.qfig{margin:0 0 .8rem;padding:.4rem;background:#fff;border:1px solid var(--line);border-radius:8px;text-align:center}\n.qfig img,.qfig svg{max-width:100%;max-height:15rem;height:auto}\n/* tabla de colores */\n.sw{display:inline-block;width:1.1rem;height:1.1rem;border-radius:3px;vertical-align:-.2rem;margin-right:.35rem;border:1px solid rgba(0,0,0,.3)}\n.big-num{font:700 2.4rem/1 \"Barlow Condensed\",sans-serif;color:var(--arc)}\n\n/* ===== Añadidos serie MONTAJE ===== */\n/* portada con dibujo en vez de foto */\n.hero svg.bg{display:block;width:100%;height:min(62vh,420px)}\n/* calculadoras y deslizadores */\n.calc{margin:1.2rem 0;background:var(--card);border:1px solid var(--line);border-radius:10px;padding:.9rem 1rem 1rem}\n.calc h3{margin:.1rem 0 .5rem}\n.calc .row{display:flex;flex-wrap:wrap;gap:.6rem 1rem;align-items:end;margin:.4rem 0}\n.calc label{display:flex;flex-direction:column;gap:.25rem;font-size:.92rem;font-weight:700;color:var(--ink2)}\n.calc input[type=number]{font:inherit;font-size:1.1rem;width:7.5rem;padding:.45rem .6rem;border-radius:8px;border:1.5px solid var(--line);background:var(--paper);color:var(--ink)}\n.calc input[type=range]{width:100%;accent-color:var(--arc);min-height:2rem}\n.calc .out{margin:.7rem 0 0;padding:.7rem .9rem;border-radius:8px;background:var(--steel-soft)}\n.calc .out.ok{background:var(--gas-soft)}.calc .out.bad{background:var(--molten-soft)}\n.calc .out b.big{font:700 1.7rem \"Barlow Condensed\",sans-serif}\n.calc svg{display:block;width:100%;max-width:26rem;margin:.4rem auto 0;height:auto}\n/* buscador de palabras */\n.gloss input{font:inherit;width:100%;padding:.6rem .8rem;border-radius:8px;border:1.5px solid var(--line);background:var(--paper);color:var(--ink)}\n.gloss table{margin-top:.6rem}\n.gloss td:first-child{width:45%}\n/* paso a paso con dibujo */\n.stepper{margin:1.3rem 0;background:var(--card);border:1px solid var(--line);border-radius:10px;overflow:hidden}\n.stepper svg{display:block;width:100%;height:auto;background:var(--steel-soft)}\n.stepper .ctrl{display:flex;justify-content:space-between;align-items:center;gap:.5rem;padding:.6rem .9rem;border-top:1px solid var(--line)}\n.stepper .ctrl span{font-weight:700;color:var(--ink2)}\n.stepper .txt{padding:.1rem 1.1rem 1rem}\n.stepper .txt h3{margin:.7rem 0 .3rem;color:var(--arc)}\n.btn.ghost{background:var(--paper);color:var(--ink);border:1.5px solid var(--line)}\n.btn:disabled{opacity:.4;cursor:default}\n.st{transition:opacity .35s}.st.hide{opacity:0}.st.new .hl{filter:drop-shadow(0 0 4px #FF9A2E)}\n\n\u003c/style>\n\u003cstyle>\n.calc select{font:inherit;font-size:1.05rem;padding:.45rem .6rem;border-radius:8px;border:1.5px solid var(--line);background:var(--paper);color:var(--ink);min-width:7.5rem}\n.facts.three{grid-template-columns:repeat(auto-fit,minmax(8rem,1fr))}\n\u003c/style>\n\u003c/head>\n\u003cbody>\n\u003cheader class=\"topnav\" id=\"topnav\">\n  \u003cdiv class=\"bar\" id=\"bar\">\u003c/div>\n  \u003cnav class=\"blocknav\" aria-label=\"Bloques de tubería\">\n    \u003ca href=\"TUB_0_Portada.html\">Portada\u003c/a>\n    \u003ca href=\"TUB_1_Tuberia.html\" class=\"cur\" aria-current=\"page\">1 La tubería\u003c/a>\n    \u003ca href=\"TUB_2_Accesorios.html\">2 Accesorios\u003c/a>\n    \u003ca href=\"TUB_3_Bridas_Valvulas.html\">3 Bridas y válvulas\u003c/a>\n    \u003ca href=\"TUB_4_Isometricos.html\">4 Isométricos\u003c/a>\n    \u003ca href=\"TUB_5_Taller.html\">5 Al taller\u003c/a>\n  \u003c/nav>\n  \u003cnav class=\"chips\" id=\"chips\" aria-label=\"Secciones\">\n    \u003ca href=\"#inicio\">Inicio\u003c/a>\n    \u003ca href=\"#que-es\">Qué es\u003c/a>\n    \u003ca href=\"#materiales\">Materiales\u003c/a>\n    \u003ca href=\"#fabricacion\">Fabricación\u003c/a>\n    \u003ca href=\"#nps\">El diámetro\u003c/a>\n    \u003ca href=\"#schedule\">El schedule\u003c/a>\n    \u003ca href=\"#tabla\">Calculadora\u003c/a>\n    \u003ca href=\"#extremos\">Extremos\u003c/a>\n    \u003ca href=\"#ideas\">Ideas clave\u003c/a>\n  \u003c/nav>\n\u003c/header>\n\n\u003cdiv class=\"hero\" id=\"inicio\">\n  \u003csvg class=\"bg\" viewBox=\"0 0 800 420\" preserveAspectRatio=\"xMidYMid slice\" role=\"img\" aria-label=\"Dibujo: tres secciones de tubo del mismo diámetro exterior con distinto espesor.\">\n    \u003crect width=\"800\" height=\"420\" fill=\"#16314F\"/>\n    \u003cg fill=\"none\">\u003ccircle cx=\"200\" cy=\"190\" r=\"95\" stroke=\"#C9D6E3\" stroke-width=\"12\"/>\u003ccircle cx=\"400\" cy=\"190\" r=\"89\" stroke=\"#C9D6E3\" stroke-width=\"24\"/>\u003ccircle cx=\"600\" cy=\"190\" r=\"81\" stroke=\"#C9D6E3\" stroke-width=\"40\"/>\u003c/g>\n    \u003cg stroke=\"#FFB27A\" stroke-width=\"2\" stroke-dasharray=\"7 5\">\u003cline x1=\"80\" y1=\"190\" x2=\"720\" y2=\"190\"/>\u003c/g>\n    \u003cg font-size=\"22\" font-weight=\"700\" text-anchor=\"middle\">\u003ctext x=\"200\" y=\"330\" style=\"fill:#E8EEF5\">SCH 40\u003c/text>\u003ctext x=\"400\" y=\"330\" style=\"fill:#E8EEF5\">SCH 80\u003c/text>\u003ctext x=\"600\" y=\"330\" style=\"fill:#E8EEF5\">SCH 160\u003c/text>\u003c/g>\n  \u003c/svg>\n  \u003cdiv class=\"txt wrap\">\n    \u003ch1>Bloque 1. La tubería\u003c/h1>\n    \u003cp class=\"sub\">Qué es, de qué está hecha y cómo se pide en el almacén.\u003c/p>\n    \u003cp class=\"ctx\">CFGM Soldadura y Calderería · Montaje de tubería\u003c/p>\n    \u003cp class=\"ctx\" style=\"margin-top:.3rem\">\u003cb>Autor: Xurxo\u003c/b>\u003c/p>\n  \u003c/div>\n\u003c/div>\n\n\u003cmain class=\"wrap\">\n\n\u003csection id=\"intro\">\n  \u003cp class=\"lead\">Antes de cortar y soldar un tubo tienes que saber \u003cb>pedirlo\u003c/b>. En el almacén nadie te entiende si pides «un tubo gordo». Te van a preguntar tres cosas: \u003cb>qué diámetro\u003c/b>, \u003cb>qué espesor\u003c/b> y \u003cb>de qué material\u003c/b>.\u003c/p>\n  \u003ch3>Al terminar sabrás\u003c/h3>\n  \u003cul class=\"list\">\n    \u003cli>explicar qué es una tubería industrial y para qué sirve;\u003c/li>\n    \u003cli>nombrar los materiales más usados y las formas de fabricar tubo de acero;\u003c/li>\n    \u003cli>entender por qué un tubo de 1\" no mide 1\";\u003c/li>\n    \u003cli>leer el \u003cb>schedule\u003c/b> (el espesor) y sacar de una tabla el diámetro exterior, el interior y el peso;\u003c/li>\n    \u003cli>reconocer los extremos de un tubo: liso, biselado o roscado.\u003c/li>\n  \u003c/ul>\n  \u003cp class=\"muted small\">Primero de cinco bloques: \u003cb>1 La tubería\u003c/b> → 2 Accesorios → 3 Bridas y válvulas → 4 Isométricos → 5 Al taller. Fuentes principales: las presentaciones de Piping del módulo, el «Manual práctico del tubero» (CIFO Tarragona) y el catálogo de Tubasol. Las cajas con borde discontinuo traen información de otras fuentes.\u003c/p>\n\u003c/section>\n\n\u003c!-- ============ QUÉ ES ============ -->\n\u003csection id=\"que-es\">\n  \u003ch2>Qué es una tubería\u003c/h2>\n  \u003cdiv class=\"en10\">Una tubería es un \u003cb>conducto cerrado\u003c/b> que lleva un \u003cb>fluido\u003c/b> (líquido, gas o vapor) de un sitio a otro. Lleva tubos, \u003cb>accesorios\u003c/b>, \u003cb>bridas\u003c/b>, \u003cb>válvulas\u003c/b> y \u003cb>soportes\u003c/b>. En inglés, todo esto se llama \u003ci>piping\u003c/i>.\u003c/div>\n\n  \u003cdiv class=\"analogy\">\u003cspan class=\"ico\">≈\u003c/span>\u003cp>\u003cb>Es como la fontanería de tu casa, pero a lo bestia:\u003c/b> más presión, más temperatura, fluidos peligrosos y diámetros de hasta más de un metro. Por eso todo está normalizado y todo se comprueba.\u003c/p>\u003c/div>\n\n  \u003cdiv class=\"two\">\n    \u003cdiv class=\"box\">\u003ch3 style=\"color:var(--arc)\">Líneas de proceso\u003c/h3>\u003cul>\n      \u003cli>Llevan el \u003cb>producto\u003c/b> que fabrica la planta.\u003c/li>\n      \u003cli>Ejemplos: petróleo, gasolina, ácido sulfúrico, leche, cerveza.\u003c/li>\n    \u003c/ul>\u003c/div>\n    \u003cdiv class=\"box\">\u003ch3 style=\"color:var(--gas)\">Líneas de servicio\u003c/h3>\u003cul>\n      \u003cli>Llevan lo que la planta \u003cb>necesita para funcionar\u003c/b>.\u003c/li>\n      \u003cli>Ejemplos: agua de refrigeración, vapor, aire comprimido, nitrógeno, agua contra incendios.\u003c/li>\n      \u003cli>En inglés: \u003ci>utilities\u003c/i>.\u003c/li>\n    \u003c/ul>\u003c/div>\n  \u003c/div>\n\n  \u003cdiv class=\"terms\">\n    \u003ch4>Palabras del taller\u003c/h4>\n    \u003cdl>\n      \u003cdt>Tubería (pipe, piping)\u003c/dt>\u003cdd>El tubo de las instalaciones industriales. Se nombra por un diámetro «nominal» y un espesor (schedule).\u003c/dd>\n      \u003cdt>Tubo fino (tubing)\u003c/dt>\u003cdd>Tubo pequeño de instrumentación (manómetros, aire de control). Se nombra por su diámetro exterior real. No lo estudiamos aquí.\u003c/dd>\n      \u003cdt>Línea\u003c/dt>\u003cdd>Un tramo de tubería con un número propio en los planos. Lleva el mismo fluido de principio a fin.\u003c/dd>\n      \u003cdt>Carrete (spool)\u003c/dt>\u003cdd>Trozo de tubería ya cortado y soldado con sus accesorios, que sale del taller listo para montar.\u003c/dd>\n    \u003c/dl>\n  \u003c/div>\n  \u003cdiv class=\"recuerda\">\u003ch4>Lo que tienes que recordar\u003c/h4>\u003cul>\n    \u003cli>Tubería = conducto cerrado para fluidos (piping).\u003c/li>\n    \u003cli>Proceso = el producto. Servicio = agua, vapor, aire…\u003c/li>\n    \u003cli>Un carrete es una pieza de tubería hecha en el taller.\u003c/li>\n  \u003c/ul>\u003c/div>\n\u003c/section>\n\n\u003c!-- ============ MATERIALES ============ -->\n\u003csection id=\"materiales\" style=\"--c:var(--gas)\">\n  \u003ch2>De qué está hecha\u003c/h2>\n  \u003cdiv class=\"en10\">Hay tuberías \u003cb>metálicas\u003c/b> y \u003cb>no metálicas\u003c/b>. En el taller de soldadura trabajarás sobre todo con \u003cb>acero al carbono\u003c/b> y \u003cb>acero inoxidable\u003c/b>.\u003c/div>\n  \u003cdiv class=\"scroll\">\u003ctable>\n    \u003cthead>\u003ctr>\u003cth>Grupo\u003c/th>\u003cth>Ejemplos\u003c/th>\u003cth>Dónde se usa\u003c/th>\u003c/tr>\u003c/thead>\n    \u003ctbody>\n      \u003ctr>\u003ctd>Metálicas férreas\u003c/td>\u003ctd>Acero al carbono, acero aleado (al cromo-molibdeno), acero inoxidable, fundición\u003c/td>\u003ctd>Casi toda la industria: vapor, petróleo, química, alimentación (inox)\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>Metálicas no férreas\u003c/td>\u003ctd>Cobre, latón, aluminio, plomo\u003c/td>\u003ctd>Instalaciones pequeñas, frío, gases especiales\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>No metálicas\u003c/td>\u003ctd>PVC, polietileno, polipropileno, plástico con fibra de vidrio, vidrio, hormigón\u003c/td>\u003ctd>Agua, ácidos, laboratorios (vidrio), saneamiento\u003c/td>\u003c/tr>\n    \u003c/tbody>\n  \u003c/table>\u003c/div>\n  \u003cdiv class=\"callout gas\">\u003ch4>El material va escrito en el tubo\u003c/h4>\u003cp>Cada tubo y cada accesorio llevan grabada la \u003cb>norma del material\u003c/b>. Por ejemplo, \u003cb>A106 Gr. B\u003c/b> o \u003cb>A53\u003c/b> son aceros al carbono para tubo; \u003cb>A312 TP316L\u003c/b> es tubo de inoxidable. Nunca mezcles un accesorio de acero al carbono en una línea de inoxidable: se corroe y falla.\u003c/p>\u003c/div>\n  \u003cdiv class=\"recuerda\" style=\"--c:var(--gas)\">\u003ch4>Lo que tienes que recordar\u003c/h4>\u003cul>\n    \u003cli>Acero al carbono e inoxidable: lo que más vas a soldar.\u003c/li>\n    \u003cli>El material va grabado en el tubo. Compruébalo antes de soldar.\u003c/li>\n  \u003c/ul>\u003c/div>\n\u003c/section>\n\n\u003c!-- ============ FABRICACIÓN ============ -->\n\u003csection id=\"fabricacion\">\n  \u003ch2>Cómo se fabrica el tubo de acero\u003c/h2>\n  \u003cdiv class=\"en10\">Hay dos formas: \u003cb>sin soldadura\u003c/b> (se agujerea un tocho de acero al rojo) y \u003cb>con soldadura\u003c/b> (se enrolla una chapa y se suelda). El tubo sin soldadura aguanta más presión.\u003c/div>\n  \u003cdiv class=\"two\">\n    \u003cdiv class=\"box\">\u003ch3 style=\"color:var(--arc)\">Sin soldadura (seamless)\u003c/h3>\n      \u003csvg viewBox=\"0 0 260 110\" role=\"img\" aria-label=\"Un tocho macizo se perfora con un mandril y se convierte en tubo.\">\u003crect x=\"10\" y=\"35\" width=\"70\" height=\"40\" rx=\"4\" fill=\"var(--molten-soft)\" stroke=\"var(--molten)\" stroke-width=\"2\"/>\u003cpath d=\"M90 55 h30\" stroke=\"var(--ink2)\" stroke-width=\"2\" marker-end=\"url(#ar1)\"/>\u003cdefs>\u003cmarker id=\"ar1\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\">\u003cpath d=\"M0 0 L10 5 L0 10 Z\" fill=\"var(--ink2)\"/>\u003c/marker>\u003c/defs>\u003crect x=\"130\" y=\"35\" width=\"120\" height=\"40\" rx=\"4\" fill=\"var(--molten-soft)\" stroke=\"var(--molten)\" stroke-width=\"2\"/>\u003crect x=\"130\" y=\"47\" width=\"120\" height=\"16\" fill=\"var(--card)\" stroke=\"var(--molten)\"/>\u003ctext x=\"16\" y=\"98\" font-size=\"11\">tocho al rojo\u003c/text>\u003ctext x=\"150\" y=\"98\" font-size=\"11\">tubo sin costura\u003c/text>\u003c/svg>\n      \u003cul>\u003cli>Un tocho caliente se perfora y se estira con un \u003cb>mandril\u003c/b>.\u003c/li>\u003cli>No tiene costura: es el que se usa para \u003cb>alta presión\u003c/b>.\u003c/li>\u003c/ul>\u003c/div>\n    \u003cdiv class=\"box\">\u003ch3 style=\"color:var(--molten)\">Con soldadura\u003c/h3>\n      \u003csvg viewBox=\"0 0 260 110\" role=\"img\" aria-label=\"Una chapa se curva y se suelda: costura recta o en espiral.\">\u003crect x=\"10\" y=\"30\" width=\"110\" height=\"50\" rx=\"4\" fill=\"var(--steel-soft)\" stroke=\"var(--steel)\" stroke-width=\"2\"/>\u003cline x1=\"10\" y1=\"55\" x2=\"120\" y2=\"55\" stroke=\"var(--molten)\" stroke-width=\"3\"/>\u003crect x=\"140\" y=\"30\" width=\"110\" height=\"50\" rx=\"4\" fill=\"var(--steel-soft)\" stroke=\"var(--steel)\" stroke-width=\"2\"/>\u003cpath d=\"M150 80 L175 30 M180 80 L205 30 M210 80 L235 30\" stroke=\"var(--molten)\" stroke-width=\"3\"/>\u003ctext x=\"18\" y=\"100\" font-size=\"11\">costura recta\u003c/text>\u003ctext x=\"148\" y=\"100\" font-size=\"11\">costura en espiral\u003c/text>\u003c/svg>\n      \u003cul>\u003cli>\u003cb>Costura longitudinal\u003c/b>: la chapa se curva y se suelda a lo largo.\u003c/li>\u003cli>\u003cb>Costura en espiral\u003c/b> (helicoidal): para diámetros muy grandes.\u003c/li>\u003c/ul>\u003c/div>\n  \u003c/div>\n  \u003cp>El tubo de acero se sirve en barras de \u003cb>6 m\u003c/b> o de \u003cb>12 m\u003c/b>. Tenlo en cuenta al planificar cortes: lo que sobra es dinero.\u003c/p>\n  \u003cdiv class=\"callout shop\">\u003ch4>En el taller\u003c/h4>\u003cp>Si el tubo tiene costura, al presentar dos tramos \u003cb>no pongas las costuras en línea\u003c/b>: gíralas para que queden separadas. Y si vas a hacer un injerto, que no caiga encima de la costura.\u003c/p>\u003c/div>\n  \u003cdiv class=\"recuerda\">\u003ch4>Lo que tienes que recordar\u003c/h4>\u003cul>\n    \u003cli>Sin soldadura = alta presión.\u003c/li>\n    \u003cli>Con soldadura: recta o en espiral.\u003c/li>\n    \u003cli>Barras de 6 o 12 m.\u003c/li>\n  \u003c/ul>\u003c/div>\n\u003c/section>\n\n\u003c!-- ============ NPS ============ -->\n\u003csection id=\"nps\" style=\"--c:var(--molten)\">\n  \u003ch2>El diámetro: pulgadas que no miden una pulgada\u003c/h2>\n  \u003cdiv class=\"en10\">El tamaño de una tubería se da con un \u003cb>diámetro nominal\u003c/b>: un «nombre», no una medida. En pulgadas se llama \u003cb>NPS\u003c/b>; en milímetros, \u003cb>DN\u003c/b>. Un tubo de 1\" mide \u003cb>33,4 mm\u003c/b> por fuera, no 25,4.\u003c/div>\n\n  \u003cdiv class=\"principle\">\n    \u003cdiv class=\"p1\">\u003cb>NPS\u003c/b> (Nominal Pipe Size): tamaño en pulgadas. Ej.: NPS 4\".\u003c/div>\n    \u003cdiv class=\"p2\">\u003cb>DN\u003c/b> (diámetro nominal): el mismo tamaño en milímetros «redondos». Ej.: DN 100.\u003c/div>\n    \u003cdiv class=\"p3\">\u003cb>Diámetro exterior\u003c/b>: la medida real por fuera. Es \u003cb>siempre la misma\u003c/b> para un NPS, sea cual sea el espesor. Ej.: NPS 4\" → 114,3 mm.\u003c/div>\n  \u003c/div>\n\n  \u003cdiv class=\"calc\" id=\"nomCalc\">\n    \u003ch3>Compara el nombre con la medida real\u003c/h3>\n    \u003clabel for=\"nomSel\">Elige un NPS\u003c/label>\n    \u003cselect id=\"nomSel\">\u003c/select>\n    \u003csvg viewBox=\"0 0 300 170\" role=\"img\" aria-label=\"Círculo del diámetro exterior real comparado con un círculo discontinuo del diámetro nominal en milímetros.\" id=\"nomSvg\">\u003c/svg>\n    \u003cdiv class=\"out\" id=\"nomOut\">\u003c/div>\n  \u003c/div>\n\n  \u003cul class=\"list\">\n    \u003cli>\u003cb>Hasta 12\"\u003c/b>: el diámetro exterior es \u003cb>mayor\u003c/b> que el nominal.\u003c/li>\n    \u003cli>\u003cb>Desde 14\"\u003c/b>: el diámetro exterior \u003cb>es igual\u003c/b> al nominal (14\" = 355,6 mm = 14 × 25,4).\u003c/li>\n  \u003c/ul>\n  \u003cdiv class=\"analogy\">\u003cspan class=\"ico\">≈\u003c/span>\u003cp>\u003cb>Es como la talla de la ropa:\u003c/b> una camiseta «M» no mide «M» centímetros. Es un nombre. Para saber la medida real, miras la tabla.\u003c/p>\u003c/div>\n  \u003cdiv class=\"callout hot\">\u003ch4>Cuidado al medir con el calibre\u003c/h4>\u003cp>Si mides un tubo y te da 60,3 mm, \u003cb>no es de 60 mm\u003c/b>: es de \u003cb>2\"\u003c/b> (DN 50). Busca siempre la medida exterior en la tabla para saber qué NPS tienes en la mano.\u003c/p>\u003c/div>\n  \u003cdiv class=\"recuerda\" style=\"--c:var(--molten)\">\u003ch4>Lo que tienes que recordar\u003c/h4>\u003cul>\n    \u003cli>NPS (pulgadas) y DN (mm) son nombres, no medidas.\u003c/li>\n    \u003cli>El diámetro exterior es fijo para cada NPS.\u003c/li>\n    \u003cli>Hasta 12\": exterior mayor que el nombre. Desde 14\": igual.\u003c/li>\n  \u003c/ul>\u003c/div>\n\u003c/section>\n\n\u003c!-- ============ SCHEDULE ============ -->\n\u003csection id=\"schedule\">\n  \u003ch2>El schedule: el espesor\u003c/h2>\n  \u003cdiv class=\"en10\">El \u003cb>schedule\u003c/b> (SCH, «programa de fabricación») indica el \u003cb>espesor de la pared\u003c/b>. Más schedule = \u003cb>más espesor\u003c/b> = más presión aguanta. Como el exterior no cambia, el \u003cb>diámetro interior se hace más pequeño\u003c/b>.\u003c/div>\n  \u003cfigure>\n    \u003cdiv class=\"imgbox zoomable\">\u003cimg id=\"f-sch\" src=\"data:image/jpeg;base64,\" alt=\"Tres tubos morados de NPS 4 pulgadas con su brida amarilla: Schedule 40, 80 y 160. Por fuera son iguales; cambia el espesor.\">\u003c/div>\n    \u003cfigcaption>\u003cb>Fuente: presentación «6.0 Piping (Básico)» del módulo, diap. 29.\u003c/b> Tres tubos de NPS 4\": el exterior es el mismo, el espesor (schedule) cambia.\u003c/figcaption>\n  \u003c/figure>\n  \u003cfigure>\n    \u003cdiv class=\"imgbox zoomable\">\u003cimg id=\"f-std\" src=\"data:image/jpeg;base64,\" alt=\"Tres secciones de tubo de 6 pulgadas: Standard weight, Extra strong y Double extra strong. El diámetro exterior es 6,625 pulgadas en los tres; el interior se reduce.\">\u003c/div>\n    \u003cfigcaption>\u003cb>Fuente: presentación «6.0 Piping (Básico)», diap. 28.\u003c/b> Tubo de 6\" (6,625\" = 168,3 mm por fuera) en STD, XS y XXS. O.D. = diámetro exterior. I.D. = diámetro interior.\u003c/figcaption>\n  \u003c/figure>\n\n  \u003ch3>Las dos formas de nombrar el espesor\u003c/h3>\n  \u003cdiv class=\"scroll\">\u003ctable>\n    \u003cthead>\u003ctr>\u003cth>Forma\u003c/th>\u003cth>Valores\u003c/th>\u003cth>Equivale más o menos a\u003c/th>\u003c/tr>\u003c/thead>\n    \u003ctbody>\n      \u003ctr>\u003ctd>Número de schedule (acero al carbono y aleado)\u003c/td>\u003ctd>10, 20, 30, \u003cb>40\u003c/b>, 60, \u003cb>80\u003c/b>, 100, 120, 140, \u003cb>160\u003c/b>\u003c/td>\u003ctd>—\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>Número con «S» (acero inoxidable)\u003c/td>\u003ctd>5S, 10S, 40S, 80S\u003c/td>\u003ctd>40S ≈ 40 y 80S ≈ 80 en los tamaños pequeños\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>Por «peso» (las tres clásicas)\u003c/td>\u003ctd>\u003cb>STD\u003c/b> (estándar), \u003cb>XS\u003c/b> (extra fuerte), \u003cb>XXS\u003c/b> (doble extra fuerte)\u003c/td>\u003ctd>STD ≈ SCH 40 · XS ≈ SCH 80 · XXS: grueso, a veces más que 160\u003c/td>\u003c/tr>\n    \u003c/tbody>\n  \u003c/table>\u003c/div>\n  \u003cdiv class=\"callout key\">\u003ch4>«Más o menos» quiere decir que no siempre\u003c/h4>\u003cp>STD y SCH 40 son \u003cb>iguales hasta 10\"\u003c/b>. Desde 12\" ya no: un 12\" STD tiene 9,53 mm y un 12\" SCH 40 tiene 10,31 mm. Lo mismo pasa con XS y SCH 80 desde 10\". Por eso, \u003cb>mira siempre la tabla\u003c/b>.\u003c/p>\u003c/div>\n  \u003cdiv class=\"recuerda\">\u003ch4>Lo que tienes que recordar\u003c/h4>\u003cul>\n    \u003cli>Schedule = espesor. Más SCH, más grueso.\u003c/li>\n    \u003cli>El exterior no cambia: lo que se estrecha es el interior.\u003c/li>\n    \u003cli>STD ≈ 40, XS ≈ 80. Comprueba en la tabla.\u003c/li>\n  \u003c/ul>\u003c/div>\n\u003c/section>\n\n\u003c!-- ============ CALCULADORA ============ -->\n\u003csection id=\"tabla\" style=\"--c:var(--gas)\">\n  \u003ch2>Busca tu tubo en la tabla\u003c/h2>\n  \u003cdiv class=\"en10\">Con el \u003cb>NPS\u003c/b> y el \u003cb>schedule\u003c/b> la tabla te da todo: diámetro exterior, espesor, diámetro interior y \u003cb>peso por metro\u003c/b>. Pruébalo aquí.\u003c/div>\n  \u003cdiv class=\"calc\" id=\"schCalc\">\n    \u003cdiv class=\"row\">\n      \u003clabel for=\"sN\">NPS\u003cselect id=\"sN\">\u003c/select>\u003c/label>\n      \u003clabel for=\"sS\">Schedule\u003cselect id=\"sS\">\u003coption>40\u003c/option>\u003coption>STD\u003c/option>\u003coption>80\u003c/option>\u003coption>XS\u003c/option>\u003coption>160\u003c/option>\u003coption>XXS\u003c/option>\u003c/select>\u003c/label>\n      \u003clabel for=\"sL\">Largo (m)\u003cinput id=\"sL\" type=\"number\" min=\"0\" step=\"0.1\" value=\"6\">\u003c/label>\n    \u003c/div>\n    \u003csvg viewBox=\"0 0 300 220\" role=\"img\" aria-label=\"Sección del tubo elegido, dibujada a escala, con el espesor de la pared.\" id=\"schSvg\">\u003c/svg>\n    \u003cdiv class=\"facts three\" id=\"schFacts\">\u003c/div>\n    \u003cdiv class=\"out\" id=\"schOut\">\u003c/div>\n  \u003c/div>\n  \u003cp class=\"muted small\">Datos de la norma ASME B36.10 (los mismos que trae el catálogo de Tubasol, pág. 76). El peso se calcula con la fórmula del acero: kg/m = 0,02466 × e × (De − e), con medidas en mm.\u003c/p>\n  \u003cdiv class=\"ext\">\n    \u003cspan class=\"tag\">Ampliación con fuentes externas\u003c/span>\n    \u003ch3>La fórmula del peso, por si no tienes tabla\u003c/h3>\n    \u003cp>Para tubo de \u003cb>acero\u003c/b>: \u003cb>kg/m = 0,02466 × espesor × (Ø exterior − espesor)\u003c/b>, todo en mm. El 0,02466 sale de la densidad del acero (7,85 kg/dm³) por π. Ejemplo: 1\" SCH 40 → 0,02466 × 3,38 × (33,4 − 3,38) = \u003cb>2,50 kg/m\u003c/b>, igual que en la tabla.\u003c/p>\n  \u003c/div>\n  \u003cdiv class=\"callout shop\">\u003ch4>En el móvil\u003c/h4>\u003cp>Hay aplicaciones gratuitas de tablas de tubería (por ejemplo \u003cb>Pipedata\u003c/b> o \u003cb>Piping Toolbox\u003c/b>, que recomiendan los apuntes). Útiles en el taller, pero aprende a leer la tabla en papel: en el examen y en la obra no siempre hay móvil.\u003c/p>\u003c/div>\n  \u003cdiv class=\"recuerda\" style=\"--c:var(--gas)\">\u003ch4>Lo que tienes que recordar\u003c/h4>\u003cul>\n    \u003cli>Con NPS + schedule, la tabla te da exterior, espesor, interior y peso.\u003c/li>\n    \u003cli>Peso por metro × metros = lo que vas a mover. Más de 25 kg, con ayuda.\u003c/li>\n  \u003c/ul>\u003c/div>\n\u003c/section>\n\n\u003c!-- ============ EXTREMOS ============ -->\n\u003csection id=\"extremos\">\n  \u003ch2>Los extremos del tubo\u003c/h2>\n  \u003cdiv class=\"en10\">El tubo se pide con el extremo preparado para su unión: \u003cb>liso (PE)\u003c/b>, \u003cb>biselado (BE)\u003c/b> o \u003cb>roscado (T&amp;C)\u003c/b>.\u003c/div>\n  \u003cdiv class=\"figsvg\">\u003cdiv class=\"diagram\">\n    \u003csvg viewBox=\"0 0 420 150\" role=\"img\" aria-labelledby=\"extT\">\n      \u003ctitle id=\"extT\">Tres extremos de tubo en corte: liso, biselado con talón y roscado con su manguito.\u003c/title>\n      \u003cg fill=\"var(--steel-soft)\" stroke=\"var(--steel)\" stroke-width=\"2\">\n        \u003cpath d=\"M20 40 H110 V56 H20 Z M20 94 H110 V110 H20 Z\"/>\n        \u003cpath d=\"M300 40 H380 V56 H300 Z M300 94 H380 V110 H300 Z\"/>\n      \u003c/g>\n      \u003cpath d=\"M160 40 H240 L249 52 L252 52 L252 56 H160 Z\" fill=\"var(--steel-soft)\" stroke=\"var(--steel)\" stroke-width=\"2\"/>\n      \u003cpath d=\"M160 110 H240 L249 98 L252 98 L252 94 H160 Z\" fill=\"var(--steel-soft)\" stroke=\"var(--steel)\" stroke-width=\"2\"/>\n      \u003cg stroke=\"var(--ink2)\" stroke-width=\"1.5\">\u003cpath d=\"M340 40 l4 -4 l4 4 l4 -4 l4 4 l4 -4 l4 4 l4 -4 l4 4 l4 -4 l4 4 M340 110 l4 4 l4 -4 l4 4 l4 -4 l4 4 l4 -4 l4 4 l4 -4 l4 4 l4 -4\"/>\u003c/g>\n      \u003crect x=\"355\" y=\"26\" width=\"50\" height=\"12\" fill=\"var(--gas-soft)\" stroke=\"var(--gas)\"/>\u003crect x=\"355\" y=\"112\" width=\"50\" height=\"12\" fill=\"var(--gas-soft)\" stroke=\"var(--gas)\"/>\n      \u003cg font-size=\"13\" font-weight=\"700\" text-anchor=\"middle\">\u003ctext x=\"65\" y=\"138\">PE · liso\u003c/text>\u003ctext x=\"205\" y=\"138\">BE · biselado\u003c/text>\u003ctext x=\"350\" y=\"138\">T&amp;C · roscado\u003c/text>\u003c/g>\n      \u003ctext x=\"236\" y=\"28\" font-size=\"11\">bisel\u003c/text>\n    \u003c/svg>\n  \u003c/div>\u003c/div>\n  \u003cdiv class=\"scroll\">\u003ctable>\n    \u003cthead>\u003ctr>\u003cth>Extremo\u003c/th>\u003cth>Qué es\u003c/th>\u003cth>Para qué unión\u003c/th>\u003c/tr>\u003c/thead>\n    \u003ctbody>\n      \u003ctr>\u003ctd>PE (plain end)\u003c/td>\u003ctd>Corte recto, sin preparar\u003c/td>\u003ctd>Enchufe y soldadura (socket-weld). Tubos pequeños.\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>BE (bevelled end)\u003c/td>\u003ctd>Bisel para soldar a tope\u003c/td>\u003ctd>Soldadura a tope (butt-weld). Desde 2\" más o menos.\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>T&amp;C (threaded and coupled)\u003c/td>\u003ctd>Roscado, con un manguito\u003c/td>\u003ctd>Uniones roscadas. Tubos pequeños y presiones bajas.\u003c/td>\u003c/tr>\n    \u003c/tbody>\n  \u003c/table>\u003c/div>\n  \u003cdiv class=\"ext\">\n    \u003cspan class=\"tag\">Ampliación con fuentes externas\u003c/span>\n    \u003ch3>Cómo es el bisel normalizado\u003c/h3>\n    \u003cp>La norma \u003cb>ASME B16.25\u003c/b> fija el bisel para soldar tubo a tope: un ángulo de \u003cb>37,5°\u003c/b> y un \u003cb>talón\u003c/b> (la parte recta que queda abajo) de \u003cb>1,6 mm ± 0,8 mm\u003c/b>. Al juntar dos tubos queda una V de unos 75°. El tubo «BE» ya viene así de fábrica; si cortas, el bisel lo haces tú con la biseladora o la radial.\u003c/p>\n  \u003c/div>\n  \u003cdiv class=\"recuerda\">\u003ch4>Lo que tienes que recordar\u003c/h4>\u003cul>\n    \u003cli>PE = liso → enchufe (SW).\u003c/li>\n    \u003cli>BE = biselado → a tope (BW).\u003c/li>\n    \u003cli>T&amp;C = roscado → rosca (TH).\u003c/li>\n  \u003c/ul>\u003c/div>\n\u003c/section>\n\n\u003c!-- ============ IDEAS CLAVE ============ -->\n\u003csection id=\"ideas\">\n  \u003ch2>Ideas clave\u003c/h2>\n  \u003cp class=\"lead\">Si recuerdas esto, sabes pedir y reconocer un tubo.\u003c/p>\n  \u003col class=\"keys\">\n    \u003cli>Tubería = conducto para fluidos con tubos, accesorios, bridas, válvulas y soportes (\u003cb>piping\u003c/b>).\u003c/li>\n    \u003cli>Lo que más soldarás: \u003cb>acero al carbono\u003c/b> e \u003cb>inoxidable\u003c/b>. El material va grabado.\u003c/li>\n    \u003cli>Tubo \u003cb>sin soldadura\u003c/b> para alta presión; con costura recta o en espiral para lo demás.\u003c/li>\n    \u003cli>\u003cb>NPS\u003c/b> y \u003cb>DN\u003c/b> son nombres. La medida real es el \u003cb>diámetro exterior\u003c/b> de la tabla.\u003c/li>\n    \u003cli>El exterior es fijo para cada NPS. Hasta 12\" es mayor que el nombre; desde 14\", igual.\u003c/li>\n    \u003cli>\u003cb>Schedule = espesor\u003c/b>. Más SCH, más grueso y menos diámetro interior.\u003c/li>\n    \u003cli>STD ≈ SCH 40 y XS ≈ SCH 80, pero no en todos los tamaños: \u003cb>mira la tabla\u003c/b>.\u003c/li>\n    \u003cli>Extremos: \u003cb>PE\u003c/b> liso (enchufe), \u003cb>BE\u003c/b> biselado (a tope), \u003cb>T&amp;C\u003c/b> roscado.\u003c/li>\n  \u003c/ol>\n  \u003ch3>Comprueba lo que has aprendido\u003c/h3>\n  \u003cdiv class=\"quiz\" id=\"quiz\">\u003c/div>\n  \u003cdiv class=\"nextblock\">\n    \u003ca href=\"TUB_0_Portada.html\">\u003csmall>Volver\u003c/small>\u003cb>← Portada\u003c/b>\u003c/a>\n    \u003ca class=\"next\" href=\"TUB_2_Accesorios.html\">\u003csmall>Siguiente\u003c/small>\u003cb>Bloque 2 · Accesorios →\u003c/b>\u003c/a>\n  \u003c/div>\n\u003c/section>\n\n\u003cfooter>\n  \u003cp style=\"margin:0 0 1rem\">\u003cb>Recurso elaborado por Xurxo.\u003c/b> Serie Tubería · Bloque 1 de 5.\u003c/p>\n  \u003cdetails>\n    \u003csummary>Fuentes y diferencias entre ellas\u003c/summary>\n    \u003cdiv class=\"in\">\n      \u003cp>\u003cb>Documentos del módulo\u003c/b>\u003c/p>\n      \u003cul>\n        \u003cli>\u003cb>Presentación «6.0 Piping (Básico)»\u003c/b>: vocabulario, schedule (ANSI, ASME, ASTM), materiales, diámetro nominal, longitudes de suministro, extremos PE, T&amp;C y BE. Figuras de las diapositivas 28 y 29.\u003c/li>\n        \u003cli>\u003cb>«Manual práctico del tubero»\u003c/b>, A. Akkers, CIFO Tarragona (2012), cap. 3: el tubo y sus formas de fabricación.\u003c/li>\n        \u003cli>\u003cb>Catálogo Tubasol, División Petróleo/Química\u003c/b>, pág. 76: dimensiones y pesos de tubo de acero según ASME B36.10. De ahí salen los datos de la calculadora.\u003c/li>\n      \u003c/ul>\n      \u003cp>\u003cb>Fuentes externas\u003c/b>\u003c/p>\n      \u003cul class=\"src\">\n        \u003cli>ASME B16.25 «Buttwelding Ends»: bisel de 37,5° y talón de 1/16\" ± 1/32\". Resumen en Project Materials: \u003ca href=\"https://blog.projectmaterials.com/quick-answers/pipes/what-is-pipe-beveling/\">blog.projectmaterials.com/quick-answers/pipes/what-is-pipe-beveling\u003c/a>\u003c/li>\n        \u003cli>Fórmula del peso del tubo de acero (ASME B36.10, apartado de pesos): \u003ca href=\"https://www.engineeringtoolbox.com/steel-pipes-dimensions-d_43.html\">engineeringtoolbox.com/steel-pipes-dimensions-d_43.html\u003c/a>\u003c/li>\n      \u003c/ul>\n      \u003cp>\u003cb>Diferencias detectadas\u003c/b>\u003c/p>\n      \u003cul>\n        \u003cli>\u003cb>«Tubo» y «tubería».\u003c/b> La presentación llama «tubos» a los menores de 1/8\" (10 mm) y los aparta del estudio. En el taller se dice «tubo» a todo. Aquí usamos \u003cb>tubería (pipe)\u003c/b> para lo industrial y \u003cb>tubo fino (tubing)\u003c/b> para el de instrumentación, sin dar un límite exacto.\u003c/li>\n        \u003cli>\u003cb>Normas del schedule.\u003c/b> La presentación separa ANSI (números), ASME (STD, XS, XXS) y ASTM (XE, XXE, que no se usan). Hoy las dos primeras van juntas en la norma ASME B36.10 (acero al carbono) y B36.19 (inoxidable, con «S»). Se explican como dos formas de nombrar el espesor.\u003c/li>\n        \u003cli>\u003cb>Longitudes.\u003c/b> La presentación da 3 m para el inoxidable. Los almacenes lo sirven también en 6 m. Aquí solo se dan los 6 y 12 m del acero al carbono, que coinciden en todas las fuentes.\u003c/li>\n      \u003c/ul>\n      \u003cp class=\"small\">Los dibujos sin pie de fuente son esquemas propios. Toca una imagen para ampliarla.\u003c/p>\n    \u003c/div>\n  \u003c/details>\n\u003c/footer>\n\n\u003c/main>\n\n\u003cdiv class=\"lb\" id=\"lb\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Figura ampliada\">\n  \u003cdiv class=\"top\">\u003cspan>Desliza para moverte por la figura\u003c/span>\u003cbutton type=\"button\" id=\"lbClose\">Cerrar\u003c/button>\u003c/div>\n  \u003cdiv class=\"pan\">\u003cimg id=\"lbImg\" alt=\"\">\u003c/div>\n\u003c/div>\n\n\u003cscript>\nwindow.QUIZ=[\n  {q:\"¿Qué es una línea de servicio?\",o:[\"La que lleva el producto que fabrica la planta\",\"La que lleva lo que la planta necesita para funcionar: agua, vapor, aire…\",\"La que se monta la última\"],a:1,\n   e:\"Las líneas de proceso llevan el producto. Las de servicio (utilities) llevan agua, vapor, aire comprimido, nitrógeno…\"},\n  {q:\"Mides un tubo con el calibre y da 33,4 mm por fuera. ¿Qué tubo es?\",o:[\"DN 33\",\"NPS 1\\\"\",\"NPS 1¼\\\"\"],a:1,\n   e:\"El NPS 1\\\" mide 33,4 mm por fuera. Las pulgadas del NPS son un nombre, no una medida.\"},\n  {q:\"¿Qué cambia entre un tubo de 4\\\" SCH 40 y uno de 4\\\" SCH 80?\",o:[\"El diámetro exterior\",\"El espesor y el diámetro interior\",\"Nada, es lo mismo\"],a:1,\n   e:\"El exterior es fijo (114,3 mm). El SCH 80 tiene más pared, así que su interior es más pequeño.\"},\n  {q:\"¿Qué tubo aguanta más presión, a igualdad de NPS y material?\",o:[\"SCH 40\",\"SCH 80\",\"SCH 160\"],a:2,\n   e:\"Más schedule = más espesor = más presión.\"},\n  {q:\"¿En qué tamaños el diámetro exterior coincide con el nominal?\",o:[\"Hasta 12\\\"\",\"Desde 14\\\"\",\"En ninguno\"],a:1,\n   e:\"Desde 14\\\" el exterior es igual al nominal: 14\\\" = 355,6 mm. Hasta 12\\\", el exterior es mayor.\"},\n  {q:\"¿Es siempre lo mismo STD que SCH 40?\",o:[\"Sí, siempre\",\"No: coinciden hasta 10\\\", desde 12\\\" son distintos\",\"No se parecen en nada\"],a:1,\n   e:\"STD y SCH 40 coinciden hasta 10\\\". Por ejemplo, 12\\\" STD = 9,53 mm y 12\\\" SCH 40 = 10,31 mm.\"},\n  {q:\"Tienes que soldar a tope dos tramos de 6\\\". ¿Qué extremo pides?\",o:[\"PE (liso)\",\"BE (biselado)\",\"T&C (roscado)\"],a:1,\n   e:\"La soldadura a tope necesita bisel: BE (bevelled end).\"},\n  {q:\"¿Qué tubo eliges para alta presión?\",o:[\"Con costura en espiral\",\"Sin soldadura (seamless)\",\"De PVC\"],a:1,\n   e:\"El tubo sin soldadura no tiene costura, que es el punto más débil. Por eso es el de alta presión.\"}\n];\n\u003c/script>\n\u003cscript>\n(function(){\n  \"use strict\";\n  var $=function(s,r){return (r||document).querySelector(s)};\n  var $$=function(s,r){return Array.prototype.slice.call((r||document).querySelectorAll(s))};\n  window.$=$; window.$$=$$;\n\n  /* ---------- Barra de progreso y sección activa ---------- */\n  var bar=$(\"#bar\"), links=$$(\"#chips a\"), secs=links.map(function(a){return $(a.getAttribute(\"href\"))});\n  function onScroll(){\n    var h=document.documentElement, max=h.scrollHeight-h.clientHeight;\n    if(bar)bar.style.width=(max>0?Math.min(100,h.scrollTop/max*100):0)+\"%\";\n    var y=window.scrollY+140, cur=0;\n    secs.forEach(function(s,i){if(s&&s.getBoundingClientRect().top+window.scrollY\u003c=y)cur=i});\n    links.forEach(function(a,i){\n      var on=i===cur; a.classList.toggle(\"on\",on);\n      if(on)a.setAttribute(\"aria-current\",\"true\"); else a.removeAttribute(\"aria-current\");\n    });\n    var on=links[cur]; if(on&&on!==onScroll.last){\n      onScroll.last=on; var c=$(\"#chips\"); c.scrollTo({left:on.offsetLeft-c.clientWidth/2+on.clientWidth/2,behavior:\"smooth\"});\n    }\n  }\n  if(links.length){window.addEventListener(\"scroll\",onScroll,{passive:true});window.addEventListener(\"resize\",onScroll);onScr